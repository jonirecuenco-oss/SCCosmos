<Page x:Class="SCCosmos.VisitasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SCCosmos"
      Title="VisitasPage" Background="#1E1E1E"
      SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <local:Base64ImageConverter x:Key="Base64Converter"/>

        <Style x:Key="EstiloBotonPaginacion" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BotonEditarTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="✏️" ToolTip="Editar" Click="BtnEditarPersona_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="2,0,8,0" FontSize="14"/>
                <Button Content="🗑️" ToolTip="Eliminar" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0" FontSize="14" Click="BtnEliminarPersona_Click"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Compatibilidad con el código existente: ya no se muestra el recuadro "Programa cronológico". -->
        <TextBlock x:Name="TxtResumenPrograma" Visibility="Collapsed"/>

        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock x:Name="TxtTitulo" Text="DATOS DE LA CONGREGACIÓN" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,20"/>

                <!-- SECCIÓN MINISTERIO -->
                <Expander IsExpanded="True" FontSize="16" FontWeight="Normal" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="MINISTERIO Y PUBLICADORES" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="10,15,10,10">

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- LISTA DE GRUPOS + BOTÓN DE AÑADIR -->
                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ListBox x:Name="TabGrupos" PreviewMouseWheel="UIElement_PreviewMouseWheel" SelectionChanged="TabGrupos_SelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="BdItem" Background="#2A2A2A" Padding="15,10" Margin="0,0,6,6" CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="BdItem" Property="Background" Value="#0078D4"/>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BdItem" Property="Background" Value="#404040"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- BOTÓN + MEJORADO -->
                                <Button Content="➕" ToolTip="Añadir Publicador" FontSize="16" FontWeight="SemiBold" Padding="15,8" Background="#10893E" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnNuevaPersona_Click" VerticalAlignment="Top" Margin="4,0,0,6"/>
                            </WrapPanel>

                            <!-- CINTA DE MES INDIVIDUAL -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                <TextBlock Text="Mes de referencia:" Foreground="Gray" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent" Padding="4" Margin="0,0,5,0" Cursor="Hand" Click="BtnMesAntMinisterio_Click"/>
                                <Border Background="#2A2A2A" CornerRadius="4" Padding="15,6" MinWidth="140">
                                    <TextBlock x:Name="TxtMesMinisterio" Text="Mes" Foreground="White" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent" Padding="4" Margin="5,0,0,0" Cursor="Hand" Click="BtnMesSigMinisterio_Click"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="TablaVisitas" PreviewMouseWheel="UIElement_PreviewMouseWheel" FontWeight="Normal" HorizontalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="True" MaxHeight="800"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  BorderThickness="1" BorderBrush="#20FFFFFF" Background="Transparent" RowBackground="Transparent">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsPrecursor}" Value="True">
                                            <Setter Property="Background" Value="#1A0078D4"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#400078D4"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Nombre" Width="16*" MinWidth="200" SortMemberPath="NombreComun">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Border Width="36" Height="36" CornerRadius="18" Background="#2A2A2A" ClipToBounds="True" Margin="0,4,12,4">
                                                    <Image Source="{Binding Foto, Converter={StaticResource Base64Converter}}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding NombreVisual}" VerticalAlignment="Center" ToolTip="{Binding AlertaTooltip}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsPrecursor}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>

                <!-- MAPA DEL TERRITORIO -->
                <Expander x:Name="ExpanderMapa"
                          Header="MAPA DEL TERRITORIO Y SALÓN"
                          FontSize="16"
                          FontWeight="Normal"
                          HorizontalContentAlignment="Stretch"
                          Margin="0,0,0,10"
                          Expanded="ExpanderMapa_Expanded"
                          Collapsed="ExpanderMapa_Collapsed">
                    <Grid Margin="10,15,10,10"
                          Height="550"
                          ClipToBounds="True">
                        <!--
                            WebBrowser es un control HWND. Se mantiene
                            colapsado mientras el Expander termina su layout
                            para evitar que aparezca temporalmente por encima
                            del resto de la página.
                        -->
                        <Border BorderBrush="#333333"
                                BorderThickness="1"
                                Background="#252526"
                                ClipToBounds="True">
                            <WebBrowser x:Name="MapaWebBrowser"
                                        Margin="0"
                                        Visibility="Collapsed"/>
                        </Border>
                    </Grid>
                </Expander>

                <!-- PROGRAMA DE LA VISITA -->
                <Expander x:Name="ExpanderPrograma"
                          FontSize="16"
                          FontWeight="Normal"
                          HorizontalContentAlignment="Stretch"
                          Margin="0,0,0,10">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="PROGRAMA DE LA VISITA"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>

                    <StackPanel Margin="10,15,10,10">
                        <ItemsControl x:Name="ListaProgramaDias"
                                      PreviewMouseWheel="UIElement_PreviewMouseWheel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#202023"
                                            BorderBrush="#343438"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,0,0,12"
                                            Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Background="#29292D"
                                                    CornerRadius="8,8,0,0"
                                                    Padding="14,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Dia}"
                                                               Foreground="White"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>

                                                    <Button Grid.Column="1"
                                                            Content="＋ Añadir actividad"
                                                            Tag="{Binding Dia}"
                                                            Click="BtnProgramarActividad_Click"
                                                            Padding="12,6"
                                                            Background="#0078D4"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Cursor="Hand"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1"
                                                        Margin="12,10,12,12">

                                                <TextBlock Text="Sin actividades programadas"
                                                           Foreground="#777777"
                                                           FontStyle="Italic"
                                                           FontSize="12"
                                                           Margin="4,6"
                                                           Visibility="{Binding VerSinActividades}"/>

                                                <ItemsControl ItemsSource="{Binding Actividades}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#28282C"
                                                                    BorderBrush="#36363B"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="10"
                                                                    Margin="0,0,0,7">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="70"/>
                                                                        <ColumnDefinition Width="82"/>
                                                                        <ColumnDefinition Width="2.2*"/>
                                                                        <ColumnDefinition Width="2*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Hora}"
                                                                               Foreground="#4BA3E3"
                                                                               FontSize="15"
                                                                               FontWeight="Bold"
                                                                               VerticalAlignment="Center"/>

                                                                    <Border Grid.Column="1"
                                                                            Background="#333338"
                                                                            CornerRadius="4"
                                                                            Padding="7,4"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Responsable}"
                                                                                   Foreground="#EBCB8B"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"/>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="2"
                                                                                Margin="8,0,12,0"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding TipoActividad}"
                                                                                   Foreground="White"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Acompanante}"
                                                                                   Foreground="#AAAAAA"
                                                                                   FontSize="12"
                                                                                   Margin="0,3,0,0"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="3"
                                                                                Margin="0,0,12,0"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Ubicacion}"
                                                                                   Foreground="#B8B8B8"
                                                                                   FontSize="12"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Notas}"
                                                                                   Foreground="#777777"
                                                                                   FontSize="11"
                                                                                   FontStyle="Italic"
                                                                                   Margin="0,3,0,0"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="4"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center">
                                                                        <Button Content="✏️"
                                                                                ToolTip="Editar"
                                                                                Tag="{Binding}"
                                                                                Click="BtnEditarActividad_Click"
                                                                                Background="Transparent"
                                                                                Foreground="White"
                                                                                BorderThickness="0"
                                                                                Padding="5"
                                                                                Cursor="Hand"/>
                                                                        <Button Content="🗑️"
                                                                                ToolTip="Eliminar"
                                                                                Tag="{Binding}"
                                                                                Click="BtnEliminarActividad_Click"
                                                                                Background="Transparent"
                                                                                Foreground="#FF6B6B"
                                                                                BorderThickness="0"
                                                                                Padding="5"
                                                                                Cursor="Hand"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- NOTAS PERSONALES -->
                <Expander x:Name="ExpanderNotas" FontSize="16" FontWeight="Normal" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="NOTAS PERSONALES DE LA VISITA" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <Grid x:Name="PanelNotas" Margin="10,15,10,10">
                        <Grid.Resources>
                            <Style x:Key="HeaderSeccion" TargetType="Border">
                                <Setter Property="Background" Value="#1A1A1C"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="CornerRadius" Value="6,6,0,0"/>
                            </Style>
                            <Style x:Key="TituloSeccion" TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#4BA3E3"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                            <Style x:Key="CajaPreguntas" TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="Padding" Value="15,0,15,0"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                            <Style x:Key="CajaRespuestas" TargetType="TextBox">
                                <Setter Property="AcceptsReturn" Value="True"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="MinHeight" Value="40"/>
                            </Style>
                            <Style x:Key="BordeContenedor" TargetType="Border">
                                <Setter Property="Background" Value="#252528"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Margin" Value="0,0,0,20"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Grid.Resources>

                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Los cambios se guardan automáticamente al dejar de escribir." Foreground="#888888" FontSize="12" VerticalAlignment="Center" FontStyle="Italic"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MisNotasAgrupadas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BordeContenedor}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Style="{StaticResource HeaderSeccion}">
                                                    <TextBlock Text="{Binding Cabecera}" Style="{StaticResource TituloSeccion}"/>
                                                </Border>

                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Preguntas}" Margin="0,10,15,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="45*"/>
                                                                    <ColumnDefinition Width="55*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Style="{StaticResource CajaPreguntas}" Grid.Column="0" Text="{Binding Pregunta}" VerticalAlignment="Center"/>
                                                                <TextBox Style="{StaticResource CajaRespuestas}" Grid.Column="1" 
                                                                         Text="{Binding Respuesta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="{Binding FondoRespuesta}" 
                                                                         Foreground="{Binding ColorTextoRespuesta}"
                                                                         LostFocus="TxtNotaRespuesta_LostFocus"/>
                                                                <Button Grid.Column="2" Content="🚩" Background="Transparent" Foreground="#FF5555" BorderThickness="0" 
                                                                        FontSize="18" Cursor="Hand" Margin="5,0,0,0" ToolTip="Marcar como alerta"
                                                                        Click="BtnAlertaNota_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Expander>

                <!-- INFORMACIÓN DE LA CONGREGACIÓN -->
                <Expander Header="INFORMACIÓN DE LA CONGREGACIÓN"
                          FontSize="16"
                          FontWeight="Normal"
                          HorizontalContentAlignment="Stretch"
                          Margin="0,0,0,10">
                    <Border x:Name="PanelEstadisticas"
                            Background="#171719"
                            BorderBrush="#2D2D30"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            Margin="10,15,10,15">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Resumen de la congregación"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Datos calculados para el mes de referencia seleccionado"
                                               Foreground="#888888"
                                               FontSize="12"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#1A0078D4"
                                        BorderBrush="#400078D4"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Publicadores activos"
                                                   Foreground="#AAAAAA"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding TotalPersonas}"
                                                   Foreground="White"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <UniformGrid Columns="3">

                                <!-- PERSONAS -->
                                <Border Background="#202023"
                                        BorderBrush="#303035"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="PERSONAS"
                                                   Foreground="#4BA3E3"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Hombres" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalHombres}" Foreground="White" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="1" Text="Mujeres" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalMujeres}" Foreground="White" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="2" Text="Media de edad" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MediaEdad, StringFormat='{}{0} años'}" Foreground="White" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="3" Text="No bautizados" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NoBautizados}" Foreground="White" FontWeight="SemiBold" Margin="12,4,0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- NOMBRAMIENTOS -->
                                <Border Background="#202023"
                                        BorderBrush="#303035"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="NOMBRAMIENTOS Y ACTIVIDAD"
                                                   Foreground="#55C855"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Ancianos" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Ancianos}" Foreground="White" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="1" Text="Siervos ministeriales" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SiervosMinisteriales}" Foreground="White" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="2" Text="Bautizados últ. 6 meses" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BautizadosRecientes}" Foreground="#55C855" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="3" Text="Irregulares últ. 6 meses" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Irregulares}" Foreground="#FF7777" FontWeight="SemiBold" Margin="12,4,0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- PRECURSORES -->
                                <Border Background="#202023"
                                        BorderBrush="#303035"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="PRECURSORES Y CURSOS"
                                                   Foreground="#FFB900"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Precursores regulares" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PrecursoresRegulares}" Foreground="White" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="1" Text="Especiales / misioneros" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PrecursoresEspeciales}" Foreground="White" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="2" Text="Auxiliares este mes" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AuxiliaresMesEscogido}" Foreground="#FFB900" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="3" Text="Auxiliares últ. 6 meses" Foreground="#AAAAAA" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Auxiliares6Meses}" Foreground="White" FontWeight="SemiBold" Margin="12,4,0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Background="#1C1C1F"
                                    BorderBrush="#303035"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Cursos bíblicos del mes"
                                               Foreground="#AAAAAA"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TotalCursos}"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding MediaCursos, StringFormat='Media por publicador: {0}'}"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- GRUPOS DE PREDICACIÓN -->
                <Expander Header="GRUPOS DE PREDICACIÓN" FontSize="16" FontWeight="Normal" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <StackPanel Margin="10,15,10,10">
                        <ItemsControl x:Name="GraficoGrupos" PreviewMouseWheel="UIElement_PreviewMouseWheel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10FFFFFF" CornerRadius="8" Padding="20" Margin="0,0,15,15" BorderThickness="1" BorderBrush="#20FFFFFF" MinWidth="260">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NombreGrupo}" FontWeight="Bold" FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Publicadores" Width="100" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#0078D4" Height="14" Width="{Binding AnchoPublicadores}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumPublicadores}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Precursores" Width="100" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#10893E" Height="14" Width="{Binding AnchoPrecursores}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumPrecursores}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Ancianos" Width="100" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#D83B01" Height="14" Width="{Binding AnchoAncianos}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumAncianos}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Siervos Min." Width="100" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#FFB900" Height="14" Width="{Binding AnchoSM}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumSM}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- TERRITORIOS -->
                <Expander FontSize="16"
                          FontWeight="Normal"
                          HorizontalContentAlignment="Stretch"
                          Margin="0,0,0,10">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="TERRITORIOS (S-13)"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>

                    <StackPanel Margin="10,15,10,10">

                        <!-- SELECTOR DE AÑO DE SERVICIO -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,0,15">
                            <TextBlock Text="Año de servicio:"
                                       Foreground="Gray"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>

                            <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}"
                                       Appearance="Transparent"
                                       Padding="4"
                                       Margin="0,0,5,0"
                                       Cursor="Hand"
                                       Click="BtnMesAntTerritorios_Click"/>

                            <Border Background="#2A2A2A"
                                    CornerRadius="4"
                                    Padding="15,6"
                                    MinWidth="190">
                                <TextBlock x:Name="TxtMesTerritorios"
                                           Text="Año de servicio"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <ui:Button Icon="{ui:SymbolIcon ChevronRight24}"
                                       Appearance="Transparent"
                                       Padding="4"
                                       Margin="5,0,0,0"
                                       Cursor="Hand"
                                       Click="BtnMesSigTerritorios_Click"/>
                        </StackPanel>


                        <!-- ESTADÍSTICAS -->
                        <WrapPanel Margin="0,0,0,15"
                                   Orientation="Horizontal">

                            <Border x:Name="CardTotalTerritorios"
                                    Tag="Todos"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Mostrar todos los territorios"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Nº Territorios"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTotalTerritorios"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritoriosTrabajados6M"
                                    Tag="Ultimos6Meses"
                                    Background="#1A32CD32"
                                    BorderBrush="#2032CD32"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="190"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios trabajados en los últimos 6 meses"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Trabajados (últ. 6 meses)"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritoriosTrabajados"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#32CD32"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritoriosTrabajadosAnio"
                                    Tag="AnioServicio"
                                    Background="#1A32CD32"
                                    BorderBrush="#2032CD32"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="205"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios trabajados en el año de servicio"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Trabajados (año de servicio)"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritoriosTrabajadosAnio"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#32CD32"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritoriosEnCurso"
                                    Tag="EnCurso"
                                    Background="#1A1E90FF"
                                    BorderBrush="#201E90FF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios que se están trabajando en la fecha de corte"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock x:Name="TxtEtiquetaTerritoriosEnCurso"
                                               Text="Trabajándose en"
                                               Foreground="#AAAAAA"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtTerritoriosEnCurso"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#1E90FF"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritoriosCaducados"
                                    Tag="Caducados"
                                    Background="#1AFF8C00"
                                    BorderBrush="#20FF8C00"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios caducados"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Caducados (≥ 4 meses)"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritoriosCaducados"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#FF8C00"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritorios1Ano"
                                    Tag="SinTrabajar1Ano"
                                    Background="#1AFF4500"
                                    BorderBrush="#20FF4500"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios sin trabajar entre 1 y 2 años"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Sin trabajar > 1 año"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritorios1Ano"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#FF4500"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritorios2Anos"
                                    Tag="SinTrabajar2Anos"
                                    Background="#1AE6192B"
                                    BorderBrush="#20E6192B"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios sin trabajar durante 2 años o más"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Sin trabajar > 2 años"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritorios2Anos"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#E6192B"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>


                        <!--
                            Una fila por territorio y, dentro de ella,
                            TODOS los registros que intersectan el año de
                            servicio seleccionado. Ya no existe el límite
                            visual V1..V4.
                        -->
                        <DataGrid x:Name="TablaTerritorios"
                                  PreviewMouseWheel="UIElement_PreviewMouseWheel"
                                  FontWeight="Normal"
                                  HorizontalAlignment="Stretch"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  IsReadOnly="False"
                                  MaxHeight="650"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#20FFFFFF"
                                  BorderThickness="1"
                                  BorderBrush="#20FFFFFF"
                                  Background="Transparent"
                                  RowBackground="Transparent">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Territorio"
                                                    Binding="{Binding Nombre}"
                                                    Width="13*"
                                                    MinWidth="120"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="Margin"
                                                    Value="8"/>
                                            <Setter Property="FontWeight"
                                                    Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Últ. vez"
                                                    Binding="{Binding UltimaVez}"
                                                    Width="9*"
                                                    MinWidth="95"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="Margin"
                                                    Value="6"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Registros del año de servicio"
                                                        Width="60*"
                                                        MinWidth="450">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding RegistrosAnioServicio}"
                                                          Margin="1,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1AFFFFFF"
                                                                BorderBrush="#333333"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="3,1"
                                                                Margin="0,1,5,1"
                                                                Width="410">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18"/>
                                                                    <ColumnDefinition Width="198"/>
                                                                    <ColumnDefinition Width="184"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!--
                                                                    Botón de información. Al pulsarlo se abre un Popup real
                                                                    con el nombre original procedente del registro S-13.
                                                                -->
                                                                <Grid Grid.Column="0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <ToggleButton x:Name="BtnInfoRegistroS13"
                                                                                  Grid.Row="0"
                                                                                  Width="15"
                                                                                  Height="15"
                                                                                  Padding="0"
                                                                                  Margin="0"
                                                                                  Background="Transparent"
                                                                                  BorderThickness="0"
                                                                                  Foreground="#8AB4F8"
                                                                                  FontSize="11"
                                                                                  Cursor="Hand"
                                                                                  ToolTip="Ver nombre original del registro"
                                                                                  Content="ⓘ"/>

                                                                    <Button Grid.Row="1"
                                                                            Width="15"
                                                                            Height="15"
                                                                            Padding="0"
                                                                            Margin="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Foreground="#E34F4F"
                                                                            FontSize="13"
                                                                            FontWeight="Bold"
                                                                            Cursor="Hand"
                                                                            ToolTip="Borrar este registro"
                                                                            Content="×"
                                                                            Click="BtnEliminarRegistroTerritorio_Click"/>

                                                                    <Popup PlacementTarget="{Binding ElementName=BtnInfoRegistroS13}"
                                                                           Placement="Bottom"
                                                                           HorizontalOffset="0"
                                                                           VerticalOffset="4"
                                                                           AllowsTransparency="True"
                                                                           StaysOpen="False"
                                                                           IsOpen="{Binding IsChecked, ElementName=BtnInfoRegistroS13, Mode=TwoWay}">
                                                                        <Border Background="#2B2B2F"
                                                                                BorderBrush="#55555B"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                Padding="10,8"
                                                                                MaxWidth="360">
                                                                            <StackPanel>
                                                                                <TextBlock Text="Nombre original del registro S-13"
                                                                                           Foreground="#AAAAAA"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"
                                                                                           Margin="0,0,0,4"/>
                                                                                <TextBlock Text="{Binding NombreS13}"
                                                                                           Foreground="White"
                                                                                           FontSize="13"
                                                                                           FontWeight="SemiBold"
                                                                                           TextWrapping="Wrap"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Popup>
                                                                </Grid>

                                                                <!--
                                                                    El borde de aviso va FUERA del ComboBox para no sustituir
                                                                    el estilo visual original de WPF-UI. Así el selector conserva
                                                                    exactamente su aspecto normal y solo se resalta cuando falta
                                                                    una equivalencia.
                                                                -->
                                                                <Border Grid.Column="1"
                                                                        CornerRadius="4"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding NombreS21}" Value="">
                                                                                    <Setter Property="BorderBrush" Value="#FFB900"/>
                                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                                    <Setter Property="ToolTip" Value="Este registro todavía no tiene una equivalencia seleccionada."/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding NombreS21}" Value="{x:Null}">
                                                                                    <Setter Property="BorderBrush" Value="#FFB900"/>
                                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                                    <Setter Property="ToolTip" Value="Este registro todavía no tiene una equivalencia seleccionada."/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>

                                                                    <ComboBox ItemsSource="{Binding ListaPersonasS21}"
                                                                              DisplayMemberPath="TextoMostrar"
                                                                              SelectedValuePath="NombreS21"
                                                                              SelectedValue="{Binding NombreS21, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              SelectionChanged="CmbVinculacion_SelectionChanged"
                                                                              KeyUp="CmbVinculacion_KeyUp"
                                                                              StaysOpenOnEdit="True"
                                                                              Padding="5,0"
                                                                              FontSize="13"
                                                                              MinHeight="27"
                                                                              Cursor="Hand"
                                                                              IsEditable="True"
                                                                              IsSynchronizedWithCurrentItem="False"
                                                                              IsTextSearchEnabled="False"
                                                                              Width="198"
                                                                              VerticalAlignment="Center"/>
                                                                </Border>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding Fechas}"
                                                                           Foreground="#AAAAAA"
                                                                           FontSize="12"
                                                                           Margin="4,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           TextWrapping="NoWrap"
                                                                           Width="180"
                                                                           ToolTip="{Binding Fechas}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Acciones"
                                                        Width="9*"
                                                        MinWidth="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <Button Content="✏️"
                                                        ToolTip="Renombrar Territorio"
                                                        Click="BtnEditarTerritorio_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Margin="2,0,8,0"
                                                        FontSize="14"/>

                                                <Button Content="🗑️"
                                                        ToolTip="Eliminar Territorio"
                                                        Click="BtnEliminarTerritorio_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Margin="0,0,2,0"
                                                        FontSize="14"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="PanelPaginacion"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,15,0,0"/>

                    </StackPanel>
                </Expander>

                <!-- CONTABILIDAD -->
                <Expander FontSize="16" FontWeight="Normal" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <Expander.Header>
                        <Grid>
                            <TextBlock Text="CONTABILIDAD (Últimos 6 meses)" VerticalAlignment="Center"/>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="10,15,10,10">

                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="Los cambios se guardan automáticamente al escribir" Foreground="#888888" FontSize="12" VerticalAlignment="Center" FontStyle="Italic"/>
                            <!-- CINTA DE MES INDIVIDUAL -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Mes final del balance:" Foreground="Gray" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent" Padding="4" Margin="0,0,5,0" Cursor="Hand" Click="BtnMesAntContabilidad_Click"/>
                                <Border Background="#2A2A2A" CornerRadius="4" Padding="15,6" MinWidth="140">
                                    <TextBlock x:Name="TxtMesContabilidad" Text="Mes" Foreground="White" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent" Padding="4" Margin="5,0,0,0" Cursor="Hand" Click="BtnMesSigContabilidad_Click"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="TablaContabilidad" PreviewMouseWheel="UIElement_PreviewMouseWheel" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20FFFFFF"
                                  BorderThickness="1" BorderBrush="#20FFFFFF" Background="Transparent" RowBackground="Transparent"
                                  CellEditEnding="TablaContabilidad_CellEditEnding">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="MinHeight" Value="35"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mes" Binding="{Binding NombreMesVisual}" IsReadOnly="True" Width="2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Gastos" Binding="{Binding Gastos}" Width="1.5*"/>
                                <DataGridTextColumn Header="Mantenim." Binding="{Binding Mantenimiento}" Width="1.5*"/>
                                <DataGridTextColumn Header="Obra Mund." Binding="{Binding ObraMundial}" Width="1.5*"/>
                                <DataGridTextColumn Header="Resolución" Binding="{Binding ObraResolucion}" Width="1.5*"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="1.5*" FontWeight="Bold" Foreground="#55C855"/>
                                <DataGridTextColumn Header="Promedio" Binding="{Binding Promedio}" IsReadOnly="True" Width="1.5*" Foreground="#FFB900" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>

                <!-- S-303 Y S-2 -->
                <Expander x:Name="ExpanderS303yS2" Header="S-303 y S-2" FontSize="16" FontWeight="Normal" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <StackPanel Margin="10,15,10,10">

                        <!-- PARTE 1: S-303 -->
                        <Border Background="#1A1A1C" CornerRadius="6" Padding="15" Margin="0,0,0,15" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DOCUMENTO S-303" FontSize="14" FontWeight="SemiBold" Foreground="#4BA3E3" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ListaS303">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NombreVisual}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <Button Grid.Column="1" Content="{Binding TextoBoton}" Tag="{Binding}" Click="BtnEditarS303_Click" 
                                                        Background="#0078D4" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand" Margin="10,0,0,0"/>
                                                <Button Grid.Column="2" Content="🗑️" Tag="{Binding}" Click="BtnEliminarS303_Click" Visibility="{Binding VerBotonBorrar}"
                                                        Background="Transparent" Foreground="#FF5555" BorderThickness="0" Padding="5" Cursor="Hand" Margin="5,0,0,0" ToolTip="Eliminar PDF generado" FontSize="16"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtSinS303" Text="..." Foreground="#AAAAAA" FontStyle="Italic" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- PARTE 2: S-2 (RECOMENDACIONES) -->
                        <Border Background="#1A1A1C" CornerRadius="6" Padding="15" Margin="0,0,0,15" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="RECOMENDACIONES Y BAJAS PENDIENTES (S-2)" FontSize="14" FontWeight="SemiBold" Foreground="#4BA3E3" Margin="0,0,0,10"/>

                                <DataGrid x:Name="TablaS2" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" 
                                          IsReadOnly="False" Background="Transparent" RowBackground="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333333">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="MinHeight" Value="35"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Aprobar" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Aprobar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Hermano" Binding="{Binding Hermano}" Width="2*" FontWeight="SemiBold" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Acción" Binding="{Binding Tipo}" Width="1*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Recomendado como" Binding="{Binding RecomendadoComo}" Width="1.5*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock x:Name="TxtSinS2" Text="No hay recomendaciones ni bajas pendientes en JW Hub para esta congregación." Foreground="#AAAAAA" FontStyle="Italic" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- PARTE 3: MENSAJE A LA CONGREGACIÓN -->
                        <Border Background="#1A1A1C" CornerRadius="6" Padding="15" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MENSAJE PARA LA CONGREGACIÓN" FontSize="14" FontWeight="SemiBold" Foreground="#4BA3E3" Margin="0,0,0,10"/>

                                <TextBlock Text="Asunto del correo:" Foreground="#CCC" Margin="0,0,0,5"/>
                                <ui:TextBox x:Name="TxtAsuntoEnvio" Background="#1E1E1E" Foreground="White" Margin="0,0,0,15"/>

                                <TextBlock Text="Cuerpo del correo:" Foreground="#CCC" Margin="0,0,0,5"/>

                                <!-- EDITOR DE TEXTO ENRIQUECIDO WEBBROWSER -->
                                <Border BorderThickness="1" BorderBrush="#333333" CornerRadius="4" Background="#252528" Margin="0,0,0,15">
                                    <StackPanel>
                                        <!-- BARRA DE HERRAMIENTAS -->
                                        <Border Background="#1E1E1E" Padding="5">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="N" FontWeight="Bold" Width="30" Height="30" Margin="0,0,5,0" Tag="bold" Click="BtnFormato_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                <Button Content="K" FontStyle="Italic" Width="30" Height="30" Margin="0,0,5,0" Tag="italic" Click="BtnFormato_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                                                <!-- Botón S (Subrayado) con TextBlock interno -->
                                                <Button Width="30" Height="30" Margin="0,0,10,0" Tag="underline" Click="BtnFormato_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                    <TextBlock Text="S" TextDecorations="Underline" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>

                                                <ComboBox Width="60" Height="30" SelectionChanged="CmbTamano_SelectionChanged" SelectedIndex="2" Background="#333" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                    <ComboBoxItem Content="10" Tag="1"/>
                                                    <ComboBoxItem Content="13" Tag="2"/>
                                                    <ComboBoxItem Content="16" Tag="3"/>
                                                    <ComboBoxItem Content="18" Tag="4"/>
                                                    <ComboBoxItem Content="24" Tag="5"/>
                                                    <ComboBoxItem Content="32" Tag="6"/>
                                                    <ComboBoxItem Content="48" Tag="7"/>
                                                </ComboBox>
                                                <TextBlock Text="💡 Win + . para Emojis" Foreground="#888888" VerticalAlignment="Center" Margin="15,0,0,0" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ÁREA WEB -->
                                        <WebBrowser x:Name="WbEditorEnvio" Height="150"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CONTROLES DE ENVÍO -->
                        <StackPanel x:Name="PanelControlesEnvio" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <CheckBox x:Name="ChkCopiaSRV" Content="Copia a SRV" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <ui:Button Content="Enviar S-303 y S-2" Appearance="Primary" Icon="{ui:SymbolIcon Send24}" Click="BtnEnviarS2_Click"/>
                        </StackPanel>

                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- CAPA DE CARGA GLOBAL -->
        <Border x:Name="PanelCargando" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="9999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Cargando..." Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="8" Foreground="#0078D4"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>