<Page x:Class="SCCosmos.VisitasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="VisitasPage" Background="#1E1E1E"
      SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <Style x:Key="EstiloBotonPaginacion" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="BotonEditarTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="✏️" ToolTip="Editar" Click="BtnEditarPersona_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="2,0,8,0" FontSize="14"/>
                <Button Content="🗑️" ToolTip="Eliminar" Click="BtnEliminarPersona_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0" FontSize="14"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtTitulo" Grid.Row="0" Text="DATOS DE LA CONGREGACIÓN" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Margin="0,0,15,20">
                <!-- CINTA DE MESES -->
                <Grid Margin="0,0,0,15" Height="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="&#x25C0;" Width="40" Background="#333333" Foreground="White" BorderThickness="0" FontSize="18" Cursor="Hand" Click="BtnScrollIzquierda_Click"/>

                    <ScrollViewer Grid.Column="1" x:Name="ScrollMeses" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ListBox x:Name="ListMeses" PreviewMouseWheel="UIElement_PreviewMouseWheel" SelectionChanged="ListMeses_SelectionChanged" BorderThickness="0" Background="Transparent" Padding="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Bd" Padding="25,8" Margin="4,0" CornerRadius="8" Background="#20FFFFFF">
                                        <TextBlock Text="{Binding NombreVisual}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="BdItem" Background="Transparent" CornerRadius="8" Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="BdItem" Property="Background" Value="#FF007ACC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BdItem" Property="Background" Value="#40FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>

                    <Button Grid.Column="2" Content="&#x25B6;" Width="40" Background="#333333" Foreground="White" BorderThickness="0" FontSize="18" Cursor="Hand" Click="BtnScrollDerecha_Click"/>
                </Grid>

                <!-- SECCIÓN ACTIVIDAD -->
                <Expander Header="MINISTERIO" IsExpanded="True" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <StackPanel Margin="10,15,10,10">
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Column="0" x:Name="TabGrupos" PreviewMouseWheel="UIElement_PreviewMouseWheel" SelectionChanged="TabGrupos_SelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="BdItem" Background="#2A2A2A" Padding="15,10" Margin="0,0,6,6" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="BdItem" Property="Background" Value="#0078D4"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BdItem" Property="Background" Value="#404040"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <Button Grid.Column="1" Content="➕ Añadir Publicador" FontSize="16" FontWeight="SemiBold" Padding="20,10" Margin="10,0,0,6" BorderThickness="0" Cursor="Hand" Click="BtnNuevaPersona_Click" VerticalAlignment="Top">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#10893E"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#0E7535"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <DataGrid x:Name="TablaVisitas" PreviewMouseWheel="UIElement_PreviewMouseWheel" FontWeight="Normal" HorizontalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="True" MaxHeight="800"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  BorderThickness="1" BorderBrush="#20FFFFFF" Background="Transparent" RowBackground="Transparent">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsPrecursor}" Value="True">
                                            <Setter Property="Background" Value="AliceBlue"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="DarkViolet"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </StackPanel>
                </Expander>

                <!-- PROGRAMA DE LA VISITA -->
                <Expander x:Name="ExpanderPrograma" Header="PROGRAMA DE LA VISITA" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Stretch" Margin="0,0,0,10" Visibility="Collapsed">
                    <StackPanel Margin="10,15,10,10">
                        <DataGrid x:Name="TablaPrograma" PreviewMouseWheel="UIElement_PreviewMouseWheel" FontWeight="Normal" HorizontalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="True" MaxHeight="800" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20FFFFFF"
                                  BorderThickness="1" BorderBrush="#20FFFFFF" Background="Transparent" RowBackground="Transparent">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <StackPanel>
                                                            <Border Background="#1AFFFFFF" Padding="10,6" Margin="0,15,0,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFB900" FontSize="14"/>
                                                            </Border>
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </DataGrid.GroupStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="MinHeight" Value="40"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1AFFFFFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Resources>
                                <DataTemplate x:Key="CeldaProgramaTemplate">
                                    <StackPanel Margin="4">
                                        <ItemsControl ItemsSource="{Binding ListaActividades}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#005A9E" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Texto}" Foreground="White" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="➕ Añadir" FontSize="11" Background="#333333" Foreground="#AAAAAA" 
                                                BorderThickness="0" Cursor="Hand" Padding="8,4" 
                                                Visibility="{Binding VerBotonAnadir}" 
                                                Tag="{Binding}" Click="BtnProgramarActividad_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#0078D4"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Responsable" Binding="{Binding Persona}" Width="15*" FontWeight="SemiBold">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="10,0,0,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Miércoles" Width="17*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Miercoles}" ContentTemplate="{StaticResource CeldaProgramaTemplate}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Jueves" Width="17*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Jueves}" ContentTemplate="{StaticResource CeldaProgramaTemplate}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Viernes" Width="17*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Viernes}" ContentTemplate="{StaticResource CeldaProgramaTemplate}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Sábado" Width="17*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Sabado}" ContentTemplate="{StaticResource CeldaProgramaTemplate}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Domingo" Width="17*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Domingo}" ContentTemplate="{StaticResource CeldaProgramaTemplate}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>

                <!-- APARTADO NOTAS PERSONALES DE LA VISITA -->
                <Expander x:Name="ExpanderNotas" Header="NOTAS PERSONALES" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Stretch" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid x:Name="PanelNotas" Margin="10,15,10,10">
                        <Grid.Resources>
                            <Style x:Key="HeaderSeccion" TargetType="Border">
                                <Setter Property="Background" Value="#1A1A1C"/>
                                <Setter Property="Padding" Value="15,10"/>
                                <Setter Property="CornerRadius" Value="6,6,0,0"/>
                            </Style>
                            <Style x:Key="TituloSeccion" TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#4BA3E3"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                            <Style x:Key="CajaPreguntas" TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="Padding" Value="15,0,15,0"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                            <Style x:Key="CajaRespuestas" TargetType="TextBox">
                                <Setter Property="AcceptsReturn" Value="True"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="MinHeight" Value="40"/>
                            </Style>
                            <Style x:Key="BordeContenedor" TargetType="Border">
                                <Setter Property="Background" Value="#252528"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Margin" Value="0,0,0,20"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Grid.Resources>

                        <StackPanel>
                            <TextBlock Text="Los cambios se guardan automáticamente al dejar de escribir." Foreground="#888888" FontSize="12" Margin="0,0,0,15" FontStyle="Italic"/>

                            <ItemsControl ItemsSource="{Binding MisNotasAgrupadas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BordeContenedor}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Style="{StaticResource HeaderSeccion}">
                                                    <TextBlock Text="{Binding Cabecera}" Style="{StaticResource TituloSeccion}"/>
                                                </Border>

                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Preguntas}" Margin="0,10,15,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="45*"/>
                                                                    <ColumnDefinition Width="55*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Style="{StaticResource CajaPreguntas}" Grid.Column="0" Text="{Binding Pregunta}" VerticalAlignment="Center"/>

                                                                <TextBox Style="{StaticResource CajaRespuestas}" Grid.Column="1" 
                                                                         Text="{Binding Respuesta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Background="{Binding FondoRespuesta}" 
                                                                         Foreground="{Binding ColorTextoRespuesta}"
                                                                         LostFocus="TxtNotaRespuesta_LostFocus"/>

                                                                <Button Grid.Column="2" Content="🚩" Background="Transparent" Foreground="#FF5555" BorderThickness="0" 
                                                                        FontSize="18" Cursor="Hand" Margin="5,0,0,0" ToolTip="Marcar como alerta"
                                                                        Click="BtnAlertaNota_Click"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Expander>

                <!-- SECCIÓN GRUPOS (WrapPanel Responsive) -->
                <Expander Header="GRUPOS DE PREDICACIÓN" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <StackPanel Margin="10,15,10,10">
                        <ItemsControl x:Name="GraficoGrupos" PreviewMouseWheel="UIElement_PreviewMouseWheel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10FFFFFF" CornerRadius="8" Padding="20" Margin="0,0,15,15" BorderThickness="1" BorderBrush="#20FFFFFF" MinWidth="260">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NombreGrupo}" FontWeight="Bold" FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Publicadores" Width="100" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#0078D4" Height="14" Width="{Binding AnchoPublicadores}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumPublicadores}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Precursores" Width="100" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#10893E" Height="14" Width="{Binding AnchoPrecursores}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumPrecursores}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Ancianos" Width="100" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#D83B01" Height="14" Width="{Binding AnchoAncianos}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumAncianos}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Siervos Min." Width="100" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#FFB900" Height="14" Width="{Binding AnchoSM}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumSM}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- SECCIÓN INFORMACIÓN (Cambiado a WrapPanel para que fluya hacia abajo al estrechar la ventana) -->
                <Expander Header="INFORMACIÓN" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <Border x:Name="PanelEstadisticas" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="15,10,15,15">
                        <WrapPanel Orientation="Horizontal">

                            <StackPanel Width="320" Margin="0,0,20,15">
                                <TextBlock Text="{Binding TotalPersonas, StringFormat='Publicadores activos (con grupo): {0}'}" Foreground="White" Margin="0,4" FontSize="14" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{Binding TotalHombres, StringFormat='Hombres: {0}'}" Foreground="#CCCCCC" FontSize="13" Margin="0,0,15,0"/>
                                    <TextBlock Text="{Binding TotalMujeres, StringFormat='Mujeres: {0}'}" Foreground="#CCCCCC" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MediaEdad, StringFormat='Media de edad: {0} años'}" Foreground="#CCCCCC" Margin="0,4" FontSize="13"/>
                                <TextBlock Text="{Binding NoBautizados, StringFormat='No bautizados: {0}'}" Foreground="#CCCCCC" Margin="0,4" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Width="320" Margin="0,0,20,15">
                                <TextBlock Text="{Binding Ancianos, StringFormat='Ancianos: {0}'}" Foreground="White" Margin="0,4" FontSize="14"/>
                                <TextBlock Text="{Binding SiervosMinisteriales, StringFormat='Siervos Ministeriales: {0}'}" Foreground="White" Margin="0,4" FontSize="14"/>
                                <TextBlock Text="{Binding BautizadosRecientes, StringFormat='Bautizados (últimos 6 meses): {0}'}" Foreground="#55C855" Margin="0,4" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Irregulares, StringFormat='Irregulares (últimos 6 meses): {0}'}" Foreground="#FF5555" Margin="0,4" FontSize="13"/>
                            </StackPanel>

                            <StackPanel Width="320" Margin="0,0,0,15">
                                <TextBlock Text="{Binding PrecursoresRegulares, StringFormat='Prec. Regulares: {0}'}" Foreground="#0078D4" Margin="0,4" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding PrecursoresEspeciales, StringFormat='Prec. Especiales / Misioneros: {0}'}" Foreground="#0078D4" Margin="0,4" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AuxiliaresMesEscogido, StringFormat='Auxiliares (mes seleccionado): {0}'}" Foreground="#FFB900" Margin="0,4" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Auxiliares6Meses, StringFormat='Hicieron Auxiliar (últimos 6 meses): {0}'}" Foreground="#FFB900" Margin="0,4" FontSize="13"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{Binding TotalCursos, StringFormat='CBs (mes): {0}'}" Foreground="White" FontSize="13" Margin="0,0,15,0"/>
                                    <TextBlock Text="{Binding MediaCursos, StringFormat='Media: {0}'}" Foreground="White" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>

                        </WrapPanel>
                    </Border>
                </Expander>

                <!-- SECCIÓN TERRITORIOS (Cambiado a WrapPanel para diseño responsivo) -->
                <Expander Header="TERRITORIOS (S-13)" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <StackPanel Margin="10,15,10,10">
                        <WrapPanel Margin="0,0,0,15" Orientation="Horizontal">
                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="15" Margin="0,0,10,10" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Nº Territorios" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock x:Name="TxtTotalTerritorios" Text="0" FontWeight="Bold" FontSize="22" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A32CD32" CornerRadius="6" Padding="15" Margin="0,0,10,10" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Trabajados (últ. 6 meses)" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritoriosTrabajados" Text="0" FontWeight="Bold" FontSize="22" Foreground="#32CD32"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A1E90FF" CornerRadius="6" Padding="15" Margin="0,0,10,10" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Trabajándose Ahora" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritoriosEnCurso" Text="0" FontWeight="Bold" FontSize="22" Foreground="#1E90FF"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1AFF8C00" CornerRadius="6" Padding="15" Margin="0,0,10,10" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Caducados (>= 4 meses)" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritoriosCaducados" Text="0" FontWeight="Bold" FontSize="22" Foreground="#FF8C00"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1AFF4500" CornerRadius="6" Padding="15" Margin="0,0,10,10" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Sin trabajar > 1 año" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritorios1Ano" Text="0" FontWeight="Bold" FontSize="22" Foreground="#FF4500"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1AE6192B" CornerRadius="6" Padding="15" Margin="0,0,10,10" Width="180">
                                <StackPanel>
                                    <TextBlock Text="Sin trabajar > 2 años" Foreground="#AAAAAA" FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritorios2Anos" Text="0" FontWeight="Bold" FontSize="22" Foreground="#E6192B"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <DataGrid x:Name="TablaTerritorios" PreviewMouseWheel="UIElement_PreviewMouseWheel" FontWeight="Normal" HorizontalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="False" MaxHeight="600" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20FFFFFF"
                                  BorderThickness="1" BorderBrush="#20FFFFFF" Background="Transparent" RowBackground="Transparent">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Resources>
                                <DataTemplate x:Key="PlantillaVuelta">
                                    <StackPanel Margin="4" Visibility="{Binding EsVisible}">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding NombreS13}" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Nombre en el S-13 original"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding ListaNombresS21}" SelectedItem="{Binding NombreS21, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                      SelectionChanged="CmbVinculacion_SelectionChanged" Padding="4,2" FontSize="11" Cursor="Hand"
                                                      IsEditable="True" IsTextSearchEnabled="True"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Fechas}" Foreground="#888888" FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Territorio" Binding="{Binding Nombre}" Width="15*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Últ. Vez" Binding="{Binding UltimaVez}" Width="9*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="V1" Width="19*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Vuelta1}" ContentTemplate="{StaticResource PlantillaVuelta}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="V2" Width="19*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Vuelta2}" ContentTemplate="{StaticResource PlantillaVuelta}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="V3" Width="19*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Vuelta3}" ContentTemplate="{StaticResource PlantillaVuelta}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="V4" Width="19*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding Vuelta4}" ContentTemplate="{StaticResource PlantillaVuelta}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Acciones" Width="10*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="✏️" ToolTip="Renombrar Territorio" Click="BtnEditarTerritorio_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0,8,0" FontSize="14"/>
                                                <Button Content="🗑️" ToolTip="Eliminar Territorio" Click="BtnEliminarTerritorio_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,2,0" FontSize="14"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="PanelPaginacion" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0"/>

                    </StackPanel>
                </Expander>

                <Expander Header="CONTABILIDAD (Últimos 6 meses)" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Stretch" Margin="0,0,0,10">
                    <StackPanel Margin="10,15,10,10">
                        <TextBlock Text="Los cambios se guardan automáticamente al escribir" Foreground="#888888" FontSize="12" Margin="0,0,0,10" FontStyle="Italic"/>

                        <DataGrid x:Name="TablaContabilidad" PreviewMouseWheel="UIElement_PreviewMouseWheel" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20FFFFFF"
                                  BorderThickness="1" BorderBrush="#20FFFFFF" Background="Transparent" RowBackground="Transparent"
                                  CellEditEnding="TablaContabilidad_CellEditEnding">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="MinHeight" Value="35"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mes" Binding="{Binding NombreMesVisual}" IsReadOnly="True" Width="2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Gastos" Binding="{Binding Gastos}" Width="1.5*"/>
                                <DataGridTextColumn Header="Mantenim." Binding="{Binding Mantenimiento}" Width="1.5*"/>
                                <DataGridTextColumn Header="Obra Mund." Binding="{Binding ObraMundial}" Width="1.5*"/>
                                <DataGridTextColumn Header="Resolución" Binding="{Binding ObraResolucion}" Width="1.5*"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo}" Width="1.5*" FontWeight="Bold" Foreground="#55C855"/>
                                <DataGridTextColumn Header="Promedio" Binding="{Binding Promedio}" IsReadOnly="True" Width="1.5*" Foreground="#FFB900" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <Border x:Name="PanelCargando" Grid.RowSpan="2" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="9999">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Cargando..." Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="8" Foreground="#0078D4"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>