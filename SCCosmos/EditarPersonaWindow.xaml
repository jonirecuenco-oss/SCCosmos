<Window x:Class="SCCosmos.EditarPersonaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar datos" Height="780" Width="800" 
        Background="#1E1E1E" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="EDITAR DATOS" FontWeight="Bold" FontSize="18" Foreground="White" Margin="0,0,0,15"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,15">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Margin" Value="0,0,15,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Padding="10,5,10,10" BorderBrush="Transparent" BorderThickness="0,0,0,3" Background="Transparent">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#0078D4"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="DATOS PERSONALES">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,15,10,0">
                    <StackPanel>

                        <TextBlock Text="Nombre del publicador:" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtNombre" Background="#10FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" Padding="8" FontSize="14" Margin="0,0,0,15"/>

                        <TextBlock Text="Nombre JW Hub:" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbNombreJW" Background="#10FFFFFF" Foreground="Black" Padding="8" FontSize="14" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Nombramiento:" Foreground="#AAAAAA" Margin="0,10,0,5"/>
                                <ComboBox x:Name="CmbNombramiento" Padding="8,6" Background="#2A2A2A" Foreground="White" BorderThickness="0" FontSize="14">
                                    <ComboBoxItem Content="Ninguno"/>
                                    <ComboBoxItem Content="Anciano"/>
                                    <ComboBoxItem Content="Siervo ministerial"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Servicio:" Foreground="#AAAAAA" Margin="0,10,0,5"/>
                                <ComboBox x:Name="CmbServicio" Padding="8,6" Background="#2A2A2A" Foreground="White" BorderThickness="0" FontSize="14">
                                    <ComboBoxItem Content="Ninguno"/>
                                    <ComboBoxItem Content="Precursor regular"/>
                                    <ComboBoxItem Content="Precursor especial"/>
                                    <ComboBoxItem Content="Misionero"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Grupo (Número):" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtGrupo" Background="#10FFFFFF" Foreground="White" BorderBrush="#30FFFFFF" Padding="8" FontSize="14" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sexo:" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbSexo" Background="#10FFFFFF" Foreground="Black" Padding="5" FontSize="14" Height="36">
                                    <ComboBoxItem Content="Hombre" />
                                    <ComboBoxItem Content="Mujer" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        

                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="F. Nacimiento:" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,5"/>
                                <DatePicker x:Name="DpNacimiento" Background="#10FFFFFF" BorderBrush="#30FFFFFF" FontSize="14" Height="36"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="F. Bautismo:" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,5"/>
                                <DatePicker x:Name="DpBautismo" Background="#10FFFFFF" BorderBrush="#30FFFFFF" FontSize="14" Height="36"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#1AFFFFFF" CornerRadius="6" Padding="15" Margin="0,0,0,5">
                            <StackPanel>
                                <TextBlock Text="¿SE HA DUPLICADO POR ERROR?" FontWeight="SemiBold" Foreground="#FFB900" FontSize="13" Margin="0,0,0,10"/>
                                <TextBlock Text="Si el JSON trajo un nombre distinto y creó un duplicado, selecciona abajo la cuenta anterior." Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,15"/>
                                <ComboBox x:Name="CmbFusion" Background="#10FFFFFF" Foreground="Black" Padding="8" FontSize="14"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- NUEVA PESTAÑA CON DATAGRID BONITO Y OSCURO -->
            <TabItem Header="ACTIVIDAD MENSUAL">
                <DataGrid x:Name="GridActividad" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="#1E1E1E" Foreground="#DDDDDD" 
                          RowBackground="#252526" AlternatingRowBackground="#2D2D30" 
                          HeadersVisibility="Column" Margin="0,15,0,0" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46" 
                          BorderThickness="1" BorderBrush="#3F3F46" FontSize="14" SelectionUnit="Cell" RowHeight="38">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#101010"/>
                            <Setter Property="Foreground" Value="#AAAAAA"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#3F3F46"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0078D4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mes (24m)" Binding="{Binding NombreMesVisual}" IsReadOnly="True" Width="140" />
                        <DataGridTextColumn Header="Horas" Binding="{Binding Horas, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridCheckBoxColumn Header="Participó" Binding="{Binding Participacion, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        <DataGridTextColumn Header="Cursos" Binding="{Binding Cursos, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                        <DataGridCheckBoxColumn Header="Prec. Aux." Binding="{Binding PrecursorAuxiliar, UpdateSourceTrigger=PropertyChanged}" Width="95" />
                        <DataGridTextColumn Header="Notas" Binding="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar" Background="#333333" Foreground="White" BorderThickness="0" Padding="10" Cursor="Hand" Click="BtnCancelar_Click"/>
            <Button Grid.Column="2" Content="Guardar" Background="#0078D4" Foreground="White" BorderThickness="0" Padding="10" Cursor="Hand" IsDefault="True" Click="BtnGuardar_Click" HorizontalAlignment="Right"/>
        </Grid>

    </Grid>
</Window>