<Page x:Class="SCCosmos.ConfiguracionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="ConfiguracionPage"
      Foreground="White">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="CONFIGURACIÓN" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Gestiona las preferencias y vinculaciones del sistema." Foreground="#AAAAAA" FontSize="14"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- TARJETA 1: VINCULACIÓN JW HUB -->
                <ui:Card Padding="20" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon x:Name="IconoEstado" Grid.Column="0" Symbol="PersonSync24" FontSize="36" Margin="0,0,20,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTitulo" Text="Vinculación de cuenta JW" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="TxtDescripcion" Text="Crea un perfil dedicado de Firefox para interactuar con las funciones de JW Hub." 
                                       Foreground="#AAAAAA" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>

                        <ui:Button Grid.Column="2" 
                                   x:Name="BtnVincularCorreo" 
                                   Content="Vincular" 
                                   Appearance="Primary" 
                                   Icon="{ui:SymbolIcon PersonSync24}"
                                   Padding="15,10"
                                   Click="BtnVincularCorreo_Click"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <!-- TARJETA 2: ALMACENAMIENTO Y SINCRONIZACIÓN -->
                <ui:Card Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="FolderSync24" FontSize="36" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="#4BA3E3"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Almacenamiento de la Base de Datos" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBlock Text="Ruta donde se guarda tu archivo de datos (sccosmos.db). Si usas varios ordenadores, establece esta ruta en una carpeta sincronizada (OneDrive, Google Drive, etc.)." 
                                       Foreground="#AAAAAA" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="TxtRutaBaseDatos" Grid.Column="0" IsReadOnly="True" PlaceholderText="Cargando ruta..." Background="#1E1E1E" Foreground="White"/>
                                <ui:Button Grid.Column="1" Content="Cambiar Ruta" Margin="10,0,0,0" Appearance="Secondary" Icon="{ui:SymbolIcon Folder24}" Click="BtnCambiarRuta_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>