<Window x:Class="SCCosmos.EmparejarPersonasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisión de Sincronización" Height="600" Width="850"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="REVISIÓN DE DATOS EXTRAÍDOS" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Text="Revisa los datos antes de guardarlos. Si desmarcas una casilla, esa persona será ignorada. Puedes cambiar libremente las vinculaciones en el desplegable." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,20"/>

        <DataGrid x:Name="TablaVinculacion" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="Transparent" RowBackground="Transparent" Foreground="White"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20FFFFFF" BorderBrush="#30FFFFFF">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Importar" Width="0.7*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Actualizar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Nombre JW Hub" Binding="{Binding PersonaExtraida.NombreCompleto}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Cargos Leídos" Binding="{Binding CargosLabel}" Width="1.5*" IsReadOnly="True" Foreground="#FFB900"/>

                <DataGridTemplateColumn Header="Acción / Vincular con..." Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding ListaOpciones}" 
                                      SelectedItem="{Binding OpcionSeleccionada, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      DisplayMemberPath="NombreMostrar" Background="White" Foreground="Black" Margin="4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar" Background="#333333" Foreground="White" Padding="10" BorderThickness="0" Cursor="Hand" Click="BtnCancelar_Click"/>
            <Button Grid.Column="2" Content="Guardar y Aplicar" Background="#0078D4" Foreground="White" Padding="10" BorderThickness="0" Cursor="Hand" Click="BtnGuardar_Click"/>
        </Grid>
    </Grid>
</Window>