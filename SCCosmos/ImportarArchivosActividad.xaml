<ui:FluentWindow x:Class="SCCosmos.ImportarArchivosActividad"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Importar Archivos" Height="560" Width="550" 
        WindowStartupLocation="CenterOwner" WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">

    <Grid Margin="25,45,25,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="INSERTAR ACTIVIDAD" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock x:Name="TxtSubtitulo" Grid.Row="1" Foreground="#AAAAAA" FontSize="14" Margin="0,5,0,15"/>

        <StackPanel Grid.Row="2">

            <!-- AVISO DE DUPLICIDAD (Solo se muestra si la BD dice que ya se importaron antes) -->
            <Border x:Name="PanelAviso" Background="#4A1515" BorderBrush="#D13438" BorderThickness="1" Padding="15" Margin="0,0,0,15" Visibility="Collapsed" CornerRadius="4">
                <TextBlock Text="⚠️ ATENCIÓN: Esta congregación ya tiene datos importados para esta semana. Si vuelves a importar, los datos de actividad y territorios se actualizarán (no se borrarán publicadores)." Foreground="#FFB0B0" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>

            <!-- Bloque S-21 -->
            <Border Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="S-21 (JSON)" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                        <TextBlock x:Name="TxtS21" Text="Ningún archivo seleccionado" Foreground="#888888" Margin="0,4,0,0" FontStyle="Italic"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Examinar" Icon="{ui:SymbolIcon ArrowUp24}" Cursor="Hand" Click="BtnS21_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Bloque S-21 (PDF) -->
            <Border Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="S-21 (PDF) - Convertir tarjetas" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                        <TextBlock x:Name="TxtPdfS21" Text="Elige la carpeta con las tarjetas S-21 en PDF y se generará el JSON." Foreground="#888888" Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnVerJsonS21" Content="Ver JSON" Icon="{ui:SymbolIcon Document24}" Cursor="Hand" Appearance="Secondary" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnVerJsonS21_Click"/>
                        <ui:Button Content="Convertir…" Icon="{ui:SymbolIcon DocumentPdf24}" Cursor="Hand" Click="BtnConvertirPdf_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bloque Territorios -->
            <Border Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="S-13 (JSON) - Opcional" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                        <TextBlock x:Name="TxtTerritorios" Text="Opcional. Ningún archivo seleccionado." Foreground="#888888" Margin="0,4,0,0" FontStyle="Italic"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="Examinar" Icon="{ui:SymbolIcon Map24}" Cursor="Hand" Click="BtnTerritorios_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- Botones de Acción -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <ui:Button Content="Cancelar" Cursor="Hand" Appearance="Secondary" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <ui:Button Content="Importar" Cursor="Hand" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Click="BtnProcesar_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
