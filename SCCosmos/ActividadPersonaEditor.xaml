<UserControl x:Class="SCCosmos.ActividadPersonaEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="260">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Actividad de predicación" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="Los datos proceden del S-21. Puedes corregir participación, cursos bíblicos, precursor auxiliar, horas y notas."
                       Margin="0,4,0,0" Foreground="#AAAAAA" TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid x:Name="GridActividad"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#30FFFFFF"
                  BorderBrush="#30FFFFFF"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#08000000"
                  Foreground="White"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mes" Binding="{Binding Mes}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Año de servicio" Binding="{Binding AnioServicio}" Width="110" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Participó" Binding="{Binding Participacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="Cursos bíblicos" Binding="{Binding CursosBiblicos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="105"/>
                <DataGridCheckBoxColumn Header="Prec. auxiliar" Binding="{Binding PrecursorAuxiliar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="95"/>
                <DataGridTextColumn Header="Horas" Binding="{Binding Horas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="Notas" Binding="{Binding Notas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="TxtEstado" Foreground="#AAAAAA" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="Los cambios se guardan con el botón Guardar del formulario."
                       Foreground="#777777"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="20,0,0,0"/>
        </DockPanel>
    </Grid>
</UserControl>
