<Window x:Class="SCCosmos.FormularioCongregacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Congregación" Height="680" Width="480"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" Foreground="White" ResizeMode="NoResize">

    <Grid Margin="25">
        <StackPanel>
            <TextBlock Text="Datos de Congregación" FontSize="20" FontWeight="SemiBold" Foreground="#4BA3E3" Margin="0,0,0,20"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,5,0">
                    <TextBlock Text="Código:" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtCodigo" Padding="6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="Nombre:" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtNombre" Padding="6"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Correo electrónico:" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtEmail" Margin="0,0,0,15" Padding="6"/>

            <TextBlock Text="Sección del circuito:" Foreground="White" Margin="0,0,0,5"/>
            <ComboBox x:Name="ComboSecciones" DisplayMemberPath="Nombre" SelectedValuePath="Id" Margin="0,0,0,15" Padding="6" HorizontalAlignment="Stretch"/>

            <TextBlock Text="Dirección del Salón del Reino:" Foreground="White" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtDireccion" Margin="0,0,0,15" Padding="6"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Día (Entre semana):" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox Text="Martes (Fijo)" IsEnabled="False" Padding="6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="Hora (Ej: 19:30):" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtHoraEntreSemana" Padding="6"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="Día del fin de semana:" Foreground="White" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ComboDiaFinSemana" HorizontalAlignment="Stretch" Padding="6">
                        <ComboBoxItem Content="Sábado"/>
                        <ComboBoxItem Content="Domingo"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <TextBlock Text="Hora FDS (Ej: 10:00):" Foreground="White" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtHoraFinSemana" Padding="6"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar" Click="BtnCancelar_Click" Margin="0,0,10,0" Padding="15,8" Cursor="Hand"/>
                <ui:Button Content="Guardar cambios" Appearance="Primary" Click="BtnGuardar_Click" Padding="15,8" Cursor="Hand" Icon="{ui:SymbolIcon Save24}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>