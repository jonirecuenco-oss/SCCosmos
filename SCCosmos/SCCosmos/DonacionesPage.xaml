<Page x:Class="SCCosmos.DonacionesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SCCosmos"
      Title="DonacionesPage" Background="#1E1E1E">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TÍTULO -->
        <TextBlock Grid.Row="0"
                   Text="RENDIMIENTOS"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,0,20"/>

        <!-- FILTROS -->
        <Border Grid.Row="1"
                Background="#252528"
                Padding="18"
                CornerRadius="8"
                BorderBrush="#3E3E42"
                BorderThickness="1"
                Margin="0,0,0,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Búsqueda por año, mes, congregación y medio -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Año"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbAnio"
                                  SelectionChanged="Filtros_SelectionChanged"
                                  Padding="8"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Mes"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbMes"
                                  SelectionChanged="Filtros_SelectionChanged"
                                  Padding="8"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Congregación"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbFiltroCongregacion"
                                  DisplayMemberPath="Visual"
                                  SelectionChanged="Filtros_SelectionChanged"
                                  Padding="8"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Medio de pago"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbFiltroMedio"
                                  SelectionChanged="Filtros_SelectionChanged"
                                  Padding="8"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Búsqueda por persona + acciones -->
                <Grid Grid.Row="1"
                      Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Persona (búsqueda por nombre)"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtBuscarPersona"
                                 TextChanged="TxtBuscarPersona_TextChanged"
                                 Padding="8"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#444"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2"
                               x:Name="BtnLimpiarFiltros"
                               Content="Limpiar filtros"
                               Icon="{ui:SymbolIcon FilterDismiss24}"
                               Appearance="Secondary"
                               VerticalAlignment="Bottom"
                               Click="BtnLimpiarFiltros_Click"
                               Margin="0,0,10,0"/>

                    <ui:Button Grid.Column="3"
                               x:Name="BtnNueva"
                               Content="Añadir registro"
                               Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary"
                               VerticalAlignment="Bottom"
                               Click="BtnNueva_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- EDITOR -->
        <Border x:Name="PanelEditor"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="#252528"
                Padding="18"
                CornerRadius="8"
                BorderBrush="#0078D4"
                BorderThickness="1"
                Margin="0,0,0,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="40*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Fecha"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <DatePicker x:Name="FechaDonacion"
                                    Padding="5"
                                    Background="#1E1E1E"
                                    Foreground="White"
                                    BorderBrush="#444"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cantidad (€)"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtCantidad"
                                 Padding="8"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#444"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Medio de pago"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbMedio"
                                  Padding="8"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="40*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Persona (busca para filtrar)"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtBuscarPersonaEditor"
                                 TextChanged="TxtBuscarPersonaEditor_TextChanged"
                                 ToolTip="Escribe parte del nombre o de la congregación"
                                 Padding="8"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#444"/>
                        <ComboBox x:Name="CmbPersona"
                                  DisplayMemberPath="Visual"
                                  TextSearch.TextPath="Visual"
                                  SelectionChanged="CmbPersona_SelectionChanged"
                                  Margin="0,6,0,0"
                                  Padding="8"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Congregación"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="CmbCongregacion"
                                  DisplayMemberPath="Visual"
                                  Padding="8"
                                  Background="#1E1E1E"
                                  Foreground="White"
                                  BorderBrush="#444"
                                  Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Notas (opcional)"
                                   Foreground="#AAAAAA"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtNotas"
                                 Padding="8"
                                 Background="#1E1E1E"
                                 Foreground="White"
                                 BorderBrush="#444"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0">
                    <ui:Button Content="Cancelar"
                               Appearance="Secondary"
                               Click="BtnCancelarEdicion_Click"
                               Margin="0,0,10,0"/>
                    <ui:Button Content="Guardar registro"
                               Icon="{ui:SymbolIcon Save24}"
                               Appearance="Primary"
                               Click="BtnGuardar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RESUMEN + ACCIONES -->
        <Grid Grid.Row="3"
              Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Money24"
                               Foreground="#0078D4"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotal"
                           Text="Total: 0,00 €"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtResumen"
                           Text=""
                           Foreground="#AAAAAA"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button x:Name="BtnEditar"
                           Content="Editar"
                           Icon="{ui:SymbolIcon Edit24}"
                           Appearance="Secondary"
                           Click="BtnEditar_Click"
                           Margin="0,0,10,0"/>
                <ui:Button x:Name="BtnEliminar"
                           Content="Eliminar"
                           Icon="{ui:SymbolIcon Delete24}"
                           Appearance="Danger"
                           Click="BtnEliminar_Click"/>
            </StackPanel>
        </Grid>

        <!-- TABLA -->
        <DataGrid x:Name="TablaDonaciones"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#20FFFFFF"
                  BorderThickness="1"
                  BorderBrush="#3E3E42"
                  Background="#1E1E1E"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#0AFFFFFF"
                  MouseDoubleClick="TablaDonaciones_MouseDoubleClick">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="8"/>
                    <Setter Property="Height" Value="40"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="MinHeight" Value="38"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#200078D4"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#10FFFFFF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="FECHA"
                                    Binding="{Binding FechaVisual}"
                                    Width="110"/>
                <DataGridTextColumn Header="PERSONA"
                                    Binding="{Binding PersonaVisual}"
                                    Width="2*"
                                    FontWeight="SemiBold"/>
                <DataGridTextColumn Header="CONGREGACIÓN"
                                    Binding="{Binding CongregacionVisual}"
                                    Width="1.5*"/>
                <DataGridTextColumn Header="CANTIDAD"
                                    Binding="{Binding CantidadVisual}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#8EE29D"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="MEDIO"
                                    Binding="{Binding MedioPago}"
                                    Width="1.4*"/>
                <DataGridTextColumn Header="NOTAS"
                                    Binding="{Binding Notas}"
                                    Width="2*"
                                    Foreground="#AAAAAA"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
