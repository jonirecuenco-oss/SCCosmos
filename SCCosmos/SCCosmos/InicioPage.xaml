<Page x:Class="SCCosmos.InicioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="InicioPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource MargenPagina}" HorizontalAlignment="Left">

            <!-- Saludo -->
            <TextBlock x:Name="TxtSaludo" Text="¡Hola!" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="Esto es lo que tienes programado para la semana actual:" Style="{StaticResource TextoSecundario}" Margin="0,4,0,24"/>

            <!-- Semana y predicación -->
            <WrapPanel Orientation="Horizontal">

                <!-- ACTIVIDAD DE LA SEMANA -->
                <ui:Card Width="520" MinHeight="176" VerticalAlignment="Stretch" Padding="24" Margin="0,0,16,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icono solo para actividades que no son visita -->
                        <ui:SymbolIcon x:Name="IconoActividad" Grid.Column="0" Symbol="Calendar24" FontSize="48"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Margin="0,0,24,0" VerticalAlignment="Center"/>

                        <!-- VISITA -->
                        <StackPanel x:Name="PanelVisita" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="VISITA A CONGREGACIÓN" Style="{StaticResource Rotulo}"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Congregacion}" FontSize="26" FontWeight="SemiBold"
                                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ui:Button x:Name="BtnVerVisita" Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon Eye24}"
                                           Content="Ver" ToolTip="Ver datos de la congregación" Cursor="Hand"
                                           VerticalAlignment="Center" Visibility="Collapsed" Click="BtnVerVisita_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CalendarClock24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtRangoSemanaVisita" Style="{StaticResource TextoSecundario}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- OTRAS ACTIVIDADES -->
                        <StackPanel x:Name="PanelOtraActividad" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="ACTIVIDAD PROGRAMADA" Style="{StaticResource Rotulo}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Actividad}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CalendarClock24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtRangoSemanaOtra" Style="{StaticResource TextoSecundario}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TxtSinDatos" Grid.Column="1" Text="No se ha detectado ninguna actividad para la semana actual."
                                   Style="{StaticResource TextoSecundario}" FontSize="15" TextWrapping="Wrap"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>

                        <!-- PRÓXIMA ACTIVIDAD (enlace al calendario) -->
                        <TextBlock x:Name="TxtProximaActividad" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0" FontSize="14"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextDecorations="Underline"
                                   TextWrapping="Wrap" Cursor="Hand" Visibility="Collapsed"
                                   MouseLeftButtonUp="TxtProximaActividad_Click"/>
                    </Grid>
                </ui:Card>

                <!-- HORAS PREDICADAS -->
                <ui:Card Width="308" MinHeight="176" VerticalAlignment="Stretch" Padding="24" Margin="0,0,16,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="PREDICACIÓN ESTE MES" Style="{StaticResource Rotulo}"/>
                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHorasMes" Text="0" FontSize="32" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtHorasMesEtiqueta" Text="" Style="{StaticResource NotaDato}" FontSize="12"/>
                            </StackPanel>
                            <ui:Button x:Name="BtnSumarHoras" Grid.Column="1" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                                       Padding="10" Cursor="Hand" VerticalAlignment="Center"
                                       ToolTip="Añadir horas de predicación" Click="BtnSumarHoras_Click"/>
                        </Grid>
                    </Grid>
                </ui:Card>
            </WrapPanel>

            <!-- PROGRAMA DEL DÍA (la tarjeta solo se estira dentro de su hueco: alineada a la izquierda, con su ancho) -->
            <Grid HorizontalAlignment="Left">
            <ui:Card x:Name="PanelProgramaDia" Width="844" MinHeight="176" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="BtnProgramaDiaAnterior" Grid.Column="0" Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent"
                                   Padding="6" Cursor="Hand" ToolTip="Día anterior" Click="BtnProgramaDiaAnterior_Click"/>
                        <TextBlock x:Name="TxtFechaProgramaDia" Grid.Column="1" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ui:Button x:Name="BtnProgramaDiaSiguiente" Grid.Column="2" Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent"
                                   Padding="6" Cursor="Hand" ToolTip="Día siguiente" Click="BtnProgramaDiaSiguiente_Click"/>
                    </Grid>

                    <TextBlock x:Name="TxtSinProgramaDia" Text="No hay actividades programadas para este día."
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="13" FontStyle="Italic"
                               HorizontalAlignment="Center" Margin="0,8,0,4" Visibility="Collapsed"/>

                    <ItemsControl x:Name="ListaProgramaHoy">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Hora}" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="#26EBCB8B" CornerRadius="4" Padding="8,3" Margin="0,0,12,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding VerResponsable}">
                                            <TextBlock Text="{Binding Responsable}" Foreground="#EBCB8B" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TipoActividad}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CompaneroNombre, StringFormat='Con {0}'}" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding VerCompanero}"/>
                                            <TextBlock Text="{Binding Ubicacion}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding VerUbicacion}"/>
                                        </StackPanel>
                                        <ui:Button Grid.Column="3" Appearance="Transparent" Icon="{ui:SymbolIcon Location24}" Padding="6"
                                                   Visibility="{Binding VerMapa}" ToolTip="Ver en Google Maps" Tag="{Binding}"
                                                   Click="BtnMapaActividadInicio_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
            </Grid>

            <!-- RESUMEN DEL CIRCUITO -->
            <TextBlock Text="Resumen del circuito" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,2"/>

            <TextBlock Text="Personas" Style="{StaticResource TituloGrupo}"/>
            <WrapPanel>
                <Border Style="{StaticResource TarjetaDato}" ToolTip="Personas actuales y activas del circuito (sin históricos ni bajas)">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#60CDFF"/><ui:SymbolIcon Symbol="People24" Foreground="#60CDFF" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Personas" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalPersonas" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDato}" ToolTip="Hombres entre las personas actuales y activas">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#5B9BD5"/><ui:SymbolIcon Symbol="Person24" Foreground="#5B9BD5" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Hombres" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalHombres" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDato}" ToolTip="Mujeres entre las personas actuales y activas">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#C586C0"/><ui:SymbolIcon Symbol="Person24" Foreground="#C586C0" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Mujeres" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalMujeres" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDato}" ToolTip="Publicadores actuales sin fecha de bautismo">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#FFB900"/><ui:SymbolIcon Symbol="Person24" Foreground="#FFB900" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Publicadores no bautizados" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtNoBautizados" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDato}" ToolTip="Media de edad de las personas actuales con fecha de nacimiento válida">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#B4A0FF"/><ui:SymbolIcon Symbol="People24" Foreground="#B4A0FF" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Media de edad" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtMediaEdad" Text="-" Style="{StaticResource CifraDato}"/>
                        <TextBlock Text="años" Style="{StaticResource NotaDato}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="Servicio" Style="{StaticResource TituloGrupo}"/>
            <WrapPanel>
                <Border Style="{StaticResource TarjetaDatoAccion}" MouseLeftButtonUp="CardPrecReg_Click">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#60CDFF"/><ui:SymbolIcon Symbol="Person24" Foreground="#60CDFF" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Precursores regulares" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalPrecReg" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDatoAccion}" MouseLeftButtonUp="CardPrecEsp_Click">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#FFB900"/><ui:SymbolIcon Symbol="Star24" Foreground="#FFB900" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Precursores especiales" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalPrecEsp" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardAuxiliaresMedia" Style="{StaticResource TarjetaDato}">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#EBCB8B"/><ui:SymbolIcon Symbol="Star24" Foreground="#EBCB8B" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Auxiliares (media al mes)" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtMediaAuxiliares" Text="-" Style="{StaticResource CifraDato}"/>
                        <TextBlock x:Name="TxtPeriodoAuxiliares" Text="últimos meses con datos" Style="{StaticResource NotaDato}"/>
                    </StackPanel>
                </Border>
                <Border x:Name="CardCBs" Style="{StaticResource TarjetaDato}">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#00B294"/><ui:SymbolIcon Symbol="Book24" Foreground="#00B294" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Cursos bíblicos" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalCBs" Text="-" Style="{StaticResource CifraDato}"/>
                        <TextBlock x:Name="TxtMesCBs" Text="último mes con datos" Style="{StaticResource NotaDato}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="Nombramientos y privilegios" Style="{StaticResource TituloGrupo}"/>
            <WrapPanel>
                <Border Style="{StaticResource TarjetaDatoAccion}" MouseLeftButtonUp="CardAncianos_Click">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#6CCB5F"/><ui:SymbolIcon Symbol="People24" Foreground="#6CCB5F" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Ancianos" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalAncianos" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDatoAccion}" MouseLeftButtonUp="CardSiervos_Click">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#00B294"/><ui:SymbolIcon Symbol="Person24" Foreground="#00B294" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Siervos ministeriales" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalSM" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDato}" ToolTip="Personas con el privilegio Asesor de Betel o Voluntario a distancia">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#EBCB8B"/><ui:SymbolIcon Symbol="Building24" Foreground="#EBCB8B" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="Betel" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalBetel" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="Solicitudes" Style="{StaticResource TituloGrupo}"/>
            <WrapPanel>
                <Border Style="{StaticResource TarjetaDatoAccion}" MouseLeftButtonUp="CardA2_Click">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#FF99A4"/><ui:SymbolIcon Symbol="Document24" Foreground="#FF99A4" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="A-2" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalA2" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDatoAccion}" MouseLeftButtonUp="CardA19_Click">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#FF99A4"/><ui:SymbolIcon Symbol="Document24" Foreground="#FF99A4" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="A-19" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalA19" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDatoAccion}" MouseLeftButtonUp="CardA8_Click">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#FF99A4"/><ui:SymbolIcon Symbol="Document24" Foreground="#FF99A4" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="A-8" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalA8" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TarjetaDatoAccion}" MouseLeftButtonUp="CardG8_Click">
                    <StackPanel>
                        <Grid Style="{StaticResource CajaIcono}"><Border Style="{StaticResource FondoIcono}" Background="#FF99A4"/><ui:SymbolIcon Symbol="Document24" Foreground="#FF99A4" Style="{StaticResource IconoDato}"/></Grid>
                        <TextBlock Text="G-8" Style="{StaticResource EtiquetaDato}"/>
                        <TextBlock x:Name="TxtTotalG8" Text="-" Style="{StaticResource CifraDato}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>