<Page x:Class="SCCosmos.InicioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="InicioPage"
      Foreground="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Saludo y Cabecera -->
            <TextBlock x:Name="TxtSaludo" Grid.Row="0" Text="¡Hola!" FontSize="36" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Grid.Row="1" Text="Esto es lo que tienes programado para la semana actual:" FontSize="16" Foreground="#AAAAAA" Margin="0,0,0,30"/>

            <!-- DOS TARJETAS INDEPENDIENTES: semana + programa del día -->
            <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,25">

                <!-- TARJETA 1: ACTIVIDAD DE LA SEMANA -->
                <ui:Card Width="520"
                         MinHeight="190"
                         VerticalAlignment="Top"
                         Padding="30"
                         Background="#0AFFFFFF"
                         BorderBrush="#1AFFFFFF"
                         Margin="0,0,20,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icono dinámico solo para actividades que no son visita -->
                        <ui:SymbolIcon x:Name="IconoActividad"
                                       Grid.Column="0"
                                       Symbol="Calendar24"
                                       FontSize="60"
                                       Foreground="#0078D4"
                                       Margin="0,0,30,0"
                                       VerticalAlignment="Center"/>

                        <!-- VISITA -->
                        <StackPanel x:Name="PanelVisita"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="VISITA A CONGREGACIÓN"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#0078D4"
                                       Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Congregacion}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>

                                <ui:Button x:Name="BtnVerVisita"
                                           Grid.Column="1"
                                           Appearance="Success"
                                           Icon="{ui:SymbolIcon Eye24}"
                                           ToolTip="Ver datos de la congregación"
                                           Padding="9"
                                           Cursor="Hand"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"
                                           Click="BtnVerVisita_Click"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CalendarClock24"
                                               Foreground="#AAAAAA"
                                               Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtRangoSemanaVisita"
                                           Foreground="#AAAAAA"
                                           FontSize="14"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- OTRAS ACTIVIDADES -->
                        <StackPanel x:Name="PanelOtraActividad"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="ACTIVIDAD PROGRAMADA"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#AAAAAA"
                                       Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Actividad}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="CalendarClock24"
                                               Foreground="#AAAAAA"
                                               Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtRangoSemanaOtra"
                                           Foreground="#AAAAAA"
                                           FontSize="14"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TxtSinDatos"
                                   Grid.Column="1"
                                   Text="No se ha detectado ninguna actividad para la semana actual."
                                   Foreground="#AAAAAA"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- PRÓXIMA ACTIVIDAD (enlace al calendario) -->
                        <TextBlock x:Name="TxtProximaActividad"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,16,0,0"
                                   FontSize="14"
                                   Foreground="#80C4FF"
                                   TextDecorations="Underline"
                                   TextWrapping="Wrap"
                                   Cursor="Hand"
                                   Visibility="Collapsed"
                                   MouseLeftButtonUp="TxtProximaActividad_Click"/>
                    </Grid>
                </ui:Card>

                <!-- TARJETA 2: PROGRAMA DEL DÍA -->
                <ui:Card x:Name="PanelProgramaDia"
                         Width="760"
                         MinHeight="190"
                         VerticalAlignment="Top"
                         Padding="18"
                         Background="#0AFFFFFF"
                         BorderBrush="#1AFFFFFF"
                         Margin="0,0,0,15"
                         Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ui:Button x:Name="BtnProgramaDiaAnterior"
                                       Grid.Column="0"
                                       Icon="{ui:SymbolIcon ChevronLeft24}"
                                       Appearance="Transparent"
                                       Padding="6"
                                       Cursor="Hand"
                                       ToolTip="Día anterior"
                                       Click="BtnProgramaDiaAnterior_Click"/>

                            <TextBlock x:Name="TxtFechaProgramaDia"
                                       Grid.Column="1"
                                       Foreground="#FFB900"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <ui:Button x:Name="BtnProgramaDiaSiguiente"
                                       Grid.Column="2"
                                       Icon="{ui:SymbolIcon ChevronRight24}"
                                       Appearance="Transparent"
                                       Padding="6"
                                       Cursor="Hand"
                                       ToolTip="Día siguiente"
                                       Click="BtnProgramaDiaSiguiente_Click"/>
                        </Grid>

                        <TextBlock x:Name="TxtSinProgramaDia"
                                   Text="No hay actividades programadas para este día."
                                   Foreground="#777777"
                                   FontSize="13"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,4"
                                   Visibility="Collapsed"/>

                        <ItemsControl x:Name="ListaProgramaHoy">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#202023"
                                            BorderBrush="#333338"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Hora}"
                                                       FontWeight="Bold"
                                                       Foreground="#4BA3E3"
                                                       FontSize="15"
                                                       VerticalAlignment="Center"/>

                                            <Border Grid.Column="1"
                                                    Background="#333338"
                                                    CornerRadius="4"
                                                    Padding="6,3"
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding VerResponsable}">
                                                <TextBlock Text="{Binding Responsable}"
                                                           Foreground="#EBCB8B"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TipoActividad}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CompaneroNombre, StringFormat='Con {0}'}"
                                                           Foreground="#AAAAAA"
                                                           FontSize="13"
                                                           Visibility="{Binding VerCompanero}"/>
                                                <TextBlock Text="{Binding Ubicacion}"
                                                           Foreground="#888888"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding VerUbicacion}"/>
                                            </StackPanel>

                                            <Button Grid.Column="3"
                                                    Content="📍"
                                                    Visibility="{Binding VerMapa}"
                                                    ToolTip="Ver en Google Maps"
                                                    Tag="{Binding}"
                                                    Click="BtnMapaActividadInicio_Click"
                                                    Background="Transparent"
                                                    Foreground="#8BC9E8"
                                                    BorderThickness="0"
                                                    Padding="6"
                                                    FontSize="14"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- TARJETA: HORAS PREDICADAS -->
                <ui:Card Width="300"
                         VerticalAlignment="Top"
                         Padding="24"
                         Background="#0AFFFFFF"
                         BorderBrush="#1AFFFFFF"
                         Margin="0,0,20,15">
                    <StackPanel>
                        <TextBlock Text="HORAS PREDICADAS ESTE MES"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#8A929C"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHorasMes"
                                           Text="0"
                                           FontSize="34"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                                <TextBlock x:Name="TxtHorasMesEtiqueta"
                                           Text=""
                                           FontSize="12"
                                           Foreground="#8A929C"/>
                            </StackPanel>

                            <ui:Button x:Name="BtnSumarHoras"
                                       Grid.Column="1"
                                       Content="+"
                                       Appearance="Primary"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Padding="16,8"
                                       Cursor="Hand"
                                       VerticalAlignment="Center"
                                       ToolTip="Añadir horas de predicación"
                                       Click="BtnSumarHoras_Click"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>
            </WrapPanel>

            <!-- Título Estadísticas -->
            <TextBlock Grid.Row="3" Text="Resumen del circuito" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>

            <!-- PANEL DE ESTADÍSTICAS (WrapPanel ajusta los cuadros automáticamente si la ventana se encoge) -->
            <WrapPanel Grid.Row="4" Margin="0,0,0,20">
                <WrapPanel.Resources>
                    <!-- Estilo común para todos los cuadritos de estadística -->
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1A1A1A"/>
                        <Setter Property="BorderBrush" Value="#333333"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Padding" Value="20,15"/>
                        <Setter Property="Margin" Value="0,0,15,15"/>
                        <Setter Property="Width" Value="160"/>
                    </Style>
                </WrapPanel.Resources>

                <!-- NUEVAS TARJETAS GENERALES DEL CIRCUITO -->
                <Border ToolTip="Personas actuales y activas del circuito (sin históricos ni bajas)" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="People24" Foreground="#4BA3E3" Margin="0,0,8,0"/>
                            <TextBlock Text="Personas" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalPersonas" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border ToolTip="Hombres entre las personas actuales y activas" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Person24" Foreground="#5B9BD5" Margin="0,0,8,0"/>
                            <TextBlock Text="Hombres" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalHombres" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border ToolTip="Mujeres entre las personas actuales y activas" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Person24" Foreground="#C586C0" Margin="0,0,8,0"/>
                            <TextBlock Text="Mujeres" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalMujeres" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border ToolTip="Publicadores actuales sin fecha de bautismo" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Person24" Foreground="#FFB900" Margin="0,0,8,0"/>
                            <TextBlock Text="Pubs no bautizados" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtNoBautizados" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CardCBs" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Document24" Foreground="#00B294" Margin="0,0,8,0"/>
                            <TextBlock Text="CBs" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalCBs" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtMesCBs" Text="último mes con datos" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border ToolTip="Media de edad de las personas actuales con fecha de nacimiento válida" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="People24" Foreground="#B4A0FF" Margin="0,0,8,0"/>
                            <TextBlock Text="Media de edad" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtMediaEdad" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="años" Foreground="#777777" FontSize="10"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CardAuxiliaresMedia" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Star24" Foreground="#FFB900" Margin="0,0,8,0"/>
                            <TextBlock Text="Auxiliares (media/mes)" Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtMediaAuxiliares" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtPeriodoAuxiliares" Text="últimos meses con datos" Foreground="#777777" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border ToolTip="Personas con el privilegio Asesor de Betel o Voluntario a distancia" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Star24" Foreground="#EBCB8B" Margin="0,0,8,0"/>
                            <TextBlock Text="Betel" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalBetel" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 1: Precursores Regulares -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardPrecReg_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Person24" Foreground="#4BA3E3" Margin="0,0,8,0"/>
                            <TextBlock Text="P. Regulares" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalPrecReg" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 2: Precursores Especiales -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardPrecEsp_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Star24" Foreground="#FFB900" Margin="0,0,8,0"/>
                            <TextBlock Text="P. Especiales" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalPrecEsp" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 3: Ancianos -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardAncianos_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="People24" Foreground="#107C10" Margin="0,0,8,0"/>
                            <TextBlock Text="Ancianos" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalAncianos" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 4: Siervos Ministeriales -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardSiervos_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Person24" Foreground="#00B294" Margin="0,0,8,0"/>
                            <TextBlock Text="Siervos M." Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalSM" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 5: Solicitudes A-2 -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardA2_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Document24" Foreground="#E81123" Margin="0,0,8,0"/>
                            <TextBlock Text="Sol. A-2" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalA2" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 6: Solicitudes A-19 -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardA19_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Document24" Foreground="#E81123" Margin="0,0,8,0"/>
                            <TextBlock Text="Sol. A-19" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalA19" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Cursor="Hand" MouseLeftButtonUp="CardA8_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Document24" Foreground="#E81123" Margin="0,0,8,0"/>
                            <TextBlock Text="Sol. A-8" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalA8" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Cursor="Hand" MouseLeftButtonUp="CardG8_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Document24" Foreground="#E81123" Margin="0,0,8,0"/>
                            <TextBlock Text="Sol. G-8" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalG8" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </Grid>
    </ScrollViewer>
</Page>