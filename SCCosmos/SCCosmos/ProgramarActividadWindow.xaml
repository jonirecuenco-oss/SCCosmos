<Window x:Class="SCCosmos.ProgramarActividadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programar actividad"
        Width="720"
        Height="760"
        MinWidth="640"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Foreground="White">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock x:Name="TxtTitulo"
                       Text="PROGRAMAR ACTIVIDAD"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="White"/>

            <TextBlock x:Name="TxtContexto"
                       Margin="0,5,0,0"
                       Foreground="#9A9A9A"
                       FontSize="13"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- PERSONAS -->
                <Border Background="#252528"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Responsable"
                                   Foreground="#AAAAAA"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="Acompañante / familia (opcional)"
                                   Foreground="#AAAAAA"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="CmbResponsable"
                                  Grid.Row="1"
                                  Grid.Column="0"
                                  Height="40"
                                  Padding="8,4"
                                  Background="#2A2A2A"
                                  Foreground="White"
                                  BorderBrush="#444444">
                            <ComboBoxItem Content="SC"/>
                            <ComboBoxItem Content="Esposa"/>
                            <ComboBoxItem Content="Ambos"/>
                        </ComboBox>

                        <ComboBox x:Name="CmbAcompanante"
                                  Grid.Row="1"
                                  Grid.Column="2"
                                  Height="40"
                                  Padding="8,4"
                                  Background="#2A2A2A"
                                  Foreground="White"
                                  BorderBrush="#444444"
                                  DisplayMemberPath="Texto"
                                  SelectedValuePath="Id"
                                  SelectionChanged="CmbAcompanante_SelectionChanged"/>
                    </Grid>
                </Border>

                <!-- DATOS DE LA ACTIVIDAD -->
                <Border Background="#252528"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Hora"
                                   Foreground="#AAAAAA"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="Tipo de actividad"
                                   Foreground="#AAAAAA"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="TxtHora"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Height="40"
                                 Padding="9"
                                 FontSize="15"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#444444"
                                 ToolTip="Ejemplo: 10:00"/>

                        <ComboBox x:Name="TxtTipoActividad"
                                  Grid.Row="1"
                                  Grid.Column="2"
                                  Height="40"
                                  Padding="9,4"
                                  IsEditable="True"
                                  IsTextSearchEnabled="False"
                                  Background="#2A2A2A"
                                  Foreground="White"
                                  BorderBrush="#444444"
                                  ToolTip="Selecciona un tipo predefinido o escribe uno personalizado">
                            <ComboBoxItem Content="RSC"/>
                            <ComboBoxItem Content="Predicación"/>
                            <ComboBoxItem Content="Visita de pastoreo"/>
                            <ComboBoxItem Content="Reunión entre semana"/>
                            <ComboBoxItem Content="Reunión fin de semana"/>
                            <ComboBoxItem Content="Reunión de precursores"/>
                            <ComboBoxItem Content="Reunión A/SM"/>
                            <ComboBoxItem Content="Comida"/>
                            <ComboBoxItem Content="Alojamiento"/>
                            <ComboBoxItem Content="Otra"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="3"
                                   Text="Notas"
                                   Foreground="#AAAAAA"
                                   FontSize="12"
                                   Margin="0,14,0,6"/>

                        <TextBox x:Name="TxtNotas"
                                 Grid.Row="3"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="3"
                                 MinHeight="64"
                                 Padding="9"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#444444"/>
                    </Grid>
                </Border>

                <!-- UBICACIÓN -->
                <Border Background="#252528"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Dirección / ubicación"
                                       Foreground="#AAAAAA"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>

                            <WrapPanel Grid.Column="1"
                                       HorizontalAlignment="Right">
                                <Button Content="Usar la del acompañante"
                                        Click="BtnUsarDireccionAcompanante_Click"
                                        Padding="10,6"
                                        Margin="8,0,0,0"
                                        Background="#333333"
                                        Foreground="White"
                                        BorderBrush="#555555"
                                        Cursor="Hand"/>

                                <Button Content="Usar la del SR"
                                        Click="BtnUsarDireccionSR_Click"
                                        Padding="10,6"
                                        Margin="8,0,0,0"
                                        Background="#333333"
                                        Foreground="White"
                                        BorderBrush="#555555"
                                        Cursor="Hand"/>
                            </WrapPanel>
                        </Grid>

                        <TextBox x:Name="TxtDireccion"
                                 MinHeight="58"
                                 Padding="9"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Background="#2A2A2A"
                                 Foreground="White"
                                 BorderBrush="#444444"
                                 TextChanged="TxtDireccion_TextChanged"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TxtCoordenadas"
                                       Grid.Column="0"
                                       Text="Coordenadas: sin fijar"
                                       Foreground="#888888"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="BtnBuscarCoordenadas"
                                    Grid.Column="1"
                                    Content="Buscar coordenadas"
                                    Click="BtnBuscarCoordenadas_Click"
                                    Padding="11,6"
                                    Margin="8,0,0,0"
                                    Background="#333333"
                                    Foreground="White"
                                    BorderBrush="#555555"
                                    Cursor="Hand"/>

                            <Button x:Name="BtnCoordenadasManuales"
                                    Grid.Column="2"
                                    Content="Fijar manualmente"
                                    Click="BtnCoordenadasManuales_Click"
                                    Padding="11,6"
                                    Margin="8,0,0,0"
                                    Background="#333333"
                                    Foreground="White"
                                    BorderBrush="#555555"
                                    Cursor="Hand"/>
                        </Grid>

                        <Border x:Name="PanelCoordenadasManuales"
                                Visibility="Collapsed"
                                Background="#202023"
                                BorderBrush="#3A3A3E"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Latitud"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Margin="0,0,0,5"/>
                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="Longitud"
                                           Foreground="#AAAAAA"
                                           FontSize="11"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="TxtLatitudManual"
                                         Grid.Row="1" Grid.Column="0"
                                         Height="36"
                                         Padding="8"
                                         Background="#2A2A2A"
                                         Foreground="White"
                                         BorderBrush="#444444"
                                         ToolTip="Ejemplo: 38.722252"/>

                                <TextBox x:Name="TxtLongitudManual"
                                         Grid.Row="1" Grid.Column="2"
                                         Height="36"
                                         Padding="8"
                                         Background="#2A2A2A"
                                         Foreground="White"
                                         BorderBrush="#444444"
                                         ToolTip="Ejemplo: -6.537110"/>

                                <Button Grid.Row="1" Grid.Column="3"
                                        Content="Aplicar"
                                        Click="BtnAplicarCoordenadasManuales_Click"
                                        Padding="12,7"
                                        Margin="10,0,0,0"
                                        Background="#0078D4"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Puedes usar la dirección del acompañante o la del Salón del Reino. Si la dirección completa (por ejemplo, con piso o puerta) no se puede geolocalizar, puedes conservarla tal cual y fijar las coordenadas manualmente."
                                   Foreground="#777777"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- BOTONES -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancelar"
                    Click="BtnCancelar_Click"
                    Padding="18,9"
                    Margin="0,0,10,0"
                    Background="#333333"
                    Foreground="White"
                    BorderBrush="#555555"
                    Cursor="Hand"/>

            <Button x:Name="BtnReplicarTodosDias"
                    Content="Replicar todos los días"
                    Click="BtnReplicarTodosDias_Click"
                    Padding="18,9"
                    Margin="0,0,10,0"
                    Background="#333333"
                    Foreground="White"
                    BorderBrush="#555555"
                    Cursor="Hand"/>

            <Button x:Name="BtnGuardar"
                    Content="Guardar"
                    Click="BtnGuardar_Click"
                    Padding="22,9"
                    Background="#0078D4"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>

    </Grid>
</Window>
