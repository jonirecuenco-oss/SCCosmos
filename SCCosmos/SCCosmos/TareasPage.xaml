<Page x:Class="SCCosmos.TareasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SCCosmos"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1200"
      Title="TareasPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="{StaticResource MargenPagina}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Tareas y eventos" Style="{StaticResource TituloPagina}"/>
                <TextBlock x:Name="TxtResumen"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Las tareas del cónyuge: solo si lo permite en su Configuración -->
            <ui:Button x:Name="BtnVerConyuge"
                       Grid.Column="1"
                       Appearance="Secondary"
                       Padding="14,8"
                       Margin="0,0,10,0"
                       Cursor="Hand"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       Click="BtnVerConyuge_Click"/>

            <ui:Button Grid.Column="2"
                       Content="Nueva tarea"
                       Icon="{ui:SymbolIcon AddCircle24}"
                       Appearance="Primary"
                       Padding="14,8"
                       Cursor="Hand"
                       VerticalAlignment="Center"
                       Click="BtnNueva_Click"/>
        </Grid>

        <!-- PESTAÑAS DE CATEGORÍA (la esposa no las ve: todo es personal) -->
        <StackPanel x:Name="PanelCategorias"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,14">

            <RadioButton x:Name="TabPersonales"
                         Content="Personales"
                         Tag="Personal"
                         GroupName="CategoriaTareas"
                         IsChecked="True"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Margin="0,0,22,0"
                         Cursor="Hand"
                         Checked="Categoria_Checked"/>

            <RadioButton x:Name="TabCalendario"
                         Content="Calendario"
                         Tag="Calendario"
                         GroupName="CategoriaTareas"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Margin="0,0,22,0"
                         Cursor="Hand"
                         Checked="Categoria_Checked"/>

            <RadioButton x:Name="TabAsambleas"
                         Content="Asambleas"
                         Tag="Asambleas"
                         GroupName="CategoriaTareas"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Cursor="Hand"
                         Checked="Categoria_Checked"/>
        </StackPanel>

        <!-- LISTA -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaTareas">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,10"
                                Opacity="{Binding Opacidad}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Completada, Mode=OneTime}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          Cursor="Hand"
                                          Checked="Completada_Checked"
                                          Unchecked="Completada_Checked"/>

                                <!-- Todas igual de altas: título y fechas (la descripción
                                     y el aviso se ven al editarla; completada, la casilla) -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TituloVisual}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="{Binding FechasVisual}"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Se repite y está compartida: solo sus iconos, junto a editar -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="🔁"
                                               FontSize="16"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding RepeticionVisual}"
                                               Visibility="{Binding MostrarRepeticion, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="👫"
                                               FontSize="16"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               ToolTip="Compartida"
                                               Visibility="{Binding Compartida, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <ui:Button Icon="{ui:SymbolIcon Edit24}"
                                               Appearance="Secondary"
                                               Padding="9"
                                               Margin="12,0,0,0"
                                               Cursor="Hand"
                                               VerticalAlignment="Center"
                                               ToolTip="Editar tarea"
                                               Click="BtnEditar_Click"
                                               Tag="{Binding .}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
