<Window x:Class="SCCosmos.SyncJsonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Sincronización de JW Hub" Height="650" Width="950" 
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título y explicación, uno debajo del otro (antes compartían fila y se montaban) -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Bandeja de Sincronización" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,5"/>
            <TextBlock Text="Se han cruzado los datos del archivo JSON con tu base de datos actual. Revisa los cambios antes de confirmar." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,20"/>
        </StackPanel>

        <!-- RESUMEN DE TARJETAS -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
            <Border Background="#332b00" BorderBrush="#FFB900" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="⚠️ CONFLICTOS" Foreground="#FFB900" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtNumConflictos" Text="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#003311" BorderBrush="#10893E" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="✨ NUEVOS" Foreground="#55C855" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtNumNuevos" Text="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#330000" BorderBrush="#FF5555" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="❌ POSIBLES BAJAS" Foreground="#FF5555" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtNumBajas" Text="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="15">
                <StackPanel>
                    <TextBlock Text="✅ SIN CAMBIOS" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtNumIguales" Text="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- PESTAÑAS DE REVISIÓN -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}">

            <TabItem Header="⚠️ Conflictos detectados">
                <DataGrid x:Name="GridConflictos" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                          Background="Transparent" RowBackground="Transparent" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,10,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="MinHeight" Value="45"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Publicador" Binding="{Binding NombreVisual}" Width="3*" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Resumen de Cambios" Binding="{Binding Descripcion}" Width="5*" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <DataGridTemplateColumn Header="Acción" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="Resolver" Appearance="Primary" Click="BtnResolverConflicto_Click" Tag="{Binding}" Margin="0,5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="✨ Nuevos en JSON">
                <DataGrid x:Name="GridNuevos" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                          Background="Transparent" RowBackground="Transparent" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,10,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="MinHeight" Value="45"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Publicador Nuevo" Binding="{Binding NombreVisual}" Width="3*" FontWeight="Bold" Foreground="#55C855"/>
                        <DataGridTextColumn Header="Detalles" Binding="{Binding Descripcion}" Width="5*" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <DataGridTemplateColumn Header="Acción" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="Añadir a BD" Appearance="Success" Click="BtnAnadirNuevo_Click" Tag="{Binding}" Margin="0,5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="❌ Faltan en JSON (Bajas)">
                <DataGrid x:Name="GridBajas" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                          Background="Transparent" RowBackground="Transparent" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,10,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="MinHeight" Value="45"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Publicador en BD" Binding="{Binding NombreVisual}" Width="3*" FontWeight="Bold" Foreground="#FF5555"/>
                        <DataGridTextColumn Header="Información" Binding="{Binding Descripcion}" Width="5*" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <DataGridTemplateColumn Header="Acción" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="Confirmar Baja" Appearance="Danger" Click="BtnDarBaja_Click" Tag="{Binding}" Margin="0,5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="✅ Sin Cambios">
                <DataGrid x:Name="GridIguales" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                          Background="Transparent" RowBackground="Transparent" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,10,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Setter Property="MinHeight" Value="45"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Publicador" Binding="{Binding NombreVisual}" Width="3*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Descripcion}" Width="5*" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <DataGridTemplateColumn Header="Acción" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:Button Content="Revisar" Appearance="Secondary" Click="BtnRevisarIgual_Click" Tag="{Binding}" Margin="0,5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- BOTONES INFERIORES -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancelar Importación" Appearance="Secondary" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
                <ui:Button Content="Finalizar y Cerrar" Appearance="Primary" Click="BtnFinalizar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
