<Window x:Class="SCCosmos.FormularioPersonaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Editar Persona" Height="820" Width="1000" 
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}" KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Editar persona" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,15"/>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <TabItem Header="Datos personales">
                <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMNA IZQUIERDA: FOTO Y VÍNCULOS -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0" Padding="0,0,10,0">
                <StackPanel>

                    <!-- FOTO NORMAL -->
                    <StackPanel x:Name="PanelFotoNormal">
                        <Border Width="160" Height="160" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" ClipToBounds="True" Margin="0,0,0,10" HorizontalAlignment="Left">
                            <Image x:Name="ImgFoto" Stretch="UniformToFill"/>
                        </Border>
                        <ui:Button Content="Cambiar Foto" Appearance="Secondary" Width="160" Click="BtnCambiarFoto_Click" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                        <ui:Button Content="Borrar Foto" Appearance="Danger" Width="160" Click="BtnBorrarFoto_Click" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- FOTO CONFLICTO -->
                    <StackPanel x:Name="PanelFotoConflicto" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Text="Conflicto de Foto" Foreground="#FFB900" FontWeight="Bold" Margin="0,0,0,5"/>

                        <RadioButton x:Name="RdoFotoActual" Content="Conservar actual" IsChecked="True" Margin="0,0,0,2"/>
                        <Border Width="160" Height="160" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="#FFB900" BorderThickness="2" ClipToBounds="True" Margin="0,0,0,10" HorizontalAlignment="Left">
                            <Image x:Name="ImgFotoConflictoActual" Stretch="UniformToFill"/>
                        </Border>

                        <RadioButton x:Name="RdoFotoDuplicada" Content="Usar duplicada" Margin="0,0,0,2"/>
                        <Border Width="160" Height="160" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="#FFB900" BorderThickness="2" ClipToBounds="True" Margin="0,0,0,5" HorizontalAlignment="Left">
                            <Image x:Name="ImgFotoConflictoDuplicada" Stretch="UniformToFill"/>
                        </Border>
                    </StackPanel>

                    <ui:Button x:Name="BtnToggleVincular" Content="Vincular duplicado" Appearance="Primary" Width="160" Margin="0,20,0,5" Click="BtnToggleVincular_Click" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="PanelVincular" Visibility="Collapsed" Margin="0,5,0,0">
                        <TextBlock Text="Se eliminará a la persona seleccionada y se volcará su actividad en el perfil actual." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" Width="160" HorizontalAlignment="Left"/>
                        <ComboBox x:Name="CmbVincular" 
                                  DisplayMemberPath="NombreMostrarVinculacion" 
                                  Margin="0,0,0,10" 
                                  Width="190" 
                                  HorizontalAlignment="Left"
                                  IsEditable="True"
                                  StaysOpenOnEdit="True"
                                  IsTextSearchEnabled="False"
                                  IsTextSearchCaseSensitive="False"
                                  TextSearch.TextPath="NombreMostrarTabla"
                                  TextBoxBase.TextChanged="CmbVincular_TextChanged"
                                  SelectionChanged="CmbVincular_SelectionChanged" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- COLUMNA DERECHA: LOS DATOS DEL FORMULARIO -->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- LÍNEA 1: NOMBRE Y CONGREGACIÓN -->
                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="5">
                    <TextBlock Text="Nombre completo" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtNombre"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Margin="5">
                    <TextBlock Text="Congregación" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbCongregacion" DisplayMemberPath="Nombre" SelectedValuePath="Codigo" SelectionChanged="CmbCongregacion_SelectionChanged"/>
                </StackPanel>

                <!-- LÍNEA 2 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="5">
                    <TextBlock Text="Nombre común" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtNombreComun"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="5">
                    <TextBlock Text="Nombre JW Hub" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtNombreJW"/>
                </StackPanel>

                <!-- LÍNEA 3 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                    <TextBlock Text="Sexo" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbSexo" SelectionChanged="CmbSexo_SelectionChanged">
                        <ComboBoxItem Content="Hombre"/>
                        <ComboBoxItem Content="Mujer"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                    <TextBlock Text="Cónyuge" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbConyuge" DisplayMemberPath="NombreMostrarTabla" SelectedValuePath="Id"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="5">
                    <TextBlock Text="Email personal" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtEmail"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="3" Margin="5">
                    <TextBlock Text="Email JW" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtEmailJW"/>
                </StackPanel>

                <!-- LÍNEA 4 -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="5" VerticalAlignment="Top">
                    <TextBlock Text="Dirección (Base de datos)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtDireccion" Grid.Column="0" TextChanged="TxtDireccion_TextChanged"/>
                        <ui:Button Icon="{ui:SymbolIcon Location24}" Padding="10,10,10,10" x:Name="BtnFijarMapa" Grid.Column="1" Appearance="Secondary" Margin="5,0,0,0" Click="BtnFijarMapa_Click" ToolTip="Fijar coordenadas manualmente"/>
                    </Grid>

                    <Popup x:Name="PopupDirecciones" StaysOpen="False" PlacementTarget="{Binding ElementName=TxtDireccion}" Placement="Bottom" Width="{Binding ElementName=TxtDireccion, Path=ActualWidth}" MaxHeight="150" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource FlyoutBackground}" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="4">
                            <ListBox x:Name="ListaDirecciones" DisplayMemberPath="display_name" SelectionChanged="ListaDirecciones_SelectionChanged" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="3" Margin="5">
                    <TextBlock Text="Teléfono" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtTelefono"/>
                </StackPanel>

                <!-- LÍNEA 5 -->
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="5">
                    <TextBlock Text="Grupo" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtGrupo"/>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="5">
                    <TextBlock Text="Esperanza" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbEsperanza">
                        <ComboBoxItem Content="Otras ovejas"/>
                        <ComboBoxItem Content="Ungido"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="5">
                    <TextBlock Text="Nombramiento" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbNombramiento">
                        <ComboBoxItem Content="Publicador"/>
                        <ComboBoxItem Content="Siervo ministerial"/>
                        <ComboBoxItem Content="Anciano"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="3" Margin="5">
                    <TextBlock Text="Servicio" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CmbServicio" SelectionChanged="CmbServicio_SelectionChanged">
                        <ComboBoxItem Content="(Vacío)"/>
                        <ComboBoxItem Content="Precursor regular"/>
                        <ComboBoxItem Content="Precursor especial"/>
                        <ComboBoxItem Content="Misionero"/>
                    </ComboBox>
                </StackPanel>

                <!-- LÍNEA 6 -->
                <StackPanel Grid.Row="5" Grid.Column="0" Margin="5">
                    <TextBlock Text="Fecha nac." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtFechaNac" LostFocus="RequisitoCambiado"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="1" Margin="5">
                    <TextBlock Text="Fecha baut." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtFechaBaut"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="2" Margin="5">
                    <TextBlock Text="Inicio prec." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtInicioPrec" LostFocus="RequisitoCambiado"/>
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="3" Margin="5">
                    <TextBlock Text="Última escuela" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtEscuela"/>
                </StackPanel>

                        <!-- LÍNEA 6b: REQUISITO DE HORAS (solo precursores y misioneros) -->
                        <Grid x:Name="PanelRequisito" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Margin="5" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Requisito anual" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3" ToolTip="Horas al año si no es el normal de su servicio. Vacío: 600 los regulares; 1200 los especiales y misioneros."/>
                                <ui:TextBox x:Name="TxtRequisitoAnual" PlaceholderText="Según su servicio" LostFocus="RequisitoCambiado"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkSaludDelicada"
                                      Grid.Column="1"
                                      Content="Salud delicada (sin requisito de horas)"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,6"
                                      Checked="RequisitoCambiado"
                                      Unchecked="RequisitoCambiado"/>
                        </Grid>

                        <!-- LÍNEA 7: PRIVILEGIOS, EXHIBIDORES Y SOLICITUDES -->
                <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Margin="5,15,5,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- El permiso de exhibidores pertenece visualmente al bloque PRIVILEGIOS
                         y queda al lado del campo de texto, antes de SOLICITUDES. -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="PRIVILEGIOS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.35*"/>
                            </Grid.ColumnDefinitions>

                            <ui:TextBox x:Name="TxtPrivilegios"
                                        Grid.Column="0"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="70"
                                        VerticalScrollBarVisibility="Auto"/>

                            <Border Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Padding="10"
                                    Background="#18252D"
                                    BorderBrush="#35576A"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    VerticalAlignment="Stretch">
                                <CheckBox x:Name="ChkAprobadoExhibidores"
                                          VerticalAlignment="Center">
                                    <TextBlock Text="Aprobado para PPOC"
                                               TextWrapping="Wrap"/>
                                </CheckBox>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SOLICITUDES" FontSize="12" FontWeight="Bold" Foreground="#EBCB8B" Margin="0,0,0,5"/>
                        <UniformGrid x:Name="PanelSolicitudes" Columns="2" Rows="2">
                            <CheckBox Content="A-2" Tag="A-2" Margin="0,0,0,5"/>
                            <CheckBox Content="A-19" Tag="A-19" Margin="0,0,0,5"/>
                            <CheckBox Content="A-8" Tag="A-8" Margin="0,0,0,5"/>
                            <CheckBox Content="G-8" Tag="G-8" Margin="0,0,0,5"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <!-- LÍNEA 8: NOTAS PERSONALES (NUEVO) -->
                <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4" Margin="5,10,5,5">
                    <TextBlock Text="Notas personales" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,3"/>
                    <ui:TextBox x:Name="TxtNotas" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabActividad" Header="Actividad">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Actividad de predicación"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="Puedes editar también el mes y el año de servicio, añadir registros manuales o eliminarlos. Los cambios se aplican al pulsar Guardar."
                                       Margin="0,4,12,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Content="+ Añadir registro"
                                   Appearance="Secondary"
                                   Padding="12,7"
                                   VerticalAlignment="Center"
                                   Click="BtnAgregarActividad_Click"/>
                    </Grid>

                    <DataGrid x:Name="GridActividad"
                                  CellEditEnding="GridActividad_CellEditEnding"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                              Background="Transparent"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#08000000"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Mes" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedValue="{Binding Mes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Content"
                                                  Padding="4,2">
                                            <ComboBoxItem Content="enero"/>
                                            <ComboBoxItem Content="febrero"/>
                                            <ComboBoxItem Content="marzo"/>
                                            <ComboBoxItem Content="abril"/>
                                            <ComboBoxItem Content="mayo"/>
                                            <ComboBoxItem Content="junio"/>
                                            <ComboBoxItem Content="julio"/>
                                            <ComboBoxItem Content="agosto"/>
                                            <ComboBoxItem Content="septiembre"/>
                                            <ComboBoxItem Content="octubre"/>
                                            <ComboBoxItem Content="noviembre"/>
                                            <ComboBoxItem Content="diciembre"/>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Año de servicio"
                                                Binding="{Binding AnioServicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110"/>
                            <DataGridCheckBoxColumn Header="Participó"
                                                    Binding="{Binding Participacion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="72"/>
                            <DataGridTextColumn Header="Cursos bíblicos"
                                                Binding="{Binding CursosBiblicos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="105"/>
                            <DataGridCheckBoxColumn Header="Prec. auxiliar"
                                                    Binding="{Binding PrecursorAuxiliar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="95"/>
                            <DataGridTextColumn Header="Horas"
                                                Binding="{Binding Horas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="70"/>
                            <DataGridTextColumn x:Name="ColCredito" Binding="{Binding Credito, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="66">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="Crédito" ToolTip="Horas en otras actividades. Vacío: las que digan las notas (15h CEH, [Crédito: 15]...); 0: ninguna."/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn x:Name="ColAcumulado" Width="96" IsReadOnly="True">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Acumulado" ToolTip="Horas de adelanto (+) o de atraso (-) respecto al requisito, acumuladas en el año de servicio hasta ese mes."/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Diferencia}" Foreground="{Binding ColorDiferencia}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Notas"
                                                Binding="{Binding Notas, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>
                            <DataGridTemplateColumn Header="" Width="46">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="×"
                                                Width="26"
                                                Height="24"
                                                Padding="0"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="#FF6B6B"
                                                Background="Transparent"
                                                BorderBrush="#55FF6B6B"
                                                Cursor="Hand"
                                                ToolTip="Eliminar este registro"
                                                Click="BtnEliminarActividad_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="TxtEstadoActividad"
                               Grid.Row="2"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Los cambios se guardan con el botón Guardar del formulario."
                               TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- BOTONES INFERIORES -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <!-- AVISO DE CONFLICTOS -->
            <TextBlock x:Name="TxtAdvertenciaConflictos" Text="⚠️ Hay datos en conflicto. Escoge las opciones correctas en los campos amarillos." Foreground="#FFB900" VerticalAlignment="Center" Margin="0,0,15,0" Visibility="Collapsed" FontWeight="SemiBold"/>

            <ui:Button Content="Cancelar" Appearance="Secondary" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <ui:Button Content="Guardar" Appearance="Primary" Click="BtnGuardar_Click"/>
        </StackPanel>

    </Grid>
</Window>