<Page x:Class="SCCosmos.CircuitoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SCCosmos"
      Title="CircuitoPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="{StaticResource MargenPagina}" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA Y BOTÓN KMZ FLOTANTE -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Circuito" Style="{StaticResource TituloPagina}" VerticalAlignment="Center"/>
            <ui:Button Content="Subir archivo .KMZ" Icon="{ui:SymbolIcon Map24}" Appearance="Secondary" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnSubirKMZ_Click"/>
        </Grid>


        <TabControl Grid.Row="1" SelectionChanged="TabControl_SelectionChanged" Background="Transparent" BorderThickness="0">

            <!-- PESTAÑA 1: CONGREGACIONES Y SECCIONES -->
            <TabItem Header="Congregaciones" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- BLOQUE SECCIONES -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="15" CornerRadius="5" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="SECCIONES DEL CIRCUITO" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,0,10"/>

                            <DataGrid x:Name="TablaSecciones" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                                      Background="Transparent" RowBackground="Transparent" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                      HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" GridLinesVisibility="Horizontal" Margin="0,0,0,15" RowHeight="34">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sección" Binding="{Binding Nombre}" Width="80"/>
                                    <DataGridTextColumn Header="Lugar de Asamblea" Binding="{Binding LugarAsamblea}" Width="*"/>
                                    <DataGridTemplateColumn Header="Acción" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Padding="5" Cursor="Hand" Click="BtnBorrarSeccion_Click" Tag="{Binding Id}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Letra:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="TxtLetraSeccion" Width="50" Margin="0,0,15,0" Padding="6" MaxLength="5"/>
                                <TextBlock Text="Lugar:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="TxtLugarAsamblea" Width="250" Margin="0,0,15,0" Padding="6"/>
                                <ui:Button Content="Añadir sección" Appearance="Primary" Cursor="Hand" Click="BtnCrearSeccion_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- BLOQUE CONGREGACIONES -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" Padding="15" CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="LISTADO DE CONGREGACIONES" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <ui:Button Content="Añadir congregación" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" HorizontalAlignment="Right" Click="BtnAnadirCongregacion_Click"/>
                            </Grid>

                            <DataGrid x:Name="TablaCongregaciones" Grid.Row="1" ScrollViewer.CanContentScroll="False" RowDetailsVisibilityMode="Collapsed" AreRowDetailsFrozen="True" LoadingRowDetails="TablaCongregaciones_LoadingRowDetails" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="True" 
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                      Background="Transparent" RowBackground="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" RowHeight="34">

                                <!-- TIEMPO (AEMET) de la congregación: lo despliega el botón de la primera columna -->
                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Padding="16,10,16,12" Margin="8,2,8,8" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" MouseLeftButtonUp="DetalleTiempo_MouseLeftButtonUp" Cursor="Arrow">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource Rotulo}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Datos}" Style="{StaticResource NotaDato}" FontSize="13" Margin="24,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                                <!-- El pueblo del salón y los de su territorio (al pulsar uno, su tiempo) y, detrás, el botón para elegirlos -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <ItemsControl ItemsSource="{Binding Pueblos}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Click="PuebloTiempo_Click" Padding="10,4" Margin="0,0,6,6" Background="{Binding Fondo}" BorderBrush="{Binding Borde}" BorderThickness="1" ToolTip="{Binding Descripcion}" Cursor="Hand">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon Symbol="{Binding Simbolo}" FontSize="16" Foreground="{Binding ColorIcono}" Visibility="{Binding VerIcono}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Nombre}" FontSize="13" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Temperaturas}" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                                        <StackPanel Orientation="Horizontal" Margin="6,0,0,0" Visibility="{Binding VerAviso}" VerticalAlignment="Center"><ui:SymbolIcon Symbol="Warning24" Filled="True" FontSize="13" Foreground="{Binding ColorAviso}"/><TextBlock Text="{Binding PuntosAviso}" FontSize="11" Margin="2,0,0,0" Foreground="{Binding ColorAviso}" VerticalAlignment="Center"/></StackPanel>
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ui:Button Content="Pueblos…" Icon="{ui:SymbolIcon Location24}" Appearance="Secondary" Padding="10,4" Margin="2,0,0,6" VerticalAlignment="Top" Cursor="Hand" ToolTip="Los pueblos de su territorio, además del del salón" Click="BtnPueblosTerritorio_Click"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Mensaje}" Visibility="{Binding VerMensaje}" Style="{StaticResource NotaDato}" FontSize="13" Margin="0,0,0,8"/>
                                                <!-- Los 7 días: al pulsar uno, sus horas debajo -->
                                                <ItemsControl ItemsSource="{Binding Dias}" Margin="0,0,0,8">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Click="DiaTiempo_Click" Width="80" Padding="4,6" Margin="0,0,4,0" Background="{Binding Fondo}" BorderThickness="0" ToolTip="{Binding Descripcion}" Cursor="Hand">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding Etiqueta}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    <ui:SymbolIcon Symbol="{Binding Simbolo}" FontSize="24" Foreground="{Binding ColorIcono}" HorizontalAlignment="Center" Margin="0,4"/>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                        <TextBlock Text="{Binding Maxima}" FontSize="14" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{Binding Minima}" FontSize="13" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Lluvia}" FontSize="11" Foreground="#4BA3E3" HorizontalAlignment="Center"/>
                                                                    <StackPanel HorizontalAlignment="Center" Margin="0,2,0,0" Visibility="{Binding VerAviso}"><ui:SymbolIcon Symbol="Warning24" Filled="True" FontSize="15" Foreground="{Binding ColorAviso}" HorizontalAlignment="Center"/><TextBlock Text="{Binding PuntosAviso}" FontSize="13" Foreground="{Binding ColorAviso}" HorizontalAlignment="Center"/></StackPanel>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Horas (o tramos) del día elegido, con el icono del aviso debajo (como en Inicio) -->
                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollTiempo_PreviewMouseWheel">
                                                    <ItemsControl ItemsSource="{Binding Horas}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="{Binding Ancho}" Padding="4,8" Margin="0,0,4,4" CornerRadius="8" Background="{Binding Fondo}" ToolTip="{Binding Descripcion}">
                                                                    <StackPanel HorizontalAlignment="Center">
                                                                        <TextBlock Text="{Binding Etiqueta}" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                                        <ui:SymbolIcon Symbol="{Binding Simbolo}" FontSize="26" Foreground="{Binding ColorIcono}" HorizontalAlignment="Center" Margin="0,4"/>
                                                                        <TextBlock Text="{Binding Temperatura}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Lluvia}" FontSize="11" Foreground="#4BA3E3" HorizontalAlignment="Center"/>
                                                                        <StackPanel HorizontalAlignment="Center" Margin="0,3,0,0" Visibility="{Binding VerAviso}" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="AvisoTiempo_MouseLeftButtonUp"><ui:SymbolIcon Symbol="Warning24" Filled="True" FontSize="16" Foreground="{Binding ColorAviso}" HorizontalAlignment="Center"/><TextBlock Text="{Binding PuntosAviso}" FontSize="13" Foreground="{Binding ColorAviso}" HorizontalAlignment="Center"/></StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>

                                <!-- AHORA REACCIONA A UN SOLO CLIC -->
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <EventSetter Event="MouseLeftButtonUp" Handler="RowCongregacion_Click"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <!-- Tiempo de AEMET: se despliega debajo de la fila -->
                                    <DataGridTemplateColumn Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Click="BtnTiempoCongregacion_Click" Appearance="Transparent" Padding="4" Icon="{ui:SymbolIcon WeatherPartlyCloudyDay24}" ToolTip="Tiempo de AEMET" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="65"/>
                                    <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="140"/>
                                    <DataGridTextColumn Header="Sección" Binding="{Binding NombreSeccion}" Width="70"/>

                                    <DataGridTextColumn Header="Provincia" Binding="{Binding Provincia}" Width="110"/>
                                    <DataGridTextColumn Header="Municipio" Binding="{Binding Municipio}" Width="110"/>

                                    <DataGridTextColumn Header="Dirección" Binding="{Binding DireccionSR}" Width="*"/>
                                    <DataGridTextColumn Header="Aforo" Binding="{Binding Capacidad}" Width="55"/>
                                    <DataGridTextColumn Header="Población" Binding="{Binding Poblacion}" Width="75"/>
                                    <DataGridTextColumn Header="ES" Binding="{Binding DiaEntreSemana}" Width="55"/>
                                    <DataGridTextColumn Header="Hora ES" Binding="{Binding HoraEntreSemana}" Width="65"/>
                                    <DataGridTextColumn Header="FDS" Binding="{Binding DiaFinSemana}" Width="55"/>
                                    <DataGridTextColumn Header="Hora FDS" Binding="{Binding HoraFinSemana}" Width="70"/>
                                    <DataGridTextColumn Header="Latitud" Binding="{Binding Latitud}" Width="70"/>
                                    <DataGridTextColumn Header="Longitud" Binding="{Binding Longitud}" Width="70"/>

                                    <DataGridTemplateColumn Header="Acciones" Width="100" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:Button Icon="{ui:SymbolIcon Edit24}" Margin="0,0,5,0" Padding="6" Click="BtnEditarCongregacion_Click" Tag="{Binding}" ToolTip="Editar"/>
                                                    <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Padding="6" Click="BtnBorrarCongregacion_Click" Tag="{Binding}" ToolTip="Eliminar"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 2: MAPA -->
            <TabItem Header="Mapa" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Border CornerRadius="5" Margin="0,15,0,0" ClipToBounds="True">
                    <WebBrowser x:Name="MapaWebBrowser"/>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</Page>