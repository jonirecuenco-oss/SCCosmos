<Window x:Class="SCCosmos.VentanaPredicacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Predicación este mes"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#252526"
        Foreground="White">
    <StackPanel Margin="22">
        <TextBlock Text="Predicación este mes"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="White"/>

        <TextBlock x:Name="TxtMes"
                   Foreground="#9EA4AE"
                   FontSize="13"
                   Margin="0,4,0,0"/>

        <TextBlock Text="Horas a añadir (0 si ninguna)"
                   Foreground="#CCCCCC"
                   FontSize="13"
                   Margin="0,14,0,4"/>

        <TextBox x:Name="TxtHoras"
                 Text="0"
                 Background="#1E1E1E"
                 Foreground="White"
                 Padding="8,6"
                 BorderThickness="1"
                 BorderBrush="#3E3E42"/>

        <TextBlock Text="Cursos bíblicos a añadir (0 si ninguno)"
                   Foreground="#CCCCCC"
                   FontSize="13"
                   Margin="0,10,0,4"/>

        <TextBox x:Name="TxtCbs"
                 Text="0"
                 Background="#1E1E1E"
                 Foreground="White"
                 Padding="8,6"
                 BorderThickness="1"
                 BorderBrush="#3E3E42"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancelar"
                    Click="BtnCancelar_Click"
                    Padding="14,6"
                    Background="#2B3038"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button Content="Añadir"
                    Click="BtnAnadir_Click"
                    Padding="14,6"
                    Margin="10,0,0,0"
                    Background="#0B6FC2"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
