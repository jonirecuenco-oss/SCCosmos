<Window x:Class="SCCosmos.VentanaPredicacion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Predicación este mes"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="22">
        <TextBlock Text="Predicación este mes"
                   FontSize="17"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <TextBlock x:Name="TxtMes"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="13"
                   Margin="0,4,0,0"/>

        <TextBlock Text="Día"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="13"
                   Margin="0,14,0,4"/>

        <DatePicker x:Name="FechaDia"
                    SelectedDateChanged="FechaDia_SelectedDateChanged"
                    BorderThickness="1"
                    Padding="6,4"/>

        <TextBlock x:Name="TxtEstadoDia"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   FontSize="11.5"
                   Margin="0,4,0,0"/>

        <TextBlock Text="Horas de ese día"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="13"
                   Margin="0,12,0,4"/>

        <TextBox x:Name="TxtHoras"
                 Text="0"
                 Padding="8,6"
                 BorderThickness="1"/>

        <TextBlock Text="Cursos bíblicos de ese día"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   FontSize="13"
                   Margin="0,10,0,4"/>

        <TextBox x:Name="TxtCbs"
                 Text="0"
                 Padding="8,6"
                 BorderThickness="1"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancelar"
                    Click="BtnCancelar_Click"
                    Padding="14,6"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button Content="Guardar"
                    Click="BtnAnadir_Click"
                    Padding="14,6"
                    Margin="10,0,0,0"
                    Background="#0B6FC2"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
