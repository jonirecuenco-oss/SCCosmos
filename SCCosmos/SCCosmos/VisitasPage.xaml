<Page x:Class="SCCosmos.VisitasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SCCosmos"
      Title="VisitasPage" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <local:Base64ImageConverter x:Key="Base64Converter"/>

        <Style x:Key="EstiloBotonPaginacion" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BotonEditarTemplate">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" ToolTip="Editar" Click="BtnEditarPersona_Click" Padding="6" Margin="0,0,4,0" Cursor="Hand"/>
                <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Foreground="{DynamicResource SystemFillColorCriticalBrush}" ToolTip="Eliminar" Click="BtnEliminarPersona_Click" Padding="6" Cursor="Hand"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="EstiloPestanaVisita" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="BdTabVisita"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                CornerRadius="6,6,0,0">
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BdTabVisita" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BdTabVisita" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter TargetName="BdTabVisita" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid>
        <!-- Compatibilidad con el código existente: ya no se muestra el recuadro "Programa cronológico". -->
        <TextBlock x:Name="TxtResumenPrograma" Visibility="Collapsed"/>

        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource MargenPagina}">
                <TextBlock x:Name="TxtTitulo" Text="Visita" Style="{StaticResource TituloPagina}" Margin="0,0,0,20"/>

                <TabControl x:Name="TabsVisita"
                            SelectedIndex="0"
                            SelectionChanged="TabsVisita_SelectionChanged"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            HorizontalContentAlignment="Stretch"
                            ItemContainerStyle="{StaticResource EstiloPestanaVisita}">
                <!-- SECCIÓN MINISTERIO -->
                <TabItem x:Name="TabMinisterio" Header="Ministerio">
                    <StackPanel Margin="0,16,0,0">

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- LISTA DE GRUPOS + BOTÓN DE AÑADIR -->
                            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ListBox x:Name="TabGrupos" PreviewMouseWheel="UIElement_PreviewMouseWheel" SelectionChanged="TabGrupos_SelectionChanged" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="BdItem" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="14,9" Margin="0,0,6,6" CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BdItem" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                            </Trigger>
                                                            <!-- Después del ratón: el grupo elegido conserva su color al pasar por encima -->
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="BdItem" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                                <Setter TargetName="BdItem" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <Setter Property="FontSize" Value="14"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- ACCIONES DE MINISTERIO -->
                                <ui:Button Icon="{ui:SymbolIcon PersonAdd24}" ToolTip="Añadir publicador" Appearance="Secondary" Width="46" Height="38" Padding="0" Cursor="Hand" Click="BtnNuevaPersona_Click" VerticalAlignment="Top" Margin="4,0,0,6"/>
                                <ui:Button x:Name="BtnGenerarS21" Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="Generar todas las tarjetas S-21" Appearance="Secondary" Width="46" Height="38" Padding="0" Cursor="Hand" Click="BtnGenerarTarjetasS21_Click" VerticalAlignment="Top" Margin="4,0,0,6"/>

                                <ui:TextBox x:Name="TxtBuscarMinisterio" PlaceholderText="Buscar..." Icon="{ui:SymbolIcon Search24}" Width="320" Height="38" Margin="12,0,0,6"
                                            VerticalAlignment="Top" VerticalContentAlignment="Center" TextChanged="TxtBuscarMinisterio_TextChanged"
                                            ToolTip="Buscar por nombre común, nombre completo o nombre JW Hub"/>
                            </WrapPanel>

                            <!-- CINTA DE MES INDIVIDUAL -->
                            <StackPanel x:Name="CintaMesMinisterio" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                <TextBlock Text="Mes de referencia:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent" Padding="4" Margin="0,0,5,0" Cursor="Hand" Click="BtnMesAntMinisterio_Click"/>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="15,6" MinWidth="140">
                                    <TextBlock x:Name="TxtMesMinisterio" Text="Mes" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent" Padding="4" Margin="5,0,0,0" Cursor="Hand" Click="BtnMesSigMinisterio_Click"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="TablaVisitas" MouseLeftButtonUp="TablaVisitas_MouseLeftButtonUp" PreviewMouseWheel="UIElement_PreviewMouseWheel" FontWeight="Normal" HorizontalAlignment="Stretch" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="True"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="Transparent" RowBackground="Transparent">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsPrecursor}" Value="True">
                                            <Setter Property="Background" Value="#1A0078D4"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <!-- Apartado «PUBLICADORES INACTIVOS» al final de la tabla -->
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <StackPanel>
                                                            <Border x:Name="CabeceraApartado"
                                                                    Background="#1A4BA3E3"
                                                                    BorderBrush="#334BA3E3"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="10,7"
                                                                    Margin="0,12,0,2"
                                                                    CornerRadius="4">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="#7CC0F0"
                                                                           FontSize="12.5"
                                                                           FontWeight="SemiBold"/>
                                                            </Border>
                                                            <ItemsPresenter/>
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding Name}" Value="Activos">
                                                                <Setter TargetName="CabeceraApartado" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </DataGrid.GroupStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Nombre" Width="16*" MinWidth="200" SortMemberPath="NombreComun">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Grid Width="36" Height="36" Margin="0,4,12,4">
                                                    <!-- Sin foto, el icono de persona; la foto lo tapa, recortada en círculo -->
                                                    <Ellipse Fill="{DynamicResource ControlFillColorSecondaryBrush}"/>
                                                    <ui:SymbolIcon Symbol="Person24" FontSize="18" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding Foto, Converter={StaticResource Base64Converter}}" Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock Text="{Binding NombreVisual}" VerticalAlignment="Center" ToolTip="{Binding AlertaTooltip}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsPrecursor}" Value="True">
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- MAPA DEL TERRITORIO -->
                <TabItem x:Name="TabMapa" Header="Mapa">
                    <Grid x:Name="ContenedorMapa"
                          Margin="10,15,10,10"
                          MinHeight="300"
                          ClipToBounds="True">
                        <!--
                            WebBrowser es un control HWND. Se mantiene
                            colapsado mientras la pestaña termina su layout
                            para evitar que aparezca temporalmente por encima
                            del resto de la página.
                        -->
                        <Border BorderBrush="#333333"
                                BorderThickness="1"
                                Background="#252526"
                                ClipToBounds="True">
                            <WebBrowser x:Name="MapaWebBrowser"
                                        Margin="0"
                                        Visibility="Collapsed"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- PROGRAMA DE LA VISITA -->
                <TabItem x:Name="TabPrograma" Header="Programa">

                    <StackPanel Margin="0,16,0,0">
                        <Border Style="{StaticResource PanelTarjeta}" Padding="16,12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Programa semanal" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Puedes añadir actividades manualmente o importar toda la semana desde un archivo JSON."
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                               Margin="0,2,12,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">

                                    <ui:Button Content="Programa PDF" Icon="{ui:SymbolIcon DocumentPdf24}" Appearance="Secondary" Click="BtnImportarProgramaPdf_Click" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Importar el programa desde el PDF rellenado («Programa para la visita del SC»)"/>

                                    <ui:Button Content="Importar JSON" Icon="{ui:SymbolIcon ArrowImport24}" Appearance="Secondary" Click="BtnImportarProgramaJson_Click" VerticalAlignment="Center" Cursor="Hand" ToolTip="Importar actividades de miércoles a domingo"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="ListaProgramaDias"
                                      PreviewMouseWheel="UIElement_PreviewMouseWheel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12" Padding="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8,8,0,0" Padding="16,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding Dia}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>

                                                    <ui:Button Grid.Column="1" Content="Añadir actividad" Icon="{ui:SymbolIcon Add24}" Appearance="Secondary" Tag="{Binding Dia}" Click="BtnProgramarActividad_Click" Cursor="Hand"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1"
                                                        Margin="12,10,12,12">

                                                <TextBlock Text="Sin actividades programadas" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           FontStyle="Italic"
                                                           FontSize="12"
                                                           Margin="4,6"
                                                           Visibility="{Binding VerSinActividades}"/>

                                                <ItemsControl ItemsSource="{Binding Actividades}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="64"/>
                                                                        <ColumnDefinition Width="88"/>
                                                                        <!-- La actividad suele ser corta y la dirección larga: así la dirección cabe en una línea -->
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="2*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Hora}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="15" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"/>

                                                                    <Border Grid.Column="1"
                                                                            Background="#26EBCB8B" CornerRadius="4" Padding="8,3"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"
                                                                            Visibility="{Binding VerResponsable}">
                                                                        <TextBlock Text="{Binding Responsable}"
                                                                                   Foreground="#EBCB8B"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"/>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="2"
                                                                                Margin="8,0,12,0"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding TipoActividad}" FontSize="14"
                                                                                   FontWeight="SemiBold"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Acompanante}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                                                                                   Margin="0,3,0,0"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="3"
                                                                                Margin="0,0,12,0"
                                                                                VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Ubicacion}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                   FontSize="12"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Notas}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                                   FontSize="11"
                                                                                   FontStyle="Italic"
                                                                                   Margin="0,3,0,0"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="4"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center">
                                                                        <ui:Button Icon="{ui:SymbolIcon Location24}" Appearance="Transparent" Visibility="{Binding VerMapa}" ToolTip="Ver en Google Maps" Tag="{Binding}" Click="BtnMapaActividad_Click" Padding="6" Cursor="Hand"/>
                                                                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Appearance="Transparent" ToolTip="Editar" Tag="{Binding}" Click="BtnEditarActividad_Click" Padding="6" Margin="4,0" Cursor="Hand"/>
                                                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" Foreground="{DynamicResource SystemFillColorCriticalBrush}" ToolTip="Eliminar" Tag="{Binding}" Click="BtnEliminarActividad_Click" Padding="6" Cursor="Hand"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

                <!-- NOTAS PERSONALES -->
                <TabItem x:Name="TabNotas" Header="Notas" RequestBringIntoView="TabNotas_RequestBringIntoView">
                    <Grid x:Name="PanelNotas" Margin="0,16,0,0">
                        <Grid.Resources>
                            <Style x:Key="HeaderSeccion" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Padding" Value="16,10"/>
                                <Setter Property="CornerRadius" Value="8,8,0,0"/>
                            </Style>
                            <Style x:Key="TituloSeccion" TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                            <Style x:Key="CajaPreguntas" TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Setter Property="Padding" Value="16,0,16,0"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                            <Style x:Key="CajaRespuestas" TargetType="TextBox">
                                <Setter Property="AcceptsReturn" Value="True"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="MinHeight" Value="40"/>
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <!-- Sin esto, con un fondo semitransparente el cursor de texto sale negro -->
                                <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Style.Triggers>
                                    <!-- Respuesta marcada como alerta: fondo rojo oscuro y borde rojo; el texto sigue claro -->
                                    <DataTrigger Binding="{Binding EsAlerta}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                </Style>
                            <Style x:Key="BordeContenedor" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Margin" Value="0,0,0,16"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Style>
                        </Grid.Resources>

                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="Los cambios se guardan automáticamente al dejar de escribir." Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" VerticalAlignment="Center" FontStyle="Italic"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MisNotasAgrupadas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BordeContenedor}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Border Style="{StaticResource HeaderSeccion}">
                                                    <TextBlock Text="{Binding Cabecera}" Style="{StaticResource TituloSeccion}"/>
                                                </Border>

                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Preguntas}" Margin="0,10,15,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="45*"/>
                                                                    <ColumnDefinition Width="55*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Style="{StaticResource CajaPreguntas}" Grid.Column="0" Text="{Binding Pregunta}" VerticalAlignment="Center"/>
                                                                <TextBox Style="{StaticResource CajaRespuestas}" Grid.Column="1" 
                                                                         Text="{Binding Respuesta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         LostFocus="TxtNotaRespuesta_LostFocus"/>
                                                                <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6" Margin="6,0,0,0" Cursor="Hand" ToolTip="Marcar como alerta"
                                                                           Click="BtnAlertaNota_Click">
                                                                    <ui:Button.Icon>
                                                                        <!-- Contorno gris sin marcar; rellena y roja cuando la respuesta es una alerta -->
                                                                        <ui:SymbolIcon Symbol="Flag24" FontSize="18" Filled="{Binding EsAlerta}">
                                                                            <ui:SymbolIcon.Style>
                                                                                <Style TargetType="ui:SymbolIcon">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding EsAlerta}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </ui:SymbolIcon.Style>
                                                                        </ui:SymbolIcon>
                                                                    </ui:Button.Icon>
                                                                </ui:Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- INFORMACIÓN DE LA CONGREGACIÓN -->
                <TabItem x:Name="TabInformacion" Header="Información">
                    <Border x:Name="PanelEstadisticas"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,16,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Resumen de la congregación"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Datos calculados para el mes de referencia seleccionado"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               FontSize="12"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="#1A0078D4"
                                        BorderBrush="#400078D4"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Publicadores activos"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding TotalPersonas}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>

                                        <Border Width="1"
                                                Height="26"
                                                Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                Margin="14,0"/>

                                        <TextBlock Text="Cursos bíblicos"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding TotalCursos}"
                                                   Foreground="#FFB900"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <UniformGrid Columns="3">

                                <!-- PERSONAS -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="PERSONAS"
                                                   Foreground="#4BA3E3"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Hombres" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalHombres}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="1" Text="Mujeres" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalMujeres}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="2" Text="Media de edad" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MediaEdad, StringFormat='{}{0} años'}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="3" Text="No bautizados" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NoBautizados}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- NOMBRAMIENTOS -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="NOMBRAMIENTOS Y ACTIVIDAD"
                                                   Foreground="#55C855"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Ancianos" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Ancianos}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="1" Text="Siervos ministeriales" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SiervosMinisteriales}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="2" Text="Bautizados últ. 6 meses" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BautizadosRecientes}" Foreground="#55C855" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="3" Text="Irregulares últ. 6 meses" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Irregulares}" Foreground="#FF7777" FontWeight="SemiBold" Margin="12,4,0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- PRECURSORES -->
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="PRECURSORES Y CURSOS"
                                                   Foreground="#FFB900"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Precursores regulares" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PrecursoresRegulares}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="1" Text="Especiales / misioneros" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PrecursoresEspeciales}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="2" Text="Auxiliares este mes" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AuxiliaresMesEscogido}" Foreground="#FFB900" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="3" Text="Auxiliares últ. 6 meses" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Auxiliares6Meses}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>

                                            <TextBlock Grid.Row="4" Text="Media CB / publicador" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MediaCursos}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" Margin="12,4,0,4"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- GRUPOS DE PREDICACIÓN -->
                <TabItem x:Name="TabGruposVisita" Header="Grupos">
                    <StackPanel Margin="0,16,0,0">
                        <ItemsControl x:Name="GraficoGrupos" PreviewMouseWheel="UIElement_PreviewMouseWheel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20" Margin="0,0,12,12" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" MinWidth="260">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NombreGrupo}" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Publicadores" Width="100" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#0078D4" Height="14" Width="{Binding AnchoPublicadores}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumPublicadores}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Precursores" Width="100" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#10893E" Height="14" Width="{Binding AnchoPrecursores}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumPrecursores}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Ancianos" Width="100" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#D83B01" Height="14" Width="{Binding AnchoAncianos}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumAncianos}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                                    <TextBlock Text="Siervos Min." Width="100" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                                    <Border Background="#FFB900" Height="14" Width="{Binding AnchoSM}" CornerRadius="3" MinWidth="5"/>
                                                    <TextBlock Text="{Binding NumSM}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

                <!-- TERRITORIOS -->
                <TabItem x:Name="TabTerritorios" Header="Territorios">

                    <StackPanel Margin="10,15,10,10">

                        <!-- IMPORTAR S-13 Y SELECTOR DE AÑO DE SERVICIO -->
                        <Grid Margin="0,0,0,15">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <ui:Button Content="Importar PDF / Excel (S-13)"
                                           Icon="{ui:SymbolIcon DocumentPdf24}"
                                           Appearance="Primary"
                                           Cursor="Hand"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           ToolTip="Lee el registro de territorios desde el PDF oficial o desde el Excel y lo importa"
                                           Click="BtnImportarTerritoriosPdf_Click"/>

                                <ui:Button Content="Importar JSON (S-13)"
                                           Icon="{ui:SymbolIcon ArrowImport24}"
                                           Appearance="Secondary"
                                           Cursor="Hand"
                                           VerticalAlignment="Center"
                                           ToolTip="Cargar los territorios desde un archivo S-13 (JSON)"
                                           Click="BtnImportarTerritoriosJson_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="Año de servicio:"
                                           Foreground="Gray"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}"
                                           Appearance="Transparent"
                                           Padding="4"
                                           Margin="0,0,5,0"
                                           Cursor="Hand"
                                           Click="BtnMesAntTerritorios_Click"/>

                                <Border Background="#2A2A2A"
                                        CornerRadius="4"
                                        Padding="15,6"
                                        MinWidth="190">
                                    <TextBlock x:Name="TxtMesTerritorios"
                                               Text="Año de servicio"
                                               Foreground="White"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}"
                                           Appearance="Transparent"
                                           Padding="4"
                                           Margin="5,0,0,0"
                                           Cursor="Hand"
                                           Click="BtnMesSigTerritorios_Click"/>
                            </StackPanel>
                        </Grid>


                        <!-- ESTADÍSTICAS -->
                        <WrapPanel Margin="0,0,0,15"
                                   Orientation="Horizontal">

                            <Border x:Name="CardTotalTerritorios"
                                    Tag="Todos"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Mostrar todos los territorios"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Nº Territorios"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTotalTerritorios"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritoriosTrabajados6M"
                                    Tag="Ultimos6Meses"
                                    Background="#1A32CD32"
                                    BorderBrush="#2032CD32"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="190"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios trabajados en los últimos 6 meses"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Trabajados (últ. 6 meses)"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritoriosTrabajados"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#32CD32"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritoriosTrabajadosAnio"
                                    Tag="AnioServicio"
                                    Background="#1A32CD32"
                                    BorderBrush="#2032CD32"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="205"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios trabajados en el año de servicio"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Trabajados (año de servicio)"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritoriosTrabajadosAnio"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#32CD32"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritoriosEnCurso"
                                    Tag="EnCurso"
                                    Background="#1A1E90FF"
                                    BorderBrush="#201E90FF"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios que se están trabajando en la fecha de corte"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock x:Name="TxtEtiquetaTerritoriosEnCurso"
                                               Text="Trabajándose en"
                                               Foreground="#AAAAAA"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="TxtTerritoriosEnCurso"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#1E90FF"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritoriosCaducados"
                                    Tag="Caducados"
                                    Background="#1AFF8C00"
                                    BorderBrush="#20FF8C00"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios caducados"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Caducados (≥ 4 meses)"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritoriosCaducados"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#FF8C00"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritorios1Ano"
                                    Tag="SinTrabajar1Ano"
                                    Background="#1AFF4500"
                                    BorderBrush="#20FF4500"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios sin trabajar entre 1 y 2 años"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Sin trabajar > 1 año"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritorios1Ano"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#FF4500"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CardTerritorios2Anos"
                                    Tag="SinTrabajar2Anos"
                                    Background="#1AE6192B"
                                    BorderBrush="#20E6192B"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="15"
                                    Margin="0,0,10,10"
                                    Width="180"
                                    Cursor="Hand"
                                    ToolTip="Filtrar por territorios sin trabajar durante 2 años o más"
                                    MouseLeftButtonUp="CardFiltroTerritorio_MouseLeftButtonUp">
                                <StackPanel>
                                    <TextBlock Text="Sin trabajar > 2 años"
                                               Foreground="#AAAAAA"
                                               FontSize="12"/>
                                    <TextBlock x:Name="TxtTerritorios2Anos"
                                               Text="0"
                                               FontWeight="Bold"
                                               FontSize="22"
                                               Foreground="#E6192B"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>


                        <!--
                            Una fila por territorio y, dentro de ella,
                            TODOS los registros que intersectan el año de
                            servicio seleccionado. Ya no existe el límite
                            visual V1..V4.
                        -->
                        <DataGrid x:Name="TablaTerritorios"
                                  PreviewMouseWheel="UIElement_PreviewMouseWheel"
                                  FontWeight="Normal"
                                  HorizontalAlignment="Stretch"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  IsReadOnly="False"
                                  MaxHeight="650"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#20FFFFFF"
                                  BorderThickness="1"
                                  BorderBrush="#20FFFFFF"
                                  Background="Transparent"
                                  RowBackground="Transparent">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Territorio"
                                                    Binding="{Binding Nombre}"
                                                    Width="13*"
                                                    MinWidth="120"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="Margin"
                                                    Value="8"/>
                                            <Setter Property="FontWeight"
                                                    Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Últ. vez"
                                                    Binding="{Binding UltimaVez}"
                                                    Width="9*"
                                                    MinWidth="95"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="Margin"
                                                    Value="6"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Registros del año de servicio"
                                                        Width="60*"
                                                        MinWidth="450">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding RegistrosAnioServicio}"
                                                          Margin="1,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1AFFFFFF"
                                                                BorderBrush="#333333"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="3,1"
                                                                Margin="0,1,5,1"
                                                                Width="410">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="18"/>
                                                                    <ColumnDefinition Width="198"/>
                                                                    <ColumnDefinition Width="184"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!--
                                                                    Botón de información. Al pulsarlo se abre un Popup real
                                                                    con el nombre original procedente del registro S-13.
                                                                -->
                                                                <Grid Grid.Column="0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>

                                                                    <ToggleButton x:Name="BtnInfoRegistroS13"
                                                                                  Grid.Row="0"
                                                                                  Width="15"
                                                                                  Height="15"
                                                                                  Padding="0"
                                                                                  Margin="0"
                                                                                  Background="Transparent"
                                                                                  BorderThickness="0"
                                                                                  Foreground="#8AB4F8"
                                                                                  FontSize="11"
                                                                                  Cursor="Hand"
                                                                                  ToolTip="Ver nombre original del registro"
                                                                                  Content="ⓘ"/>

                                                                    <Button Grid.Row="1"
                                                                            Width="15"
                                                                            Height="15"
                                                                            Padding="0"
                                                                            Margin="0"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Foreground="#E34F4F"
                                                                            FontSize="13"
                                                                            FontWeight="Bold"
                                                                            Cursor="Hand"
                                                                            ToolTip="Borrar este registro"
                                                                            Content="×"
                                                                            Click="BtnEliminarRegistroTerritorio_Click"/>

                                                                    <Popup PlacementTarget="{Binding ElementName=BtnInfoRegistroS13}"
                                                                           Placement="Bottom"
                                                                           HorizontalOffset="0"
                                                                           VerticalOffset="4"
                                                                           AllowsTransparency="True"
                                                                           StaysOpen="False"
                                                                           IsOpen="{Binding IsChecked, ElementName=BtnInfoRegistroS13, Mode=TwoWay}">
                                                                        <Border Background="#2B2B2F"
                                                                                BorderBrush="#55555B"
                                                                                BorderThickness="1"
                                                                                CornerRadius="6"
                                                                                Padding="10,8"
                                                                                MaxWidth="360">
                                                                            <StackPanel>
                                                                                <TextBlock Text="Nombre original del registro S-13"
                                                                                           Foreground="#AAAAAA"
                                                                                           FontSize="11"
                                                                                           FontWeight="SemiBold"
                                                                                           Margin="0,0,0,4"/>
                                                                                <TextBlock Text="{Binding NombreS13}"
                                                                                           Foreground="White"
                                                                                           FontSize="13"
                                                                                           FontWeight="SemiBold"
                                                                                           TextWrapping="Wrap"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Popup>
                                                                </Grid>

                                                                <!--
                                                                    El borde de aviso va FUERA del ComboBox para no sustituir
                                                                    el estilo visual original de WPF-UI. Así el selector conserva
                                                                    exactamente su aspecto normal y solo se resalta cuando falta
                                                                    una equivalencia.
                                                                -->
                                                                <Border Grid.Column="1"
                                                                        CornerRadius="4"
                                                                        VerticalAlignment="Center">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding NombreS21}" Value="">
                                                                                    <Setter Property="BorderBrush" Value="#FFB900"/>
                                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                                    <Setter Property="ToolTip" Value="Este registro todavía no tiene una equivalencia seleccionada."/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding NombreS21}" Value="{x:Null}">
                                                                                    <Setter Property="BorderBrush" Value="#FFB900"/>
                                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                                    <Setter Property="ToolTip" Value="Este registro todavía no tiene una equivalencia seleccionada."/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>

                                                                    <ComboBox ItemsSource="{Binding ListaPersonasS21}"
                                                                              DisplayMemberPath="TextoMostrar"
                                                                              SelectedValuePath="NombreS21"
                                                                              SelectedValue="{Binding NombreS21, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                              SelectionChanged="CmbVinculacion_SelectionChanged"
                                                                              KeyUp="CmbVinculacion_KeyUp"
                                                                              StaysOpenOnEdit="True"
                                                                              Padding="5,0"
                                                                              FontSize="13"
                                                                              MinHeight="27"
                                                                              Cursor="Hand"
                                                                              IsEditable="True"
                                                                              IsSynchronizedWithCurrentItem="False"
                                                                              IsTextSearchEnabled="False"
                                                                              Width="198"
                                                                              VerticalAlignment="Center"/>
                                                                </Border>

                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding Fechas}"
                                                                           Foreground="#AAAAAA"
                                                                           FontSize="12"
                                                                           Margin="4,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           TextWrapping="NoWrap"
                                                                           Width="180"
                                                                           ToolTip="{Binding Fechas}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Acciones"
                                                        Width="9*"
                                                        MinWidth="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <Button Content="✏️"
                                                        ToolTip="Renombrar Territorio"
                                                        Click="BtnEditarTerritorio_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Margin="2,0,8,0"
                                                        FontSize="14"/>

                                                <Button Content="🗑️"
                                                        ToolTip="Eliminar Territorio"
                                                        Click="BtnEliminarTerritorio_Click"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Margin="0,0,2,0"
                                                        FontSize="14"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="PanelPaginacion"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,15,0,0"/>

                    </StackPanel>
                </TabItem>

                <!-- CONTABILIDAD -->
                <TabItem x:Name="TabContabilidad" Header="Contabilidad">
                    <StackPanel Margin="10,15,10,10">

                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="Los cambios se guardan automáticamente al escribir" Foreground="#888888" FontSize="12" VerticalAlignment="Center" FontStyle="Italic"/>
                            <!-- CINTA DE MES INDIVIDUAL -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Año de servicio:" Foreground="Gray" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ui:Button Icon="{ui:SymbolIcon ChevronLeft24}" Appearance="Transparent" Padding="4" Margin="0,0,5,0" Cursor="Hand" Click="BtnMesAntContabilidad_Click"/>
                                <Border Background="#2A2A2A" CornerRadius="4" Padding="15,6" MinWidth="180">
                                    <TextBlock x:Name="TxtMesContabilidad" Text="Año de servicio" Foreground="White" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ui:Button Icon="{ui:SymbolIcon ChevronRight24}" Appearance="Transparent" Padding="4" Margin="5,0,0,0" Cursor="Hand" Click="BtnMesSigContabilidad_Click"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="TablaContabilidad" PreviewMouseWheel="UIElement_PreviewMouseWheel" AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" IsReadOnly="False" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#20FFFFFF"
                                  BorderThickness="1" BorderBrush="#20FFFFFF" Background="Transparent" RowBackground="Transparent"
                                  CellEditEnding="TablaContabilidad_CellEditEnding">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="MinHeight" Value="35"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mes" Binding="{Binding NombreMesVisual}" IsReadOnly="True" Width="2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Gastos" Binding="{Binding Gastos, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                                <DataGridTextColumn Header="Mantenim." Binding="{Binding Mantenimiento, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                                <DataGridTextColumn Header="Obra Mund." Binding="{Binding ObraMundial, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                                <DataGridTextColumn Header="Resolución" Binding="{Binding ObraResolucion, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                                <DataGridTextColumn Header="Saldo máx." Binding="{Binding SaldoMaximo, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Saldo, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" FontWeight="Bold">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#55C855"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SaldoSuperaMaximo}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF5A5A"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Foreground" Value="#55C855"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SaldoSuperaMaximo}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF5A5A"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Promedio" Binding="{Binding Promedio}" IsReadOnly="True" Width="1.5*" Foreground="#FFB900" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </TabItem>

                <!-- S-303 Y S-2 -->
                <TabItem x:Name="TabS303" Header="S-303">
                    <StackPanel Margin="10,15,10,10">

                        <!-- PARTE 1: S-303 -->
                        <Border Background="#1A1A1C" CornerRadius="6" Padding="15" Margin="0,0,0,15" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DOCUMENTO S-303" FontSize="14" FontWeight="SemiBold" Foreground="#4BA3E3" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ListaS303">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NombreVisual}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <Button Grid.Column="1" Content="{Binding TextoBoton}" Tag="{Binding}" Click="BtnEditarS303_Click" 
                                                        Background="#0078D4" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand" Margin="10,0,0,0"/>
                                                <Button Grid.Column="2" Content="💾" Tag="{Binding}" Click="BtnGuardarS303BD_Click" Visibility="{Binding VerBotonBorrar}"
                                                        Background="Transparent" Foreground="#55C855" BorderThickness="0" Padding="5" Cursor="Hand" Margin="5,0,0,0"
                                                        ToolTip="Guardar los cambios actuales del PDF en la base de datos" FontSize="16"/>
                                                <Button Grid.Column="3" Content="🗑️" Tag="{Binding}" Click="BtnEliminarS303_Click" Visibility="{Binding VerBotonBorrar}"
                                                        Background="Transparent" Foreground="#FF5555" BorderThickness="0" Padding="5" Cursor="Hand" Margin="5,0,0,0" ToolTip="Eliminar PDF generado" FontSize="16"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="TxtSinS303" Text="..." Foreground="#AAAAAA" FontStyle="Italic" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- PARTE 2: S-2 (RECOMENDACIONES) -->
                        <Border Background="#1A1A1C" CornerRadius="6" Padding="15" Margin="0,0,0,15" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="RECOMENDACIONES Y BAJAS PENDIENTES (S-2)" FontSize="14" FontWeight="SemiBold" Foreground="#4BA3E3" Margin="0,0,0,10"/>

                                <DataGrid x:Name="TablaS2" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single" 
                                          IsReadOnly="False" Background="Transparent" RowBackground="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333333">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="MinHeight" Value="35"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="¿Aprobar?" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Width="72" FontSize="12" Margin="6,3" VerticalAlignment="Center"
                                                              Background="#2D2D30" Foreground="White" BorderThickness="0"
                                                              SelectedValuePath="Content"
                                                              SelectedValue="{Binding Decision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ToolTip="Sí = aprobar en JW Hub; No = cancelar en JW Hub al enviar">
                                                        <ComboBoxItem Content="Sí"/>
                                                        <ComboBoxItem Content="No"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Hermano" Binding="{Binding Hermano}" Width="2*" FontWeight="SemiBold" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Acción" Binding="{Binding Tipo}" Width="1*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Recomendado como" Binding="{Binding RecomendadoComo}" Width="1.5*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock x:Name="TxtSinS2" Text="No hay recomendaciones ni bajas pendientes en JW Hub para esta congregación." Foreground="#AAAAAA" FontStyle="Italic" Visibility="Collapsed"/>

                                <!-- La carta se genera sobre una COPIA del DOCX guardado en Documentación.
                                     Los cambios manuales de esa copia se conservan hasta el envío. -->
                                <Border Margin="0,14,0,0" Padding="12,11" Background="#22252A" CornerRadius="6"
                                        BorderBrush="#3B4652" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Carta de nombramientos" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="Usa la carta subida en Correspondencia → Visitas a congregaciones → Envío de S-303 (apartado «Carta de nombramientos»). La carta incluye únicamente los nombramientos marcados como «Sí»."
                                                   Foreground="#ABB7C4" FontSize="11" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnAbrirCartaNombramiento" Content="Abrir / editar carta"
                                                    Click="BtnAbrirCartaNombramiento_Click" Padding="12,7"
                                                    Background="#315C79" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                                            <Button Content="Regenerar desde plantilla" Click="BtnRegenerarCartaNombramiento_Click"
                                                    Padding="12,7" Background="#34383F" Foreground="White"
                                                    BorderThickness="0" Cursor="Hand"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtEstadoCarta" Text="Puedes abrir la carta, revisarla y editarla antes del envío."
                                                   Foreground="#AAB3BD" Margin="0,9,0,0" FontSize="11" TextWrapping="Wrap"/>

                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- PARTE 3: MENSAJE A LA CONGREGACIÓN -->
                        <Border Background="#1A1A1C" CornerRadius="6" Padding="15" BorderBrush="#333333" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MENSAJE PARA LA CONGREGACIÓN" FontSize="14" FontWeight="SemiBold" Foreground="#4BA3E3" Margin="0,0,0,10"/>

                                <TextBlock Text="Asunto del correo:" Foreground="#CCC" Margin="0,0,0,5"/>
                                <ui:TextBox x:Name="TxtAsuntoEnvio" Background="#1E1E1E" Foreground="White" Margin="0,0,0,15"/>

                                <TextBlock Text="Cuerpo del correo:" Foreground="#CCC" Margin="0,0,0,5"/>

                                <!-- EDITOR DE TEXTO ENRIQUECIDO WEBBROWSER -->
                                <Border BorderThickness="1" BorderBrush="#333333" CornerRadius="4" Background="#252528" Margin="0,0,0,15">
                                    <StackPanel>
                                        <!-- BARRA DE HERRAMIENTAS -->
                                        <Border Background="#1E1E1E" Padding="5">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="N" FontWeight="Bold" Width="30" Height="30" Margin="0,0,5,0" Tag="bold" Click="BtnFormato_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                <Button Content="K" FontStyle="Italic" Width="30" Height="30" Margin="0,0,5,0" Tag="italic" Click="BtnFormato_Click" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand"/>

                                                <!-- Botón S (Subrayado) con TextBlock interno -->
                                                <Button Width="30" Height="30" Margin="0,0,10,0" Tag="underline" Click="BtnFormato_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                    <TextBlock Text="S" TextDecorations="Underline" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>

                                                <ComboBox Width="60" Height="30" SelectionChanged="CmbTamano_SelectionChanged" SelectedIndex="2" Background="#333" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                    <ComboBoxItem Content="10" Tag="1"/>
                                                    <ComboBoxItem Content="13" Tag="2"/>
                                                    <ComboBoxItem Content="16" Tag="3"/>
                                                    <ComboBoxItem Content="18" Tag="4"/>
                                                    <ComboBoxItem Content="24" Tag="5"/>
                                                    <ComboBoxItem Content="32" Tag="6"/>
                                                    <ComboBoxItem Content="48" Tag="7"/>
                                                </ComboBox>
                                                <TextBlock Text="💡 Win + . para Emojis" Foreground="#888888" VerticalAlignment="Center" Margin="15,0,0,0" FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ÁREA WEB -->
                                        <WebBrowser x:Name="WbEditorEnvio" Height="300"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CONTROLES DE ENVÍO -->
                        <StackPanel x:Name="PanelControlesEnvio" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <CheckBox x:Name="ChkCopiaSRV" Content="Copia a SRV" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <ui:Button Content="Enviar S-303 y S-2" Appearance="Primary" Icon="{ui:SymbolIcon Send24}" Click="BtnEnviarS2_Click"/>
                        </StackPanel>

                    </StackPanel>
                </TabItem>
                </TabControl>

            </StackPanel>
        </ScrollViewer>

        <!-- CAPA DE CARGA GLOBAL -->
        <Border x:Name="PanelCargando" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="9999">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Cargando..." Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="8" Foreground="#0078D4"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
