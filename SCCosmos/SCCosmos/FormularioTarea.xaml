<Window x:Class="SCCosmos.FormularioTarea"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Tarea"
        Height="660"
        Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtCabecera"
                   Text="Nueva tarea"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Título"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTitulo"
                         Padding="8,6"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Categoría"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="PckCategoria"
                          Padding="8,6"
                          Margin="0,0,0,12">
                    <ComboBoxItem Content="Personal"/>
                    <ComboBoxItem Content="Calendario"/>
                    <ComboBoxItem Content="Asambleas"/>
                </ComboBox>

                <TextBlock Text="Descripción"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="TxtDescripcion"
                         Padding="8,6"
                         Height="70"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Fecha"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <DatePicker x:Name="PckFecha"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkTodoElDia"
                              Grid.Column="1"
                              Content="Todo el día"
                              IsChecked="True"
                              VerticalAlignment="Bottom"
                              Margin="14,0,0,8"
                              Cursor="Hand"
                              Checked="ChkTodoElDia_Cambiado"
                              Unchecked="ChkTodoElDia_Cambiado"/>
                </Grid>

                <StackPanel x:Name="PanelHora"
                            Margin="0,0,0,12">
                    <TextBlock Text="Hora (HH:mm)"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtHora"
                             Padding="8,6"
                             Width="120"
                             HorizontalAlignment="Left"/>
                </StackPanel>

                <CheckBox x:Name="ChkRango"
                          Content="Es un rango de varios días"
                          Cursor="Hand"
                          Margin="0,0,0,8"
                          Checked="ChkRango_Cambiado"
                          Unchecked="ChkRango_Cambiado"/>

                <StackPanel x:Name="PanelRango"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                    <TextBlock Text="Hasta (fin del rango)"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,4"/>
                    <DatePicker x:Name="PckFechaFin"/>
                </StackPanel>

                <TextBlock Text="Aviso"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="PckAviso"
                          Foreground="Black"
                          Padding="8,6"
                          Margin="0,0,0,12"/>

                <TextBlock Text="Repetición"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="PckRepeticion"
                          Foreground="Black"
                          Padding="8,6"
                          Margin="0,0,0,12"/>

                <CheckBox x:Name="ChkCompartir"
                          Cursor="Hand"
                          Margin="0,0,0,4"/>

                <TextBlock Text="El aviso aparecerá en la campana de la app al llegar el momento."
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Icon="{ui:SymbolIcon Delete24}" x:Name="BtnEliminar"
                       Grid.Column="0"
                       Content="Eliminar"
                       Appearance="Secondary"
                       Padding="12,8"
                       Cursor="Hand"
                       Visibility="Collapsed"
                       Click="BtnEliminar_Click"/>

            <ui:Button Grid.Column="2"
                       Content="Cancelar"
                       Appearance="Secondary"
                       Padding="16,8"
                       Cursor="Hand"
                       Margin="0,0,10,0"
                       Click="BtnCancelar_Click"/>

            <ui:Button Grid.Column="3"
                       Content="Guardar"
                       Appearance="Primary"
                       Padding="16,8"
                       Cursor="Hand"
                       Click="BtnGuardar_Click"/>
        </Grid>
    </Grid>
</Window>
