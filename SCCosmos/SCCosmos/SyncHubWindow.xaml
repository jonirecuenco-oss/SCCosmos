<Window x:Class="SCCosmos.SyncHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Sincronización JW Hub" Height="700" Width="1200" 
        WindowStartupLocation="CenterOwner" Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sincronización con JW Hub" FontSize="24" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,5"/>
        <TextBlock Text="Se han descargado los publicadores del servidor oficial. Revisa cambios, altas, bajas y posibles traslados antes de guardarlos." Foreground="#AAAAAA" Margin="0,0,0,20"/>

        <!-- RESUMEN DE TARJETAS -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,20">
            <Border Background="#332b00" BorderBrush="#FFB900" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="⚠️ CONFLICTOS" Foreground="#FFB900" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtNumConflictos" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#003311" BorderBrush="#10893E" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="✨ NUEVOS" Foreground="#55C855" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtNumNuevos" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#330000" BorderBrush="#FF5555" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="❌ POSIBLES BAJAS" Foreground="#FF5555" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtNumBajas" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#221A33" BorderBrush="#9B7AD8" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="↔ POSIBLES TRASLADOS" Foreground="#B99AE8" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtNumTraslados" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#252526" BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="15">
                <StackPanel>
                    <TextBlock Text="✅ SIN CAMBIOS" Foreground="#AAAAAA" FontWeight="Bold" FontSize="12"/>
                    <TextBlock x:Name="TxtNumIguales" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- PESTAÑAS DE REVISIÓN -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White">
            <TabItem Header="⚠️ Conflictos detectados">
                <DataGrid x:Name="GridConflictos" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" RowBackground="Transparent" BorderBrush="#333" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333" Margin="0,10,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="MinHeight" Value="45"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Publicador" Binding="{Binding NombreVisual}" Width="3*" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Resumen de Cambios" Binding="{Binding Descripcion}" Width="5*" Foreground="#AAAAAA"/>
                        <DataGridTemplateColumn Header="Acciones" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="Resolver" Appearance="Primary" Click="BtnResolverConflicto_Click" Tag="{Binding}" Margin="0,0,5,0"/>
                                        <ui:Button Content="Descartar" Appearance="Secondary" Click="BtnDescartar_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="✨ Nuevos en JW Hub">
                <DataGrid x:Name="GridNuevos" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" RowBackground="Transparent" BorderBrush="#333" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333" Margin="0,10,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="MinHeight" Value="45"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Publicador Nuevo" Binding="{Binding NombreVisual}" Width="3*" FontWeight="Bold" Foreground="#55C855"/>
                        <DataGridTextColumn Header="Detalles" Binding="{Binding Descripcion}" Width="5*" Foreground="#AAAAAA"/>
                        <DataGridTemplateColumn Header="Acciones" Width="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="Añadir a BD" Appearance="Success" Click="BtnAnadirNuevo_Click" Tag="{Binding}" Margin="0,0,5,0"/>
                                        <ui:Button Content="Descartar" Appearance="Secondary" Click="BtnDescartar_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="❌ Faltan en JW Hub (Bajas)">
                <DataGrid x:Name="GridBajas" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" RowBackground="Transparent" BorderBrush="#333" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333" Margin="0,10,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="MinHeight" Value="45"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Publicador en BD" Binding="{Binding NombreVisual}" Width="3*" FontWeight="Bold" Foreground="#FF5555"/>
                        <DataGridTextColumn Header="Información" Binding="{Binding Descripcion}" Width="5*" Foreground="#AAAAAA"/>
                        <DataGridTemplateColumn Header="Acciones" Width="240">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="Confirmar Baja" Appearance="Danger" Click="BtnDarBaja_Click" Tag="{Binding}" Margin="0,0,5,0"/>
                                        <ui:Button Content="Descartar" Appearance="Secondary" Click="BtnDescartar_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="↔ Posibles traslados">
                <DataGrid x:Name="GridTraslados" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" RowBackground="Transparent" BorderBrush="#333" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333" Margin="0,10,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="MinHeight" Value="48"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Persona" Binding="{Binding NombreVisual}" Width="3*" FontWeight="Bold" Foreground="#C6A7F2"/>
                        <DataGridTextColumn Header="Traslado detectado" Binding="{Binding Descripcion}" Width="6*" Foreground="#AAAAAA"/>
                        <DataGridTemplateColumn Header="Acciones" Width="285">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="Confirmar traslado" Appearance="Primary" Click="BtnConfirmarTraslado_Click" Tag="{Binding}" Margin="0,0,5,0"/>
                                        <ui:Button Content="No es traslado" Appearance="Secondary" Click="BtnNoEsTraslado_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="✅ Sin Cambios">
                <DataGrid x:Name="GridIguales" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Background="Transparent" RowBackground="Transparent" BorderBrush="#333" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#333" Margin="0,10,0,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="MinHeight" Value="45"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Publicador" Binding="{Binding NombreVisual}" Width="3*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Descripcion}" Width="5*" Foreground="#AAAAAA"/>
                        <DataGridTemplateColumn Header="Acciones" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="Revisar" Appearance="Primary" Click="BtnRevisarIgual_Click" Tag="{Binding}" Margin="0,0,5,0"/>
                                        <ui:Button Content="Descartar" Appearance="Secondary" Click="BtnDescartar_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" BorderBrush="#333" BorderThickness="0,1,0,0" Margin="0,15,0,0" Padding="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cerrar" Appearance="Secondary" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
                <ui:Button Content="Guardar" Appearance="Primary" Click="BtnFinalizar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>