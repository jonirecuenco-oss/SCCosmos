<Page x:Class="SCCosmos.CalendarioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SCCosmos"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1200"
      Title="CalendarioPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 0. CABECERA CON TÍTULO Y BOTÓN DE CONFIGURACIÓN -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="RUTA" FontSize="26" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>

                <ui:Button x:Name="BtnCiclo"
                           Grid.Column="1" 
                           Content="Configurar Ciclo (3 Años)" 
                           Icon="{ui:SymbolIcon CalendarSettings24}" 
                           Appearance="Secondary" 
                           Click="BtnConfigurarCiclo_Click" 
                           Cursor="Hand" 
                           Padding="12,6"/>
            </Grid>

            <!-- 2. LA TABLA (CON SCROLL INTERNO) -->
            <DataGrid x:Name="TablaRuta" 
                      Grid.Row="2" 
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#20FFFFFF"
                      BorderThickness="1"
                      BorderBrush="#20FFFFFF"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.ScrollUnit="Item"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      RowHeight="34">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Opacity" Value="{Binding OpacidadSemana}"/>
                        <Setter Property="Cursor" Value="Hand"/>

                        <!-- TRUCO DE ALINEACIÓN: Todas las filas tienen 4px de borde, pero invisible por defecto -->
                        <Setter Property="BorderThickness" Value="4,0,0,0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>

                        <EventSetter Event="MouseLeftButtonUp" Handler="FilaSemana_Click"/>

                        <Style.Triggers>
                            <!-- SEMANA ACTUAL -->
                            <DataTrigger Binding="{Binding IsActual}" Value="True">
                                <Setter Property="Background" Value="#664BA3E3"/>
                                <!-- Solo "encendemos" el color del borde, el grosor de 4px ya está aplicado -->
                                <Setter Property="BorderBrush" Value="#4BA3E3"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>

                            <!-- EFECTO HOVER -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <StackPanel>
                                                <Border Background="#25FFFFFF" Padding="15,6" Margin="0" BorderThickness="0,1,0,1" BorderBrush="#35FFFFFF">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Semana" Binding="{Binding RangoFechas}" Width="16*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad}" Width="12*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Congregación" Binding="{Binding CongregacionVisual}" Width="20*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="10*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Acompañante" Binding="{Binding AcompananteVisual}" Width="14*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Alojamiento" Binding="{Binding Alojamiento}" Width="14*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Acciones" Width="Auto" MinWidth="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Left" Margin="8,0" Orientation="Horizontal" VerticalAlignment="Center">

                                    <!-- Editar (solo para el SC) -->
                                    <ContentControl Margin="0,0,5,0" Visibility="{Binding VisibilidadAccionesSoloSC}">
                                        <ui:Button Icon="{ui:SymbolIcon Edit24}" Padding="6" Cursor="Hand" Click="BtnEditar_Click" ToolTip="Editar parámetros de la semana"/>
                                    </ContentControl>

                                    <!-- Botones de VISITA -->
                                    <ContentControl Margin="0,0,5,0" Visibility="{Binding VisibilidadVisita}">
                                        <ui:Button Icon="{ui:SymbolIcon SendClock24}" Appearance="Secondary" Padding="6" Cursor="Hand" Click="BtnEnviarS302_Click" ToolTip="Enviar S-302" Background="{Binding ColorBotonS302}"/>
                                    </ContentControl>

                                    <ContentControl Margin="0,0,5,0" Visibility="{Binding VisibilidadVisita}">
                                        <ui:Button Icon="{ui:SymbolIcon DocumentArrowRight24}" Appearance="Secondary" Padding="6" Cursor="Hand" Click="BtnEnviarDoc_Click" ToolTip="Enviar documentación de la visita" Background="{Binding ColorBotonDoc}"/>
                                    </ContentControl>
                                    <!-- 
                                    <ContentControl Margin="0,0,5,0" Visibility="{Binding VisibilidadVisita}">
                                        <ui:Button Icon="{ui:SymbolIcon Chat24}" Appearance="Primary" Background="#25D366" BorderThickness="0" Padding="6" Cursor="Hand" Click="BtnWhatsAppCoordinador_Click" ToolTip="WhatsApp al Coordinador"/>
                                    </ContentControl>
                                    -->
                                    <!-- Botón Mensaje a Rep. de Betel (SOLO AC-BR) -->
                                    <ContentControl Margin="0,0,5,0" Visibility="{Binding VisibilidadAsambleaBR}">
                                        <ui:Button Icon="{ui:SymbolIcon PersonMail24}" Appearance="Secondary" Padding="6" Cursor="Hand" Click="BtnEnviarRepBetel_Click" ToolTip="Enviar mensaje a Rep. de Betel" Background="{Binding ColorBotonRepBetel}"/>
                                    </ContentControl>

                                    <!-- Botones de HERRAMIENTAS: Importar -->
                                    <ContentControl Margin="0,0,5,0" Visibility="{Binding VisibilidadVisita}">
                                        <ui:Button Icon="{ui:SymbolIcon ArrowImport24}" Appearance="Secondary" Padding="6" Cursor="Hand" Click="BtnImportar_Click" ToolTip="Importar archivos (S-21 / Territorios)"/>
                                    </ContentControl>

                                    <!-- BOTÓN DEL OJO -->
                                    <ContentControl Margin="0,0,5,0" Visibility="{Binding VisibilidadVerVisita}">
                                        <ui:Button Icon="{ui:SymbolIcon Eye24}" Appearance="Success" Padding="6" Cursor="Hand" Click="BtnVerVisita_Click" ToolTip="Ver datos de la congregación"/>
                                    </ContentControl>

                                    <ContentControl Margin="0,0,5,0" Visibility="{Binding VisibilidadAccionesSoloSC}">
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" 
                                                   Appearance="Transparent" 
                                                   Foreground="#D13438"
                                                   Padding="6" 
                                                   Cursor="Hand" 
                                                   Click="BtnEliminarActividad_Click" 
                                                   ToolTip="Eliminar esta actividad extra"
                                                   Visibility="{Binding EsClonada}"/>
                                    </ContentControl>

                                    <!-- Botones de SOLAPAMIENTO DE ACTIVIDADES -->
                                    <ContentControl Margin="0,0,5,0" Visibility="{Binding VisibilidadAccionesSoloSC}">
                                        <ui:Button 
                                                   Icon="{ui:SymbolIcon AddCircle24}" 
                                                   Appearance="Transparent" 
                                                   Foreground="#0078D4"
                                                   Padding="6" 
                                                   Cursor="Hand" 
                                                   Click="BtnSolaparActividad_Click" 
                                                   ToolTip="Solapar otra actividad en la misma semana"
                                                   Visibility="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsMouseOver, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </ContentControl>

                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <!-- OVERLAY DE CARGA -->
        <Grid x:Name="OverlayCargando" Background="#FF141418" Visibility="Collapsed" Panel.ZIndex="100" Grid.RowSpan="10">
            <Border Background="#FF26262C"
                    CornerRadius="10"
                    Padding="28,22"
                    BorderThickness="1"
                    BorderBrush="#33FFFFFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Cargando..." Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" HorizontalAlignment="Center"/>
                    <Border Width="220" Height="6" CornerRadius="3" Background="#22FFFFFF" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="BarraCarga" Width="70" Height="6" RadiusX="3" RadiusY="3" HorizontalAlignment="Left">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#004BA3E3" Offset="0"/>
                                        <GradientStop Color="#FF4BA3E3" Offset="0.5"/>
                                        <GradientStop Color="#004BA3E3" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="TraslacionCarga" X="-70"/>
                                </Rectangle.RenderTransform>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="TraslacionCarga"
                                                                 Storyboard.TargetProperty="X"
                                                                 From="-70" To="220"
                                                                 Duration="0:0:1.1"
                                                                 RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>