<Page x:Class="SCCosmos.ActividadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Actividad"
      Foreground="White">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ACTIVIDAD" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Todo lo que se hace en SCCosmos, en lenguaje natural: quién (dispositivo y perfil), cuándo y qué."
                       Foreground="#AAAAAA" FontSize="14" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,14">
            <TextBlock Text="Categoría:"
                       Foreground="#CCC"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbCategoria"
                      Width="220"
                      SelectionChanged="CmbCategoria_SelectionChanged"/>
            <ui:Button Content="Actualizar"
                       Appearance="Secondary"
                       Margin="14,0,0,0"
                       Click="BtnActualizar_Click"/>
            <TextBlock x:Name="LblResumen"
                       Foreground="#9299A3"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"/>
        </StackPanel>

        <ListBox x:Name="ListaActividad"
                 Grid.Row="2"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#232833"
                            BorderBrush="#343B45"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,12"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Stretch">

                        <StackPanel>
                            <TextBlock Text="{Binding Cabecera}"
                                       Foreground="#7FB3E0"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Descripcion}"
                                       Foreground="White"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>

</Page>
