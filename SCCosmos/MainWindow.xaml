<ui:FluentWindow x:Class="SCCosmos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:SCCosmos"
        mc:Ignorable="d" 
        Title="SCCosmos" Height="700" Width="1200"
        WindowState="Maximized" 
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Window.Resources>
        <!-- Forzar cursores ee-->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ui:NavigationViewItem" BasedOn="{StaticResource {x:Type ui:NavigationViewItem}}">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. LA BARRA SUPERIOR MODERNA -->
        <ui:TitleBar Grid.Row="0" Title="SCCosmos">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="sccosmos.ico"/>
            </ui:TitleBar.Icon>

            <ui:TitleBar.Header>
                <!-- LA CLAVE ESTÁ AQUÍ: HorizontalAlignment="Right" lo empuja al fondo a la derecha -->
                <Grid HorizontalAlignment="Right" Margin="0,0,10,0">
                    <ui:Button x:Name="BtnAlertas" Icon="{ui:SymbolIcon Alert24}" 
                               Appearance="Transparent" Foreground="#AAAAAA" 
                               Cursor="Hand" Click="BtnAlertas_Click" MouseEnter="BtnAlertas_MouseEnter"
                               ToolTip="Notificaciones y Alertas" Padding="8,6"/>



                    <!-- EL MENÚ FLOTANTE (POPUP) -->
                    <Popup x:Name="PopupAlertas" StaysOpen="False" PlacementTarget="{Binding ElementName=BtnAlertas}" Placement="Bottom" VerticalOffset="8" HorizontalOffset="-250" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="8" Padding="15" Width="300" Margin="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.5" Direction="270" Color="Black"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock x:Name="TituloPopup" Text="Alertas Pendientes" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>

                                <ItemsControl x:Name="ListaAlertas">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- ESTO LO HACE CLICABLE Y AÑADE EL EVENTO -->
                                            <Border Background="#333337" CornerRadius="6" Padding="12" Margin="0,0,0,8" 
                                                    BorderThickness="4,0,0,0" BorderBrush="{Binding ColorBorde}"
                                                    Cursor="Hand" MouseLeftButtonUp="AlertaItem_Click" Tag="{Binding TipoAlerta}">
                                                <!-- Efecto visual al pasar el ratón -->
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#3E3E42"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <StackPanel>
                                                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="{Binding Descripcion}" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="13"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="TxtSinAlertas" Text="¡Todo está al día!&#x0a;Tómate un café ☕" TextAlignment="Center" Foreground="#888888" FontStyle="Italic" Visibility="Collapsed" Margin="0,10,0,10"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 2. MENÚ PRINCIPAL -->
        <Grid Grid.Row="1">
            <ui:NavigationView x:Name="MenuPrincipal" 
                               OpenPaneLength="220"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="True" 
                               ScrollViewer.VerticalScrollBarVisibility="Disabled">

                <ui:NavigationView.PaneHeader>
                    <StackPanel Orientation="Horizontal" Margin="9,0,0,0">
                        <Image Source="sccosmos.ico" Width="24" Height="24" VerticalAlignment="Center"/>
                        <TextBlock Text="SCCosmos" FontSize="24" FontWeight="SemiBold" Margin="10,0,0,2" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:NavigationView.PaneHeader>

                <ui:NavigationView.Header>
                    <Grid Margin="10,0,0,0"></Grid>
                </ui:NavigationView.Header>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Inicio" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type local:InicioPage}" IsActive="True"/>
                    <ui:NavigationViewItem Content="Correspondencia" Icon="{ui:SymbolIcon Mail24}" TargetPageType="{x:Type local:DocumentacionPage}"/>
                    <ui:NavigationViewItem Content="Circuito" Icon="{ui:SymbolIcon ArrowClockwiseDashes24}" TargetPageType="{x:Type local:CircuitoPage}"/>
                    
                    <ui:NavigationViewItem x:Name="MenuRuta" Content="Ruta" Icon="{ui:SymbolIcon Calendarrtl24}" TargetPageType="{x:Type local:CalendarioPage}"/>
                    <ui:NavigationViewItem Content="Personas" Icon="{ui:SymbolIcon People24}" TargetPageType="{x:Type local:PersonasPage}"/>
                    <ui:NavigationViewItem Content="Escuelas" Icon="{ui:SymbolIcon HatGraduation24}" TargetPageType="{x:Type local:EscuelasPage}"/>
                    <ui:NavigationViewItem Content="Asambleas" Icon="{ui:SymbolIcon Earth24}" TargetPageType="{x:Type local:AsambleasPage}"/>
                    <ui:NavigationViewItem Content="Archivo del circuito" Icon="{ui:SymbolIcon BriefCase24}" TargetPageType="{x:Type local:ArchivoCircuitoPage}"/>
                    <ui:NavigationViewItem Content="Descargas" Icon="{ui:SymbolIcon ArrowDownload24}" TargetPageType="{x:Type local:DescargasPage}"/>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Configuración" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type local:ConfiguracionPage}"/>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- 3. DIVISOR INVISIBLE PARA REDIMENSIONAR EL MENÚ -->
            <Thumb x:Name="MenuSplitter" Width="8" Cursor="SizeWE" HorizontalAlignment="Left" DragDelta="MenuSplitter_DragDelta" Panel.ZIndex="999">
                <Thumb.RenderTransform>
                    <TranslateTransform X="{Binding OpenPaneLength, ElementName=MenuPrincipal}"/>
                </Thumb.RenderTransform>
                <Thumb.Style>
                    <Style TargetType="Thumb">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent">
                                        <Border x:Name="VisualSplitter" Background="Transparent" Width="2" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="VisualSplitter" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="VisualSplitter" Property="Background" Value="#0078D4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaneOpen, ElementName=MenuPrincipal}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Thumb.Style>
            </Thumb>
        </Grid>
    </Grid>
</ui:FluentWindow>