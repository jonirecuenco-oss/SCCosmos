<Page x:Class="SCCosmos.TareasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SCCosmos"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1200"
      Title="TareasPage">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="TAREAS Y EVENTOS"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock x:Name="TxtResumen"
                           Foreground="#AAAAAA"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Content="＋ Nueva tarea"
                       Icon="{ui:SymbolIcon AddCircle24}"
                       Appearance="Primary"
                       Padding="14,8"
                       Cursor="Hand"
                       VerticalAlignment="Center"
                       Click="BtnNueva_Click"/>
        </Grid>

        <!-- LISTA -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListaTareas">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#14FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,0,10"
                                Opacity="{Binding Opacidad}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Completada, Mode=OneTime}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          Cursor="Hand"
                                          Checked="Completada_Checked"
                                          Unchecked="Completada_Checked"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding TituloVisual}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding FechasVisual}"
                                               Foreground="#4BA3E3"
                                               Margin="0,3,0,0"/>

                                    <TextBlock Text="{Binding Descripcion}"
                                               Foreground="#B6BBC2"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,7,0,0">

                                        <Border Background="#222832"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding MostrarAviso, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding AvisoVisual}"
                                                       Foreground="#EBCB8B"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Background="#222832"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding MostrarRepeticion, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding RepeticionVisual}"
                                                       Foreground="#9CC3F5"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Background="#1E2C24"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding Compartida, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="👫 Compartida"
                                                       Foreground="#7ED889"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Background="#1E2C24"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                Visibility="{Binding MostrarEstado, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding EstadoVisual}"
                                                       Foreground="#7ED889"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <ui:Button Grid.Column="2"
                                           Icon="{ui:SymbolIcon Edit24}"
                                           Appearance="Secondary"
                                           Padding="9"
                                           Cursor="Hand"
                                           VerticalAlignment="Top"
                                           ToolTip="Editar tarea"
                                           Click="BtnEditar_Click"
                                           Tag="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
