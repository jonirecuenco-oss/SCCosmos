<Window x:Class="SCCosmos.ConfirmarEnvioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Confirmar envío" Height="450" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitulo" Text="Confirmar envío" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,15"/>

        <!-- AVISO DE DUPLICIDAD (Detección en tiempo real) -->
        <Border x:Name="PanelAvisoEnviado" Background="#4A1515" BorderBrush="#D13438" BorderThickness="1" Padding="15" Margin="0,0,0,15" Visibility="Collapsed" CornerRadius="4">
            <TextBlock Text="⚠️ ATENCIÓN: Esta acción ya consta como realizada anteriormente. ¿Deseas volver a procesar y enviar los archivos de nuevo?" Foreground="#FFB0B0" TextWrapping="Wrap" FontWeight="SemiBold"/>
        </Border>

        <TextBlock Text="Archivos que se van a procesar y enviar:" Foreground="#AAAAAA" Margin="0,0,0,10" Grid.Row="2"/>

        <ScrollViewer Grid.Row="2" Margin="0,25,0,15">
            <ItemsControl x:Name="ListaArchivos">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2D2D30" Padding="10" Margin="0,0,0,5" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NombreArchivo}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" FontWeight="Medium"/>
                                <ui:Button Grid.Column="1" Content="Ver archivo" Icon="{ui:SymbolIcon Eye24}" Click="BtnVerArchivo_Click" Tag="{Binding RutaLocal}" Cursor="Hand" Background="#3E3E42" BorderThickness="0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- CASILLA DE MARCADO MANUAL -->
        <CheckBox x:Name="ChkEnviado" Grid.Row="3" Content="Marcar esta tarea como completada (útil si enviaste manualmente)" 
                  Foreground="White" FontSize="14" Margin="0,0,0,20" Cursor="Hand" Click="ChkEnviado_Click"/>

        <!-- BOTONES INFERIORES -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancelar / Cerrar" Click="BtnCancelar_Click" Margin="0,0,10,0" Padding="20,8" Cursor="Hand"/>
            <ui:Button x:Name="BtnConfirmar" Content="Proceder al envío automático" Appearance="Primary" Click="BtnConfirmar_Click" Padding="20,8" Cursor="Hand" Icon="{ui:SymbolIcon Send24}"/>
        </StackPanel>
    </Grid>
</Window>