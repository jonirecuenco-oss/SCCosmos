<Page x:Class="SCCosmos.InicioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="InicioPage"
      Foreground="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Saludo y Cabecera -->
            <TextBlock x:Name="TxtSaludo" Grid.Row="0" Text="¡Hola!" FontSize="36" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Grid.Row="1" Text="Esto es lo que tienes programado para la semana actual:" FontSize="16" Foreground="#AAAAAA" Margin="0,0,0,30"/>

            <!-- Tarjeta de Resumen Semanal -->
            <ui:Card Grid.Row="2" VerticalAlignment="Top" Padding="30" Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" Margin="0,0,0,40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icono dinámico gigante -->
                    <ui:SymbolIcon x:Name="IconoActividad" Grid.Column="0" Symbol="Calendar24" FontSize="60" Foreground="#0078D4" Margin="0,0,30,0" VerticalAlignment="Center"/>

                    <!-- PANEL 1: DISEÑO PARA VISITAS -->
                    <StackPanel x:Name="PanelVisita" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="VISITA A CONGREGACIÓN" FontSize="12" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Congregacion}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <ui:SymbolIcon Symbol="CalendarClock24" Foreground="#AAAAAA" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FechaMartes, StringFormat='Del {0:dd MMM} al '}" Foreground="#AAAAAA" FontSize="14"/>
                            <TextBlock Text="{Binding FechaDomingo, StringFormat='{}{0:dd MMM yyyy}'}" Foreground="#AAAAAA" FontSize="14"/>
                        </StackPanel>

                        <!-- NUEVO: PROGRAMA DEL DÍA -->
                        <Border x:Name="PanelProgramaDia" Background="#1A000000" CornerRadius="8" Padding="15" Margin="0,5,0,0" HorizontalAlignment="Left" MinWidth="400" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="TU PROGRAMA DE HOY" FontSize="12" FontWeight="Bold" Foreground="#FFB900" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="ListaProgramaHoy">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Hora -->
                                                <TextBlock Grid.Column="0" Text="{Binding Hora}" FontWeight="SemiBold" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                                                <!-- Separador Visual -->
                                                <Border Grid.Column="1" Width="3" Background="#0078D4" Margin="0,0,15,0" CornerRadius="1"/>
                                                <!-- Actividad y Compañero -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TipoActividad}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CompaneroNombre, StringFormat='Con {0}'}" Foreground="#AAAAAA" FontSize="13" Visibility="{Binding VerCompanero}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PANEL 2: DISEÑO PARA OTRAS ACTIVIDADES -->
                    <StackPanel x:Name="PanelOtraActividad" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="ACTIVIDAD PROGRAMADA" FontSize="12" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Actividad}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CalendarClock24" Foreground="#AAAAAA" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FechaMartes, StringFormat='Semana del {0:dd de MMMM}'}" Foreground="#AAAAAA" FontSize="14"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Mensaje por si no hay ninguna semana marcada como actual -->
                    <TextBlock x:Name="TxtSinDatos" Grid.Column="1" Text="No se ha detectado ninguna actividad para la semana actual." 
                               Foreground="#AAAAAA" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed"/>

                    <!-- Botón de Acción (Solo visible si es visita) -->
                    <ui:Button x:Name="BtnVerVisita" Grid.Column="2" 
                               Content="Ver detalles de la visita" 
                               Appearance="Primary" 
                               Icon="{ui:SymbolIcon ArrowRight24}" 
                               Padding="20,12" 
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"
                               Click="BtnVerVisita_Click"/>
                </Grid>
            </ui:Card>

            <!-- Título Estadísticas -->
            <TextBlock Grid.Row="3" Text="Resumen del circuito" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>

            <!-- PANEL DE ESTADÍSTICAS (WrapPanel ajusta los cuadros automáticamente si la ventana se encoge) -->
            <WrapPanel Grid.Row="4" Margin="0,0,0,20">
                <WrapPanel.Resources>
                    <!-- Estilo común para todos los cuadritos de estadística -->
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1A1A1A"/>
                        <Setter Property="BorderBrush" Value="#333333"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Padding" Value="20,15"/>
                        <Setter Property="Margin" Value="0,0,15,15"/>
                        <Setter Property="Width" Value="160"/>
                    </Style>
                </WrapPanel.Resources>

                <!-- Cuadro 1: Precursores Regulares -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardPrecReg_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Person24" Foreground="#4BA3E3" Margin="0,0,8,0"/>
                            <TextBlock Text="P. Regulares" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalPrecReg" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 2: Precursores Especiales -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardPrecEsp_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Star24" Foreground="#FFB900" Margin="0,0,8,0"/>
                            <TextBlock Text="P. Especiales" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalPrecEsp" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 3: Ancianos -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardAncianos_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="People24" Foreground="#107C10" Margin="0,0,8,0"/>
                            <TextBlock Text="Ancianos" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalAncianos" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 4: Siervos Ministeriales -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardSiervos_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Person24" Foreground="#00B294" Margin="0,0,8,0"/>
                            <TextBlock Text="Siervos M." Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalSM" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 5: Solicitudes A-2 -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardA2_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Document24" Foreground="#E81123" Margin="0,0,8,0"/>
                            <TextBlock Text="Sol. A-2" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalA2" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <!-- Cuadro 6: Solicitudes A-19 -->
                <Border Cursor="Hand" MouseLeftButtonUp="CardA19_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Document24" Foreground="#E81123" Margin="0,0,8,0"/>
                            <TextBlock Text="Sol. A-19" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalA19" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Cursor="Hand" MouseLeftButtonUp="CardA8_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Document24" Foreground="#E81123" Margin="0,0,8,0"/>
                            <TextBlock Text="Sol. A-8" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalA8" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

                <Border Cursor="Hand" MouseLeftButtonUp="CardG8_Click" Background="Transparent">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:SymbolIcon Symbol="Document24" Foreground="#E81123" Margin="0,0,8,0"/>
                            <TextBlock Text="Sol. G-8" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtTotalG8" Text="-" FontSize="32" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>

            </WrapPanel>
        </Grid>
    </ScrollViewer>
</Page>