<ui:FluentWindow x:Class="SCCosmos.EnviarMensajeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Enviar Mensaje Múltiple" Height="700" Width="1050"
                 WindowStartupLocation="CenterOwner" WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">

    <Grid>
        <Grid Margin="25,45,25,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="NUEVO MENSAJE PARA EL CIRCUITO" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition Width="20"/>
                    <!-- Espaciador -->
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= IZQUIERDA: Email y Adjuntos ================= -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Asunto del correo:" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtAsunto" Padding="8" Background="#252528" Foreground="White" BorderBrush="#444" Margin="0,0,0,15" FontSize="14"/>

                    <TextBlock Text="Cuerpo del mensaje (acepta HTML):" Foreground="#AAAAAA" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtCuerpo" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" Padding="10" Background="#252528" Foreground="White" BorderBrush="#444" FontFamily="Consolas" Margin="0,0,0,20" FontSize="13"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Archivos Adjuntos:" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        <ui:Button Content="Añadir archivos" Icon="{ui:SymbolIcon Attach24}" Appearance="Secondary" HorizontalAlignment="Right" Click="BtnAdjuntar_Click" Cursor="Hand"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ArchivosAdjuntos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#333337" CornerRadius="4" Padding="10,6" Margin="0,0,0,5" BorderBrush="#444" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Document24" Foreground="#4BA3E3" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="#D13438" BorderThickness="0" Cursor="Hand" Click="BtnEliminarAdjunto_Click" Tag="{Binding}" FontWeight="Bold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ================= DERECHA: Lista de Congregaciones ================= -->
                <Border Grid.Column="2" Background="#252528" CornerRadius="8" Padding="15" BorderBrush="#3E3E42" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="DESTINATARIOS" FontWeight="SemiBold" Foreground="#4BA3E3" Margin="0,0,0,10"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                            <ui:Button Content="Marcar todas" Appearance="Secondary" Padding="10,4" Margin="0,0,10,0" Click="BtnSeleccionarTodas_Click" Cursor="Hand"/>
                            <ui:Button Content="Desmarcar todas" Appearance="Secondary" Padding="10,4" Click="BtnDeseleccionarTodas_Click" Cursor="Hand"/>
                        </StackPanel>

                        <ListView Grid.Row="2" ItemsSource="{Binding ListaCongregaciones}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <StackPanel Margin="0,0,0,15">
                                                            <Border Background="#333337" CornerRadius="4" Padding="8,5" Margin="0,0,0,5">
                                                                <CheckBox Content="{Binding Name}" FontWeight="Bold" Foreground="#4BA3E3" Checked="GrupoCheckBox_Checked" Unchecked="GrupoCheckBox_Checked" Cursor="Hand"/>
                                                            </Border>
                                                            <ItemsPresenter Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Nombre}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="#DDDDDD" Margin="0,3" Cursor="Hand"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= FOOTER ================= -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="Cancelar" Appearance="Secondary" Margin="0,0,10,0" Click="BtnCancelar_Click" Cursor="Hand"/>
                <ui:Button Content="Enviar Mensaje" Appearance="Primary" Icon="{ui:SymbolIcon Send24}" Click="BtnEnviar_Click" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- OVERLAY DE CARGA (Robot automatizando) -->
        <Grid x:Name="OverlayCargando" Background="#CC000000" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="El robot está trabajando en el navegador..." Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="250" Height="8" Foreground="#0078D4"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>