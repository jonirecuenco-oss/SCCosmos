<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SCCosmos.Mobile.Views.ConfiguracionPage"
    Title="Configuración"
    BackgroundColor="#101216">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <Label
                Text="Configuración"
                TextColor="White"
                FontSize="30"
                FontAttributes="Bold"/>

            <Label
                Text="Base de datos"
                TextColor="#4BA3E3"
                FontSize="18"
                FontAttributes="Bold"
                Margin="0,15,0,0"/>

            <Border
                BackgroundColor="#1A1D23"
                Stroke="#30343C"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Carpeta sincronizada"
                        TextColor="White"
                        FontSize="17"
                        FontAttributes="Bold"/>

                    <Label
                        Text="Selecciona la carpeta SCCosmos que ya tienes sincronizada en el teléfono."
                        TextColor="#A8ADB5"
                        FontSize="14"/>

                    <Label
                        x:Name="LblRuta"
                        Text="No se ha seleccionado ninguna carpeta."
                        TextColor="#CCCCCC"
                        FontSize="13"
                        LineBreakMode="WordWrap"/>

                    <Button
                        Text="Seleccionar carpeta"
                        Clicked="BtnSeleccionarCarpeta_Click"/>

                    <BoxView
                        HeightRequest="1"
                        Color="#30343C"
                        Margin="0,5"/>

                    <Label
                        Text="Estado"
                        TextColor="#A8ADB5"
                        FontSize="12"/>

                    <Label
                        x:Name="LblEstado"
                        Text="Pendiente de seleccionar carpeta."
                        TextColor="#FFB900"
                        FontSize="14"
                        FontAttributes="Bold"/>

                    <Button
                        Text="Comprobar base de datos"
                        Clicked="BtnComprobar_Click"/>

                    <BoxView
    HeightRequest="1"
    Color="#30343C"
    Margin="0,8"/>

                    <Label
    Text="Sincronización"
    TextColor="White"
    FontSize="17"
    FontAttributes="Bold"/>

                    <Button
    Text="↓ Actualizar desde carpeta"
    Clicked="BtnImportar_Click"/>

                    <Button
    Text="↑ Guardar cambios en carpeta"
    Clicked="BtnExportar_Click"/>

                    <Button
    Text="Probar base de datos local"
    Clicked="BtnProbarBase_Click"/>

                    <Label
    x:Name="LblResultadoDb"
    Text=""
    TextColor="#CCCCCC"
    FontSize="14"
    LineBreakMode="WordWrap"/>

                    <BoxView
    HeightRequest="1"
    Color="#30343C"
    Margin="0,12"/>

                    <Label
    Text="JW Hub"
    TextColor="White"
    FontSize="17"
    FontAttributes="Bold"/>

                    <Border
    BackgroundColor="#191D23"
    Stroke="#303640"
    Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="14">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout>

                                    <Label
    Text="Sesión"
    TextColor="White"
    FontAttributes="Bold"/>

                                    <Label
    x:Name="LblSesionJwHub"
    Text="Sin comprobar"
    TextColor="#9299A3"
    FontSize="13"/>

                                    <Button
    Text="Iniciar / renovar sesión JW Hub"
    BackgroundColor="#303740"
    TextColor="White"
    Clicked="BtnSesionJwHub_Click"/>

                                    <BoxView
    HeightRequest="1"
    Color="#30343C"
    Margin="0,5"/>

                                    <Label
                    Text="Sintonización automática"
                    TextColor="White"
                    FontAttributes="Bold"/>

                                    <Label
                    Text="Ejecutar diariamente aunque SCCosmos no esté abierto."
                    TextColor="#9299A3"
                    FontSize="12"/>

                                </VerticalStackLayout>

                                <Switch
                x:Name="SwJwHubAutomatico"
                Grid.Column="1"
                Toggled="SwJwHubAutomatico_Toggled"/>

                            </Grid>

                            <Grid
            ColumnDefinitions="*,Auto">

                                <Label
                Text="Hora"
                TextColor="#AAB0B9"
                VerticalOptions="Center"/>

                                <TimePicker
                x:Name="HoraJwHub"
                Grid.Column="1"
                Time="03:00:00"
                PropertyChanged="HoraJwHub_PropertyChanged"/>

                            </Grid>

                            <Label
            x:Name="LblEstadoJwHubAuto"
            Text=""
            TextColor="#9299A3"
            FontSize="12"/>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>