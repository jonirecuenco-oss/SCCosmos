<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.RscPersonasPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Añadir asistentes"
    BackgroundColor="#101216">

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        Padding="20,16,20,16"
        RowSpacing="10">

        <Entry
            x:Name="TxtBuscar"
            Placeholder="Buscar por nombre…"
            Style="{StaticResource Campo}"
            TextChanged="TxtBuscar_TextChanged" />

        <VerticalStackLayout
            x:Name="PanelPinned"
            Grid.Row="1"
            Spacing="6" />

        <ScrollView
            Grid.Row="2">

            <VerticalStackLayout
                x:Name="ListaPersonas"
                Spacing="6" />

        </ScrollView>

        <Button
            Grid.Row="3"
            Text="Añadir seleccionadas"
            Clicked="BtnAnadir_Clicked"
            Style="{StaticResource BotonPrincipal}" />

    </Grid>

</ContentPage>
