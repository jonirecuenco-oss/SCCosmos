<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="SCCosmos.Mobile.Views.JwHubSyncConflictPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Resolver conflicto"
    BackgroundColor="#101216">

    <Grid
        Padding="16"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        RowSpacing="14">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="4">

            <Label
                Text="Resolver conflicto"
                FontSize="25"
                FontAttributes="Bold"
                TextColor="White"/>

            <!-- FOTOGRAFÍA DE LA PERSONA (una sola vez, arriba) -->
            <Grid
                ColumnDefinitions="62,*"
                ColumnSpacing="12"
                Margin="0,6,0,4">

                <Border
                    Grid.Column="0"
                    WidthRequest="58"
                    HeightRequest="58"
                    BackgroundColor="#272D36"
                    StrokeThickness="0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="29"/>
                    </Border.StrokeShape>

                    <Grid>

                        <Label
                            x:Name="LblSinFotoPersona"
                            Text="👤"
                            FontSize="24"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"/>

                        <Image
                            x:Name="ImgFotoPersona"
                            IsVisible="False"
                            Aspect="AspectFill"
                            WidthRequest="58"
                            HeightRequest="58"/>

                    </Grid>

                </Border>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        x:Name="LblNombre"
                        Text=""
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#FFCC55"/>

                    <Label
                        Text="Selecciona qué valor quieres conservar en cada campo."
                        FontSize="13"
                        TextColor="#A5ABB4"
                        LineBreakMode="WordWrap"/>

                </VerticalStackLayout>

            </Grid>

        </VerticalStackLayout>

        <!-- ================================================= -->
        <!-- FOTOGRAFÍA: BD vs JW HUB (solo si cambió) -->
        <!-- ================================================= -->

        <VerticalStackLayout
            x:Name="PanelFoto"
            Grid.Row="1"
            IsVisible="False"
            Spacing="8">

            <Label
                Text="Fotografía"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"/>

            <Label
                Text="La fotografía de JW Hub es distinta de la que hay en la base de datos. Toca la que quieras conservar."
                FontSize="13"
                TextColor="#A5ABB4"
                LineBreakMode="WordWrap"/>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Border
                    x:Name="FotoBdBorder"
                    Grid.Column="0"
                    Padding="10"
                    BackgroundColor="#141D25"
                    Stroke="#2D526B"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="FotoBd_Tapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="BASE DE DATOS"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#78BCE8"
                            HorizontalTextAlignment="Center"/>

                        <Image
                            x:Name="ImgFotoBd"
                            HeightRequest="110"
                            Aspect="AspectFill"/>

                        <Label
                            x:Name="LblMarcaFotoBd"
                            Text=" "
                            FontSize="16"
                            TextColor="#78BCE8"
                            HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </Border>

                <Border
                    x:Name="FotoHubBorder"
                    Grid.Column="1"
                    Padding="10"
                    BackgroundColor="#15251A"
                    Stroke="#315E3B"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="FotoHub_Tapped"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout
                        Spacing="6">

                        <Label
                            Text="JW HUB"
                            FontSize="10"
                            FontAttributes="Bold"
                            TextColor="#73D18A"
                            HorizontalTextAlignment="Center"/>

                        <Image
                            x:Name="ImgFotoHub"
                            HeightRequest="110"
                            Aspect="AspectFill"/>

                        <Label
                            x:Name="LblMarcaFotoHub"
                            Text=" "
                            FontSize="16"
                            TextColor="#73D18A"
                            HorizontalTextAlignment="Center"/>

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </VerticalStackLayout>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            ColumnSpacing="8">

            <Border
                Grid.Column="0"
                Padding="10,7"
                BackgroundColor="#1A2733"
                Stroke="#386587"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>

                <Label
                    Text="BASE DE DATOS"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#85C5F0"
                    HorizontalTextAlignment="Center"/>

            </Border>

            <Border
                Grid.Column="1"
                Padding="10,7"
                BackgroundColor="#19301F"
                Stroke="#377849"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>

                <Label
                    Text="JW HUB"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#7DDB96"
                    HorizontalTextAlignment="Center"/>

            </Border>

        </Grid>

        <CollectionView
            x:Name="ListaCampos"
            Grid.Row="3"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="30"
                    Spacing="8">

                    <Label
                        Text="✓"
                        FontSize="34"
                        TextColor="#6ABF7B"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Ya no se detectan campos en conflicto."
                        TextColor="#AAAAAA"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,12"
                        Padding="13"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="#343B45"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="13"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout
                            Spacing="10">

                            <Label
                                Text="{Binding Nombre}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="White"/>

                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8">

                                <Border
                                    Grid.Column="0"
                                    Padding="10"
                                    BackgroundColor="#141D25"
                                    Stroke="#2D526B"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>

                                    <VerticalStackLayout
                                        Spacing="7">

                                        <Label
                                            Text="BD"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#78BCE8"/>

                                        <Label
                                            IsVisible="{Binding EsTexto}"
                                            Text="{Binding ValorBdVisual}"
                                            FontSize="13"
                                            TextColor="White"
                                            LineBreakMode="WordWrap"/>

                                    </VerticalStackLayout>

                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Padding="10"
                                    BackgroundColor="#15251A"
                                    Stroke="#315E3B"
                                    StrokeThickness="1">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>

                                    <VerticalStackLayout
                                        Spacing="7">

                                        <Label
                                            Text="JW HUB"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="#73D18A"/>

                                        <Label
                                            IsVisible="{Binding EsTexto}"
                                            Text="{Binding ValorHubVisual}"
                                            FontSize="13"
                                            TextColor="White"
                                            LineBreakMode="WordWrap"/>

                                    </VerticalStackLayout>

                                </Border>

                            </Grid>

                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="10">

                                <Label
                                    Grid.Column="0"
                                    Text="Conservar:"
                                    TextColor="#A5ABB4"
                                    FontSize="13"
                                    VerticalOptions="Center"/>

                                <Picker
                                    Grid.Column="1"
                                    ItemsSource="{Binding Opciones}"
                                    SelectedItem="{Binding Seleccion, Mode=TwoWay}"
                                    TextColor="White"
                                    BackgroundColor="#252B33"
                                    Title="Selecciona un valor"
                                    TitleColor="#A5ABB4"
                                    HorizontalOptions="Fill"/>

                            </Grid>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

        <Grid
            Grid.Row="4"
            ColumnDefinitions="*,*"
            ColumnSpacing="10">

            <Button
                Grid.Column="0"
                Text="Cancelar"
                HeightRequest="48"
                BackgroundColor="#353A42"
                TextColor="White"
                CornerRadius="9"
                Clicked="BtnCancelar_Clicked"/>

            <Button
                x:Name="BtnGuardar"
                Grid.Column="1"
                Text="Guardar resolución"
                HeightRequest="48"
                BackgroundColor="#2478B5"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="9"
                Clicked="BtnGuardar_Clicked"/>

        </Grid>

    </Grid>

</ContentPage>
