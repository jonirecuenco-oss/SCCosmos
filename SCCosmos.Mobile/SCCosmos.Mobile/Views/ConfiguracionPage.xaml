<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SCCosmos.Mobile.Views.ConfiguracionPage"
    Title="Configuración"
    BackgroundColor="{StaticResource FondoPagina}">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <Label
                Text="Configuración"
                TextColor="{StaticResource TextoPrincipal}"
                FontSize="26"
                FontAttributes="Bold"/>

            <Label
                Text="Datos del superintendente y circuito"
                TextColor="{StaticResource Acento}"
                FontSize="18"
                FontAttributes="Bold"
                Margin="0,10,0,0"/>

            <Border
                BackgroundColor="{StaticResource Superficie}"
                Stroke="{StaticResource Borde}"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <VerticalStackLayout x:Name="PanelDatosSC"
                                         Spacing="10">

                        <Label Text="Nombre del SC"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12"/>
                        <Entry x:Name="TxtNombreSC" TextColor="{StaticResource TextoPrincipal}"/>

                        <Label Text="Apellidos del SC"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12"/>
                        <Entry x:Name="TxtApellidoSC" TextColor="{StaticResource TextoPrincipal}"/>

                    </VerticalStackLayout>

                    <Label Text="Nombre de la esposa"
                           TextColor="{StaticResource TextoTerciario}"
                           FontSize="12"/>
                    <Entry x:Name="TxtNombreEsposaSC" TextColor="{StaticResource TextoPrincipal}"/>

                    <Label Text="Apellidos de la esposa"
                           TextColor="{StaticResource TextoTerciario}"
                           FontSize="12"/>
                    <Entry x:Name="TxtApellidoEsposaSC" TextColor="{StaticResource TextoPrincipal}"/>

                    <!-- Para el requisito de horas de la esposa (40 h al mes desde los 40 años) -->
                    <Label Text="Fecha de nacimiento de la esposa (opcional)"
                           TextColor="{StaticResource TextoTerciario}"
                           FontSize="12"/>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <DatePicker x:Name="FechaNacimientoEsposa"
                                    Format="dd/MM/yyyy"
                                    TextColor="{StaticResource TextoPrincipal}"/>
                        <Button Grid.Column="1"
                                Text="Quitar"
                                FontSize="12"
                                HeightRequest="36"
                                Padding="12,0"
                                CornerRadius="8"
                                BackgroundColor="{StaticResource SuperficieAlta}"
                                TextColor="{StaticResource TextoPrincipal}"
                                VerticalOptions="Center"
                                Clicked="BtnQuitarNacimiento_Clicked"/>
                    </Grid>
                    <Label Text="Para su requisito de horas: 50 h al mes; 40 h desde los 40 años."
                           TextColor="{StaticResource TextoTerciario}"
                           FontSize="11"/>

                    <VerticalStackLayout x:Name="PanelDatosSCFinal"
                                         Spacing="10">

                        <Label Text="Número de circuito"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12"/>
                        <Entry x:Name="TxtNumCircuito" TextColor="{StaticResource TextoPrincipal}"/>

                        <Label Text="Carpeta del Archivo del circuito (subcarpeta de la carpeta sincronizada; vacío = misma carpeta)"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12"/>
                        <Entry x:Name="TxtRutaArchivoCircuito"
                               Placeholder="p. ej. ArchivoCircuito"
                               TextColor="{StaticResource TextoPrincipal}"/>

                    </VerticalStackLayout>

                    <Label x:Name="LblResultadoGlobal"
                           Text=""
                           TextColor="{StaticResource TextoSecundario}"
                           FontSize="13"/>

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Perfil de usuario"
                TextColor="{StaticResource Acento}"
                FontSize="18"
                FontAttributes="Bold"
                Margin="0,15,0,0"/>

            <Border
                BackgroundColor="{StaticResource Superficie}"
                Stroke="{StaticResource Borde}"
                StrokeThickness="1"
                Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label Text="¿Quién usa este dispositivo?"
                           TextColor="{StaticResource TextoTerciario}"
                           FontSize="12"/>
                    <Picker x:Name="PickerPerfil"
                            TextColor="{StaticResource TextoPrincipal}"
                            SelectedIndexChanged="PickerPerfil_SelectedIndexChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Hombre</x:String>
                                <x:String>Esposa</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <VerticalStackLayout x:Name="PanelCodigoPerfil"
                                         IsVisible="False"
                                         Spacing="6">
                        <Label Text="Código de acceso (solo si es él)"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12"/>
                        <Entry x:Name="TxtCodigoPerfil"
                               IsPassword="True"
                               TextColor="{StaticResource TextoPrincipal}"/>
                    </VerticalStackLayout>

                    <Button Text="Guardar perfil"
                            Clicked="BtnGuardarPerfil_Click"
                            BackgroundColor="{StaticResource AcentoFuerte}"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontAttributes="Bold"
                            CornerRadius="9"
                            Margin="0,4,0,0"/>

                    <Label x:Name="LblPerfilEstado"
                           Text=""
                           TextColor="{StaticResource TextoSecundario}"
                           FontSize="13"/>
                </VerticalStackLayout>
            </Border>

            <Border
                BackgroundColor="{StaticResource Superficie}"
                Stroke="{StaticResource Borde}"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
    x:Name="TituloJwHub"
    Text="JW Hub"
    TextColor="{StaticResource TextoPrincipal}"
    FontSize="17"
    FontAttributes="Bold"/>

                    <Border
    x:Name="PanelJwHub"
    BackgroundColor="{StaticResource Superficie}"
    Stroke="{StaticResource Borde}"
    Padding="16">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="14">

                            <Grid ColumnDefinitions="*,Auto">

                                <VerticalStackLayout>

                                    <Label
    Text="Sesión"
    TextColor="{StaticResource TextoPrincipal}"
    FontAttributes="Bold"/>

                                    <Label
    x:Name="LblSesionJwHub"
    Text="Sin comprobar"
    TextColor="{StaticResource TextoTerciario}"
    FontSize="13"/>

                                    <Button
    Text="Iniciar / renovar sesión JW Hub"
    BackgroundColor="#303740"
    TextColor="{StaticResource TextoPrincipal}"
    Clicked="BtnSesionJwHub_Click"/>

                                    <BoxView
    HeightRequest="1"
    Color="{StaticResource BordeSuave}"
    Margin="0,5"/>

                                    <Label
                    Text="Sintonización automática"
                    TextColor="{StaticResource TextoPrincipal}"
                    FontAttributes="Bold"/>

                                    <Label
                    Text="Ejecutar diariamente aunque SCCosmos no esté abierto."
                    TextColor="{StaticResource TextoTerciario}"
                    FontSize="12"/>

                                </VerticalStackLayout>

                                <Switch
                x:Name="SwJwHubAutomatico"
                Grid.Column="1"
                Toggled="SwJwHubAutomatico_Toggled"/>

                            </Grid>

                            <Grid
            ColumnDefinitions="*,Auto">

                                <Label
                Text="Hora"
                TextColor="{StaticResource TextoSecundario}"
                VerticalOptions="Center"/>

                                <TimePicker
                x:Name="HoraJwHub"
                Grid.Column="1"
                Time="03:00:00"
                PropertyChanged="HoraJwHub_PropertyChanged"/>

                            </Grid>

                            <Label
            x:Name="LblEstadoJwHubAuto"
            Text=""
            TextColor="{StaticResource TextoTerciario}"
            FontSize="12"/>

                        </VerticalStackLayout>

                    </Border>

                </VerticalStackLayout>

            </Border>

            <!-- SINCRONIZACIÓN ENTRE DISPOSITIVOS -->
            <Label
                Text="Sincronización entre dispositivos"
                TextColor="{StaticResource Acento}"
                FontSize="18"
                FontAttributes="Bold"
                Margin="0,15,0,0"/>

            <Border
                x:Name="CardSincroMobile"
                BackgroundColor="{StaticResource Superficie}"
                Stroke="{StaticResource Borde}"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Los cambios viajan solos entre tus dispositivos: en casa por wifi (al instante) y fuera de casa por la carpeta sincronizada que ya usas. Solo comparte la misma clave en todos."
                        TextColor="{StaticResource TextoSecundario}"
                        FontSize="14"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Activada"
                            TextColor="{StaticResource TextoPrincipal}"
                            VerticalOptions="Center"/>
                        <Switch
                            x:Name="SwSincroActivo"
                            Grid.Column="1"/>
                    </Grid>

                    <Label
                        Text="Nombre de este móvil"
                        TextColor="#CCCCCC"
                        FontSize="13"/>
                    <Entry
                        x:Name="TxtNombreSincro"
                        TextColor="{StaticResource TextoPrincipal}"/>

                    <Label
                        Text="Clave de sincronización"
                        TextColor="#CCCCCC"
                        FontSize="13"/>
                    <Entry
                        x:Name="TxtClaveSincro"
                        TextColor="{StaticResource TextoPrincipal}"
                        Keyboard="Numeric"/>

                    <Label
                        Text="Dirección por internet del otro dispositivo (Tailscale o IP:puerto; una por línea o separadas por comas)"
                        TextColor="#CCCCCC"
                        FontSize="13"/>
                    <Editor
                        x:Name="TxtDireccionesSincro"
                        TextColor="{StaticResource TextoPrincipal}"
                        Placeholder="ej.: mi-pc.tailxxxx.ts.net"
                        PlaceholderColor="{StaticResource TextoTerciario}"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="44"/>

                    <Label
                        Text="Dispositivos (desmarca los que no quieras sincronizar con este móvil)"
                        TextColor="#CCCCCC"
                        FontSize="13"/>
                    <VerticalStackLayout
                        x:Name="ListaDispositivosSincro"
                        Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="6"
                                    Padding="0,2">
                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{Binding Habilitado, Mode=OneWay}"
                                        CheckedChanged="ChkDispositivo_Changed"
                                        Color="#FFB900"
                                        VerticalOptions="Center"/>
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="0"
                                        VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Nombre}"
                                            TextColor="{StaticResource TextoPrincipal}"
                                            FontSize="14"/>
                                        <Label
                                            Text="{Binding Detalle}"
                                            TextColor="{StaticResource TextoSecundario}"
                                            FontSize="11"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label
                        x:Name="LblEstadoSincro"
                        Text=""
                        TextColor="#FFB900"
                        FontSize="13"
                        LineBreakMode="WordWrap"/>

                    <Label
                        x:Name="LblDatosLocales"
                        Text=""
                        TextColor="{StaticResource TextoSecundario}"
                        FontSize="12"
                        LineBreakMode="WordWrap"/>

                    <Button
                        x:Name="BtnRepararSincro"
                        Text="Re-sincronizar todo (reparar datos)"
                        Clicked="BtnRepararSincro_Click"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        TextColor="{StaticResource TextoPrincipal}"
                        CornerRadius="9"
                        Padding="10,7"/>

                </VerticalStackLayout>
            </Border>

            <!-- TIEMPO DE VIAJE -->

            <Border
                BackgroundColor="{StaticResource Superficie}"
                Stroke="{StaticResource Borde}"
                StrokeThickness="1"
                Padding="14">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Tiempo de viaje (en coche)"
                        TextColor="{StaticResource TextoPrincipal}"
                        FontAttributes="Bold"
                        FontSize="15"/>

                    <Label
                        Text="Inicio y el widget muestran cuánto se tarda en coche hasta cada evento, con tu ubicación actual. Necesita una clave de TomTom (plan gratuito, recomendada) o de Google Maps: si hay clave de TomTom se usa TomTom; si solo hay de Google, se usa Google. Sin ninguna clave no se muestra el tiempo ni se pide la ubicación."
                        TextColor="{StaticResource TextoSecundario}"
                        FontSize="12.5"
                        LineBreakMode="WordWrap"/>

                    <Entry
                        x:Name="TxtTomTomKey"
                        Placeholder="Clave de TomTom (plan gratuito)"
                        TextColor="{StaticResource TextoPrincipal}"
                        PlaceholderColor="{StaticResource TextoTerciario}"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        Unfocused="TxtTomTomKey_Unfocused"/>

                    <Entry
                        x:Name="TxtGmapsKey"
                        Placeholder="Clave de Google Maps (opcional)"
                        TextColor="{StaticResource TextoPrincipal}"
                        PlaceholderColor="{StaticResource TextoTerciario}"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        Unfocused="TxtGmapsKey_Unfocused"/>

                    <Label
                        x:Name="LblGmapsGuardada"
                        Text=""
                        TextColor="#7BC87B"
                        FontSize="12"/>

                </VerticalStackLayout>
            </Border>

            <!-- VERSIÓN Y ACTUALIZACIONES -->

            <Border
                BackgroundColor="{StaticResource Superficie}"
                Stroke="{StaticResource Borde}"
                StrokeThickness="1"
                Padding="14">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Versión y actualizaciones"
                        TextColor="{StaticResource TextoPrincipal}"
                        FontAttributes="Bold"
                        FontSize="15"/>

                    <Label
                        x:Name="LblVersionApp"
                        Text="Versión instalada: 1.0.0"
                        TextColor="{StaticResource TextoSecundario}"
                        FontSize="12.5"/>

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">

                        <Label
                            Text="Actualizar automáticamente"
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="13"
                            VerticalTextAlignment="Center"/>

                        <Switch
                            x:Name="SwitchActualizarAuto"
                            Grid.Column="1"
                            Toggled="SwitchActualizarAuto_Toggled"/>

                    </Grid>

                    <Button
                        x:Name="BtnBuscarActualizacion"
                        Text="Buscar actualizaciones"
                        Clicked="BtnBuscarActualizacion_Clicked"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        TextColor="{StaticResource TextoPrincipal}"
                        CornerRadius="9"
                        Padding="10,7"/>

                    <Label
                        x:Name="LblEstadoActualizacion"
                        Text=""
                        TextColor="{StaticResource TextoSecundario}"
                        FontSize="12"
                        LineBreakMode="WordWrap"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>