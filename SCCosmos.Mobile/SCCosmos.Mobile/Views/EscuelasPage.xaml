<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.EscuelasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Escuelas"
    BackgroundColor="#101216">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16,14,16,14"
          RowSpacing="10">

        <Label Grid.Row="0"
               Text="ESCUELAS"
               Style="{StaticResource Antetitulo}" />

        <!-- Pestañas -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="8">

            <Button x:Name="BtnTabEstudiantes"
                    Grid.Column="0"
                    Text="Estudiantes"
                    Clicked="BtnTabEstudiantes_Clicked"
                    Style="{StaticResource BotonPrincipal}"
                    HeightRequest="42"
                    Padding="10,4"
                    FontSize="14" />

            <Button x:Name="BtnTabClases"
                    Grid.Column="1"
                    Text="Clases"
                    Clicked="BtnTabClases_Clicked"
                    Style="{StaticResource BotonSecundario}"
                    HeightRequest="42"
                    Padding="10,4"
                    FontSize="14" />

        </Grid>

        <!-- ==================== ESTUDIANTES ==================== -->

        <Grid x:Name="PanelEstudiantes"
              Grid.Row="2"
              RowDefinitions="Auto,*"
              RowSpacing="8">

            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                <Label x:Name="LblTotal"
                       Grid.Column="0"
                       Text=""
                       Style="{StaticResource SubtituloPagina}"
                       VerticalOptions="Center" />

                <Button x:Name="BtnVerDescartados"
                        Grid.Column="1"
                        Text="Ver descartados"
                        Clicked="BtnVerDescartados_Clicked"
                        Style="{StaticResource BotonSecundario}"
                        HeightRequest="40"
                        Padding="12,6"
                        FontSize="12"
                        VerticalOptions="Start" />

            </Grid>

            <RefreshView x:Name="Refrescar"
                         Grid.Row="1"
                         Refreshing="Refrescar_Refreshing">

                <CollectionView x:Name="Lista"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20,50"
                                             HorizontalOptions="Center"
                                             Spacing="8">
                            <Label Text="No hay candidatos para este año de servicio."
                                   TextColor="#9EA4AE"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource Superficie}"
                                    Stroke="{StaticResource Borde}"
                                    StrokeThickness="1"
                                    Padding="13"
                                    Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="3">
                                        <Label Text="{Binding NombreComun}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                        <Label Text="{Binding Detalle}"
                                               FontSize="12"
                                               TextColor="#AEB4BC" />
                                        <Label Text="{Binding Email}"
                                               FontSize="12"
                                               TextColor="#7E858F" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="{Binding TextoAccion}"
                                            Clicked="BtnAccion_Clicked"
                                            CommandParameter="{Binding .}"
                                            Padding="12,6"
                                            FontSize="12"
                                            BackgroundColor="#163553"
                                            TextColor="#B9DEFF"
                                            CornerRadius="8"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

        </Grid>

        <!-- ==================== CLASES ==================== -->

        <Grid x:Name="PanelClases"
              Grid.Row="2"
              RowDefinitions="Auto,*"
              RowSpacing="8"
              IsVisible="False">

            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                <Label x:Name="LblResumenClases"
                       Grid.Column="0"
                       Text=""
                       Style="{StaticResource SubtituloPagina}"
                       VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="＋ Nueva"
                        Clicked="BtnNuevaEscuela_Clicked"
                        Style="{StaticResource BotonPrincipal}"
                        HeightRequest="40"
                        Padding="14,6"
                        FontSize="13"
                        VerticalOptions="Start" />

            </Grid>

            <RefreshView x:Name="RefrescarClases"
                         Grid.Row="1"
                         Refreshing="RefrescarClases_Refreshing">

                <CollectionView x:Name="ListaClases"
                                SelectionMode="None">

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20,50"
                                             HorizontalOptions="Center"
                                             Spacing="8">
                            <Label Text="Todavía no hay clases creadas. Pulsa «＋ Nueva» para crear la primera."
                                   TextColor="#9EA4AE"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource Superficie}"
                                    Stroke="{StaticResource Borde}"
                                    StrokeThickness="1"
                                    Padding="14"
                                    Margin="0,0,0,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TarjetaClase_Tapped" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0"
                                                         Spacing="3">
                                        <Label Text="{Binding SemanaTexto}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                        <Label Text="{Binding Detalle}"
                                               FontSize="12.5"
                                               TextColor="#4BA3E3" />
                                        <Label Text="{Binding NotasTexto}"
                                               FontSize="12"
                                               TextColor="#8B94A0" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="›"
                                           FontSize="24"
                                           TextColor="#888888"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </RefreshView>

        </Grid>

    </Grid>
</ContentPage>
