<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.TareaEdicionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Tarea"
    BackgroundColor="{StaticResource FondoPagina}">

    <Grid RowDefinitions="*,Auto"
          Padding="16,14,16,14"
          RowSpacing="10">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="14">

                <Label x:Name="LblCabecera"
                       Text="NUEVA TAREA"
                       Style="{StaticResource Antetitulo}" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Título"
                           Style="{StaticResource TextoNota}" />
                    <Entry x:Name="TxtTitulo"
                           Placeholder="Título de la tarea o evento"
                           PlaceholderColor="{StaticResource TextoTerciario}"
                           TextColor="{StaticResource TextoPrincipal}"
                           BackgroundColor="{StaticResource Superficie}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Categoría"
                           Style="{StaticResource TextoNota}" />
                    <Picker x:Name="PckCategoria"
                            TextColor="{StaticResource TextoPrincipal}"
                            BackgroundColor="{StaticResource Superficie}">
                        <Picker.Items>
                            <x:String>Personal</x:String>
                            <x:String>Calendario</x:String>
                            <x:String>Asambleas</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Descripción"
                           Style="{StaticResource TextoNota}" />
                    <Editor x:Name="TxtDescripcion"
                            Placeholder="Detalles (opcional)"
                            PlaceholderColor="{StaticResource TextoTerciario}"
                            AutoSize="TextChanges"
                            HeightRequest="90"
                            TextColor="{StaticResource TextoPrincipal}"
                            BackgroundColor="{StaticResource Superficie}" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Fecha"
                               Style="{StaticResource TextoNota}" />
                        <DatePicker x:Name="PckFecha"
                                    TextColor="{StaticResource TextoPrincipal}"
                                    BackgroundColor="{StaticResource Superficie}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1"
                                         Spacing="4">
                        <Label Text="Todo el día"
                               Style="{StaticResource TextoNota}"
                               HorizontalTextAlignment="Center" />
                        <Switch x:Name="SwTodoElDia"
                                IsToggled="True"
                                OnColor="#0B6FC2"
                                Toggled="SwTodoElDia_Toggled"
                                VerticalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout x:Name="PanelHora"
                                     Spacing="4"
                                     IsVisible="False">
                    <Label Text="Hora"
                           Style="{StaticResource TextoNota}" />
                    <TimePicker x:Name="PckHora"
                                TextColor="{StaticResource TextoPrincipal}"
                                BackgroundColor="{StaticResource Superficie}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PanelRango"
                                     Spacing="4"
                                     IsVisible="False">
                    <Label Text="Hasta (fin del rango)"
                           Style="{StaticResource TextoNota}" />
                    <DatePicker x:Name="PckFechaFin"
                                TextColor="{StaticResource TextoPrincipal}"
                                BackgroundColor="{StaticResource Superficie}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Switch x:Name="SwRango"
                            OnColor="#0B6FC2"
                            Toggled="SwRango_Toggled"
                            VerticalOptions="Center" />
                    <Label Text="Es un rango de varios días"
                           TextColor="{StaticResource TextoPrincipal}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Aviso"
                           Style="{StaticResource TextoNota}" />
                    <Picker x:Name="PckAviso"
                            TextColor="{StaticResource TextoPrincipal}"
                            BackgroundColor="{StaticResource Superficie}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Repetición"
                           Style="{StaticResource TextoNota}" />
                    <Picker x:Name="PckRepeticion"
                            TextColor="{StaticResource TextoPrincipal}"
                            BackgroundColor="{StaticResource Superficie}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="10">
                    <Switch x:Name="SwCompartir"
                            OnColor="#0B6FC2"
                            VerticalOptions="Center" />
                    <Label x:Name="LblCompartir"
                           Text="Compartir con mi esposa"
                           TextColor="{StaticResource TextoPrincipal}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Text="El aviso aparecerá en la campana y como notificación de la app."
                       Style="{StaticResource TextoNota}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="10">

            <Button x:Name="BtnEliminar"
                    Text="🗑️ Eliminar"
                    IsVisible="False"
                    Clicked="BtnEliminar_Clicked"
                    BackgroundColor="{StaticResource PeligroSuave}"
                    TextColor="#FFB7BC"
                    CornerRadius="9"
                    HeightRequest="46" />

            <Button Grid.Column="2"
                    Text="Guardar"
                    Clicked="BtnGuardar_Clicked"
                    BackgroundColor="#0B6FC2"
                    TextColor="{StaticResource TextoPrincipal}"
                    CornerRadius="9"
                    HeightRequest="46"
                    Padding="22,0" />
        </Grid>
    </Grid>
</ContentPage>
