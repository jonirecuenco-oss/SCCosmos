<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.NombramientosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nombramientos"
    BackgroundColor="{StaticResource FondoPagina}">

    <Grid RowDefinitions="Auto,*"
          Padding="16,14,16,14"
          RowSpacing="10">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="3">
            <Label x:Name="LblTitulo"
                   Text="RECOMENDACIONES DE NOMBRAMIENTOS"
                   Style="{StaticResource Antetitulo}" />
            <Label Text="Puedes aprobar o cancelar cada recomendación en JW Hub (requiere haber iniciado sesión en JW Hub en el dispositivo)."
                   FontSize="12"
                   TextColor="{StaticResource TextoSecundario}" />
        </VerticalStackLayout>

        <RefreshView x:Name="Refrescar"
                     Grid.Row="1"
                     Refreshing="Refrescar_Refreshing">

            <CollectionView x:Name="Lista"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,50"
                                         HorizontalOptions="Center"
                                         Spacing="8">
                        <Label Text="No hay recomendaciones pendientes."
                               TextColor="{StaticResource TextoSecundario}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource Superficie}"
                                Stroke="{StaticResource Borde}"
                                StrokeThickness="1"
                                Padding="13"
                                Margin="0,0,0,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Hermano}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextoPrincipal}" />
                                    <Label Text="{Binding Resumen}"
                                           FontSize="13"
                                           TextColor="{StaticResource TextoSecundario}" />
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Text="Aprobar en Hub"
                                            IsEnabled="{Binding EsProcesable}"
                                            Clicked="BtnAprobar_Clicked"
                                            CommandParameter="{Binding .}"
                                            Padding="10,6"
                                            FontSize="12"
                                            BackgroundColor="{StaticResource ExitoSuave}"
                                            TextColor="{StaticResource TextoPrincipal}"
                                            CornerRadius="8" />
                                    <Button Grid.Column="1"
                                            Text="Cancelar en Hub"
                                            IsEnabled="{Binding EsProcesable}"
                                            Clicked="BtnCancelar_Clicked"
                                            CommandParameter="{Binding .}"
                                            Padding="10,6"
                                            FontSize="12"
                                            BackgroundColor="{StaticResource PeligroSuave}"
                                            TextColor="#FFB7BC"
                                            CornerRadius="8" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
