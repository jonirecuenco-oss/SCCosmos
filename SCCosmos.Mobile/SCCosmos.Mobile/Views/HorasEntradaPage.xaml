<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SCCosmos.Mobile.Views.HorasEntradaPage"
             Title="Predicación este mes"
             BackgroundColor="#101216">

    <VerticalStackLayout Padding="24"
                         Spacing="14">

        <Label Text="Predicación este mes"
               TextColor="White"
               FontSize="17"
               FontAttributes="Bold"/>

        <Label x:Name="LblMesHoras"
               Text=""
               TextColor="#8A929C"
               FontSize="13"/>

        <Label Text="Horas a añadir (ej.: 2,5; deja 0 si ninguna)"
               TextColor="#CCCCCC"
               FontSize="13"/>
        <Entry x:Name="TxtHoras"
               Keyboard="Numeric"
               Placeholder="0"
               PlaceholderColor="#7E858F"
               TextColor="White"
               FontSize="20"/>

        <Label Text="Cursos bíblicos a añadir (deja 0 si ninguno)"
               TextColor="#CCCCCC"
               FontSize="13"/>
        <Entry x:Name="TxtCbs"
               Keyboard="Numeric"
               Placeholder="0"
               PlaceholderColor="#7E858F"
               TextColor="White"
               FontSize="20"/>

        <HorizontalStackLayout Spacing="12">
            <Button Text="Cancelar"
                    Clicked="BtnCancelar_Clicked"
                    BackgroundColor="#242830"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="18,8"/>
            <Button Text="Añadir"
                    Clicked="BtnAnadir_Clicked"
                    BackgroundColor="#0B6FC2"
                    TextColor="White"
                    CornerRadius="10"
                    Padding="18,8"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>
