<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.MensajeCircuitoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nuevo mensaje"
    BackgroundColor="{StaticResource FondoPagina}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,28"
                             Spacing="14">

            <VerticalStackLayout Spacing="3">
                <Label Text="NUEVO MENSAJE AL CIRCUITO"
                       Style="{StaticResource Antetitulo}" />
                <Label Text="Se abre Gmail con el correo preparado para las congregaciones que marques; lo envías tú desde allí."
                       Style="{StaticResource SubtituloPagina}" />
            </VerticalStackLayout>

            <!-- MENSAJE -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Asunto"
                           TextColor="{StaticResource TextoTerciario}"
                           FontSize="12" />
                    <Entry x:Name="TxtAsunto"
                           Placeholder="Asunto del correo"
                           PlaceholderColor="{StaticResource TextoTerciario}"
                           TextColor="{StaticResource TextoPrincipal}" />

                    <Label Text="Mensaje"
                           TextColor="{StaticResource TextoTerciario}"
                           FontSize="12" />
                    <Editor x:Name="TxtCuerpo"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="150"
                            Placeholder="Escribe el mensaje (en Gmail podrás retocarlo)"
                            PlaceholderColor="{StaticResource TextoTerciario}"
                            TextColor="{StaticResource TextoPrincipal}" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Adjuntos"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Añadir"
                                Style="{StaticResource BotonSecundario}"
                                HeightRequest="38"
                                Clicked="BtnAdjuntar_Clicked" />
                    </Grid>

                    <VerticalStackLayout x:Name="ListaAdjuntos"
                                         Spacing="6" />
                </VerticalStackLayout>
            </Border>

            <!-- DESTINATARIOS: por secciones, como en Windows -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="6">
                        <Label Text="DESTINATARIOS"
                               Style="{StaticResource Antetitulo}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Todas"
                                Style="{StaticResource BotonPestana}"
                                Padding="14,6"
                                Clicked="BtnTodas_Clicked" />
                        <Button Grid.Column="2"
                                Text="Ninguna"
                                Style="{StaticResource BotonPestana}"
                                Padding="14,6"
                                Clicked="BtnNinguna_Clicked" />
                    </Grid>

                    <VerticalStackLayout x:Name="ListaDestinatarios"
                                         Spacing="2" />

                    <Label x:Name="LblResumen"
                           Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Preparar el correo en Gmail"
                    Style="{StaticResource BotonPrincipal}"
                    Clicked="BtnPreparar_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
