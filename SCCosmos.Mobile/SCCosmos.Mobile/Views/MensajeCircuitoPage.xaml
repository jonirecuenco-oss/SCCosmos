<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.MensajeCircuitoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nuevo mensaje"
    BackgroundColor="{StaticResource FondoPagina}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,28"
                             Spacing="14">

            <VerticalStackLayout Spacing="3">
                <Label Text="NUEVO MENSAJE AL CIRCUITO"
                       Style="{StaticResource Antetitulo}" />
                <Label Text="Marca las congregaciones y se abrirá Gmail con sus correos puestos; el mensaje lo escribes allí."
                       Style="{StaticResource SubtituloPagina}" />
            </VerticalStackLayout>

            <!-- REMITENTE: la cuenta @jwpub.org -->
            <Border Style="{StaticResource Tarjeta}">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="REMITENTE EN GMAIL"
                               Style="{StaticResource Antetitulo}" />
                        <Label x:Name="LblCuenta"
                               TextColor="{StaticResource TextoPrincipal}"
                               FontSize="14" />
                        <Label Text="Comprueba en Gmail que «De» es esta cuenta."
                               Style="{StaticResource TextoNota}" />
                    </VerticalStackLayout>
                    <Button x:Name="BtnCuenta"
                            Grid.Column="1"
                            Style="{StaticResource BotonSecundario}"
                            HeightRequest="38"
                            VerticalOptions="Center"
                            Clicked="BtnCuenta_Clicked" />
                </Grid>
            </Border>

            <!-- DESTINATARIOS: por secciones, como en Windows -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="6">
                        <Label Text="DESTINATARIOS"
                               Style="{StaticResource Antetitulo}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Todas"
                                Style="{StaticResource BotonPestana}"
                                Padding="14,6"
                                Clicked="BtnTodas_Clicked" />
                        <Button Grid.Column="2"
                                Text="Ninguna"
                                Style="{StaticResource BotonPestana}"
                                Padding="14,6"
                                Clicked="BtnNinguna_Clicked" />
                    </Grid>

                    <VerticalStackLayout x:Name="ListaDestinatarios"
                                         Spacing="2" />

                    <Label x:Name="LblResumen"
                           Style="{StaticResource TextoNota}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Abrir Gmail con estos correos"
                    Style="{StaticResource BotonPrincipal}"
                    Clicked="BtnAbrirGmail_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
