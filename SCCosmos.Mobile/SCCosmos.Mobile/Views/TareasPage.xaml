<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.TareasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Tareas"
    BackgroundColor="{StaticResource FondoPagina}">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="16,14,16,14"
          RowSpacing="10">

        <!-- CABECERA -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="10"
              RowSpacing="10">

            <VerticalStackLayout Grid.Row="0"
                                 Spacing="3">
                <Label Text="TAREAS Y EVENTOS"
                       Style="{StaticResource Antetitulo}" />
                <Label x:Name="LblResumen"
                       Text=""
                       Style="{StaticResource SubtituloPagina}" />
            </VerticalStackLayout>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Text="＋ Nueva"
                    Clicked="BtnNueva_Clicked"
                    BackgroundColor="#0B6FC2"
                    TextColor="{StaticResource TextoPrincipal}"
                    CornerRadius="9"
                    HeightRequest="40"
                    Padding="14,0"
                    FontSize="13"
                    VerticalOptions="Center" />

            <!-- Pestañas de categoría (la esposa no las ve) -->
            <HorizontalStackLayout x:Name="PanelCategorias"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Spacing="8">

                <Button x:Name="BtnCatPersonal"
                        Text="Personales"
                        Clicked="Categoria_Clicked"
                        CommandParameter="Personal"
                        BackgroundColor="#0B6FC2"
                        TextColor="{StaticResource TextoPrincipal}"
                        CornerRadius="9"
                        Padding="12,6"
                        FontSize="12" />

                <Button x:Name="BtnCatCalendario"
                        Text="Calendario"
                        Clicked="Categoria_Clicked"
                        CommandParameter="Calendario"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        TextColor="{StaticResource TextoPrincipal}"
                        CornerRadius="9"
                        Padding="12,6"
                        FontSize="12" />

                <Button x:Name="BtnCatAsambleas"
                        Text="Asambleas"
                        Clicked="Categoria_Clicked"
                        CommandParameter="Asambleas"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        TextColor="{StaticResource TextoPrincipal}"
                        CornerRadius="9"
                        Padding="12,6"
                        FontSize="12" />
            </HorizontalStackLayout>
        </Grid>

        <!-- LISTA -->
        <RefreshView x:Name="Refrescar"
                     Grid.Row="1"
                     Refreshing="Refrescar_Refreshing">

            <CollectionView x:Name="Lista"
                            SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,50"
                                         HorizontalOptions="Center"
                                         Spacing="8">
                        <Label Text="No hay tareas ni eventos."
                               TextColor="{StaticResource TextoSecundario}"
                               FontSize="15"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Pulsa «＋ Nueva» para programar uno."
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource Superficie}"
                                Stroke="{StaticResource Borde}"
                                StrokeThickness="1"
                                Padding="12"
                                Margin="0,0,0,9"
                                Opacity="{Binding Opacidad}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="Tarjeta_Tapped"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <!-- Todas igual de altas: título y fechas; a la derecha,
                                 solo iconos (se repite, compartida). La descripción
                                 y el aviso se ven al abrirla; completada, la casilla. -->
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="10">

                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding Completada, Mode=OneTime}"
                                          CheckedChanged="Completada_CheckedChanged"
                                          Color="{StaticResource Acento}"
                                          VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3"
                                                     VerticalOptions="Center">

                                    <Label Text="{Binding TituloVisual}"
                                           TextColor="{StaticResource TextoPrincipal}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />

                                    <Label Text="{Binding FechasVisual}"
                                           TextColor="#80C4FF"
                                           FontSize="13"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="2"
                                                       Spacing="6"
                                                       VerticalOptions="Center">
                                    <Label Text="🔁"
                                           IsVisible="{Binding MostrarRepeticion}"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           SemanticProperties.Description="{Binding RepeticionVisual}" />
                                    <Label Text="👫"
                                           IsVisible="{Binding EstaCompartida}"
                                           FontSize="16"
                                           VerticalOptions="Center"
                                           SemanticProperties.Description="Compartida" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="2"
               Text="Los avisos aparecen en la campana y como notificación de la app."
               Style="{StaticResource TextoNota}" />
    </Grid>
</ContentPage>
