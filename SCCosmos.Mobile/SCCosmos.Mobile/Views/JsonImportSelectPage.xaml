<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.JsonImportSelectPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Importar actividad"
    BackgroundColor="{StaticResource FondoPagina}"
    Shell.NavBarIsVisible="False" NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- CABECERA -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="16,14,16,10"
              ColumnSpacing="10">

            <VerticalStackLayout Grid.Column="0"
                                 Spacing="2">
                <Label Text="IMPORTAR ACTIVIDAD"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextoPrincipal}" />

                <Label x:Name="LblSubtitulo"
                       FontSize="12"
                       TextColor="{StaticResource TextoSecundario}"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Cerrar"
                    Clicked="BtnCancelar_Clicked"
                    BackgroundColor="{StaticResource SuperficieAlta}"
                    TextColor="{StaticResource TextoPrincipal}"
                    CornerRadius="9"
                    Padding="13,7"
                    VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,0,16,18"
                                 Spacing="12">

                <Border x:Name="PanelAviso"
                        BackgroundColor="#3B1B1B"
                        Stroke="#A94A4A"
                        StrokeThickness="1"
                        Padding="12"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="⚠ Esta semana ya tiene datos importados. Si continúas, se actualizarán la actividad y los territorios. No se borrarán publicadores automáticamente."
                           TextColor="#FFB5B5"
                           FontSize="12"
                           LineBreakMode="WordWrap" />
                </Border>

                <!-- ============================================ -->
                <!-- 1 · ACTIVIDAD DE PUBLICADORES (S-21)         -->
                <!-- ============================================ -->
                <Border BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        Padding="13">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="9">

                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="#1E4A6E"
                                    WidthRequest="21"
                                    HeightRequest="21"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>
                                <Label Text="1"
                                       TextColor="{StaticResource TextoPrincipal}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="ACTIVIDAD DE PUBLICADORES (S-21)"
                                   TextColor="{StaticResource TextoPrincipal}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Obligatorio. Una tarjeta por publicador y año de servicio."
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="11" />

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Archivo ya convertido (JSON)"
                                       TextColor="{StaticResource TextoSecundario}"
                                       FontSize="11.5" />
                                <Label x:Name="LblS21"
                                       Text="Ningún archivo seleccionado"
                                       TextColor="{StaticResource TextoTerciario}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Examinar"
                                    Clicked="BtnS21_Clicked"
                                    BackgroundColor="{StaticResource AcentoSuave}"
                                    TextColor="#B9DEFF"
                                    CornerRadius="9"
                                    Padding="12,7"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#22FFFFFF" />

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="O convertir desde PDF"
                                       TextColor="{StaticResource TextoSecundario}"
                                       FontSize="11.5" />
                                <Label x:Name="LblPdfS21"
                                       Text="Elige la carpeta con las tarjetas S-21 y se generará el JSON."
                                       TextColor="{StaticResource TextoTerciario}"
                                       FontSize="11.5"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <Button x:Name="BtnConvertirPdf"
                                    Grid.Column="1"
                                    Text="Convertir"
                                    Clicked="BtnConvertirPdf_Clicked"
                                    BackgroundColor="{StaticResource SuperficieAlta}"
                                    TextColor="{StaticResource TextoPrincipal}"
                                    CornerRadius="9"
                                    Padding="12,7"
                                    VerticalOptions="Center" />
                        </Grid>

                        <Button x:Name="BtnCompartirJson"
                                Text="Compartir JSON"
                                Clicked="BtnCompartirJson_Clicked"
                                BackgroundColor="{StaticResource AcentoSuave}"
                                TextColor="#B9DEFF"
                                CornerRadius="9"
                                Padding="10,7"
                                IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============================================ -->
                <!-- 2 · TERRITORIOS (S-13)                       -->
                <!-- ============================================ -->
                <Border BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        Padding="13">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="9">

                        <HorizontalStackLayout Spacing="8">
                            <Border BackgroundColor="#3E5C3A"
                                    WidthRequest="21"
                                    HeightRequest="21"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>
                                <Label Text="2"
                                       TextColor="{StaticResource TextoPrincipal}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="TERRITORIOS (S-13)"
                                   TextColor="{StaticResource TextoPrincipal}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                            <Label Text="opcional"
                                   TextColor="{StaticResource TextoTerciario}"
                                   FontSize="11"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="Registro de territorios ya convertido (datos_s13.json) desde el ordenador: admite el S-13 oficial en PDF, registros con un territorio por página y Excel."
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="11"
                               LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Archivo ya convertido (JSON)"
                                       TextColor="{StaticResource TextoSecundario}"
                                       FontSize="11.5" />
                                <Label x:Name="LblS13"
                                       Text="Ningún archivo seleccionado"
                                       TextColor="{StaticResource TextoTerciario}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="Examinar"
                                    Clicked="BtnS13_Clicked"
                                    BackgroundColor="{StaticResource SuperficieAlta}"
                                    TextColor="{StaticResource TextoPrincipal}"
                                    CornerRadius="9"
                                    Padding="12,7"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource BordeSuave}"
                        StrokeThickness="1"
                        Padding="12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Cómo se tratarán las personas"
                               TextColor="#80C4FF"
                               FontAttributes="Bold"
                               FontSize="12" />

                        <Label Text="El S-21 aporta el nombre completo, grupo y actividad. JW Hub aporta su nombre JW, nombre común y otros datos. Si parecen ser la misma persona, podrás vincularlas antes de guardar para evitar duplicados."
                               TextColor="{StaticResource TextoSecundario}"
                               FontSize="11"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="LblEstado"
                       TextColor="{StaticResource TextoSecundario}"
                       FontSize="11"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              Padding="16,10,16,16"
              ColumnSpacing="10">

            <Button Text="Cancelar"
                    Clicked="BtnCancelar_Clicked"
                    BackgroundColor="{StaticResource SuperficieAlta}"
                    TextColor="{StaticResource TextoPrincipal}"
                    CornerRadius="10"
                    HeightRequest="46" />

            <Button x:Name="BtnAnalizar"
                    Grid.Column="1"
                    Text="Analizar archivos"
                    Clicked="BtnAnalizar_Clicked"
                    BackgroundColor="#0B6FC2"
                    TextColor="{StaticResource TextoPrincipal}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="46" />
        </Grid>

        <Grid x:Name="OverlayCargando"
              Grid.RowSpan="3"
              BackgroundColor="#C0101216"
              IsVisible="False">
            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   Color="{StaticResource Acento}"
                                   WidthRequest="42"
                                   HeightRequest="42" />
                <Label x:Name="LblCargando"
                       Text="Leyendo archivos..."
                       TextColor="{StaticResource TextoPrincipal}"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
