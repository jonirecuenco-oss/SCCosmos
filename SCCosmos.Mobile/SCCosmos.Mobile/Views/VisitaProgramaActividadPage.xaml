<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.VisitaProgramaActividadPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Actividad"
    BackgroundColor="{StaticResource FondoPagina}">

    <ScrollView>
        <VerticalStackLayout Padding="18,18,18,28"
                             Spacing="12">

            <Label x:Name="LblTitulo"
                   Text="Programar actividad"
                   TextColor="{StaticResource TextoPrincipal}"
                   FontSize="23"
                   FontAttributes="Bold" />

            <Label Text="Día" TextColor="{StaticResource TextoSecundario}" FontSize="12" />
            <Picker x:Name="PickerDia"
                    BackgroundColor="{StaticResource Superficie}"
                    TextColor="{StaticResource TextoPrincipal}" />

            <Label Text="Turno" TextColor="{StaticResource TextoSecundario}" FontSize="12" />
            <Picker x:Name="PickerTurno"
                    BackgroundColor="{StaticResource Superficie}"
                    TextColor="{StaticResource TextoPrincipal}"
                    SelectedIndexChanged="PickerTurno_SelectedIndexChanged" />

            <Label Text="Responsable" TextColor="{StaticResource TextoSecundario}" FontSize="12" />
            <Picker x:Name="PickerResponsable"
                    BackgroundColor="{StaticResource Superficie}"
                    TextColor="{StaticResource TextoPrincipal}" />

            <Label Text="Acompañante / familia" TextColor="{StaticResource TextoSecundario}" FontSize="12" />
            <Picker x:Name="PickerCompanero"
                    ItemDisplayBinding="{Binding Nombre}"
                    SelectedIndexChanged="PickerCompanero_SelectedIndexChanged"
                    BackgroundColor="{StaticResource Superficie}"
                    TextColor="{StaticResource TextoPrincipal}" />

            <Label Text="Ubicación / dirección" TextColor="{StaticResource TextoSecundario}" FontSize="12" />
            <Entry x:Name="TxtUbicacion"
                   Placeholder="Dirección o lugar de la actividad"
                   TextChanged="TxtUbicacion_TextChanged"
                   TextColor="{StaticResource TextoPrincipal}"
                   PlaceholderColor="{StaticResource TextoTerciario}"
                   BackgroundColor="{StaticResource Superficie}" />

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Label x:Name="LblCoordenadas"
                       Text="Sin coordenadas"
                       TextColor="{StaticResource TextoTerciario}"
                       FontSize="10"
                       VerticalTextAlignment="Center" />

                <Button Grid.Column="1"
                        Text="Usar dirección del acompañante"
                        Clicked="BtnUsarDireccionCompanero_Clicked"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        TextColor="#B9DEFF"
                        FontSize="10"
                        CornerRadius="8"
                        Padding="9,5" />
            </Grid>

            <Label Text="Hora (ej. 10:00)" TextColor="{StaticResource TextoSecundario}" FontSize="12" />
            <Entry x:Name="TxtHora"
                   Placeholder="10:00"
                   TextColor="{StaticResource TextoPrincipal}"
                   PlaceholderColor="{StaticResource TextoTerciario}"
                   BackgroundColor="{StaticResource Superficie}" />

            <Label Text="Tipo de actividad" TextColor="{StaticResource TextoSecundario}" FontSize="12" />
            <Entry x:Name="TxtTipo"
                   Placeholder="Predicación, pastoreo..."
                   TextColor="{StaticResource TextoPrincipal}"
                   PlaceholderColor="{StaticResource TextoTerciario}"
                   BackgroundColor="{StaticResource Superficie}" />

            <Label Text="Notas / libro" TextColor="{StaticResource TextoSecundario}" FontSize="12" />
            <Editor x:Name="TxtNotas"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="90"
                    TextColor="{StaticResource TextoPrincipal}"
                    BackgroundColor="{StaticResource Superficie}" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="10"
                  Margin="0,8,0,0">
                <Button Text="Cancelar"
                        Clicked="BtnCancelar_Clicked"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        TextColor="{StaticResource TextoPrincipal}"
                        CornerRadius="10" />
                <Button Grid.Column="1"
                        x:Name="BtnGuardar"
                        Text="Guardar"
                        Clicked="BtnGuardar_Clicked"
                        BackgroundColor="{StaticResource AcentoFuerte}"
                        TextColor="{StaticResource TextoPrincipal}"
                        FontAttributes="Bold"
                        CornerRadius="10" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
