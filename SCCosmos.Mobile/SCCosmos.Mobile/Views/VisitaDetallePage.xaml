<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.VisitaDetallePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Visita"
    BackgroundColor="#101216"
    Shell.NavBarIsVisible="False" NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- CABECERA: flecha atrás, título centrado y botón Datos -->
        <Grid Grid.Row="0"
              Padding="10,12,16,8">

            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="2"
                                 Margin="58,0">
                <Label x:Name="LblCongregacion"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextoPrincipal}"
                       LineBreakMode="TailTruncation"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="LblPeriodo"
                       FontSize="12"
                       TextColor="{StaticResource TextoSecundario}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border HorizontalOptions="Start"
                    VerticalOptions="Center"
                    WidthRequest="42"
                    HeightRequest="42"
                    BackgroundColor="#1A1D22"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Volver_Tapped" />
                </Border.GestureRecognizers>
                <Label Text="←"
                       TextColor="White"
                       FontSize="22"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>

            <Button HorizontalOptions="End"
                    VerticalOptions="Center"
                    Text="Datos"
                    Clicked="BtnDatos_Clicked"
                    Style="{StaticResource BotonSecundario}"
                    HeightRequest="38"
                    Padding="11,6"
                    FontSize="12.5" />
        </Grid>

        <!-- PESTAÑAS -->
        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="10,0,10,6">
            <HorizontalStackLayout Spacing="6">

                <Button x:Name="TabMinisterio"
                        Text="Ministerio"
                        Clicked="Tab_Clicked"
                        CommandParameter="ministerio"
                        BackgroundColor="#1B4E7A"
                        TextColor="White"
                        FontSize="12.5"
                        FontAttributes="Bold"
                        CornerRadius="9"
                        Padding="12,7" />

                <Button x:Name="TabMapa"
                        Text="Mapa"
                        Clicked="Tab_Clicked"
                        CommandParameter="mapa"
                        BackgroundColor="#1A1D22"
                        TextColor="#9CC3F5"
                        FontSize="12.5"
                        CornerRadius="9"
                        Padding="12,7" />

                <Button x:Name="TabPrograma"
                        Text="Programa"
                        Clicked="Tab_Clicked"
                        CommandParameter="programa"
                        BackgroundColor="#1A1D22"
                        TextColor="#9CC3F5"
                        FontSize="12.5"
                        CornerRadius="9"
                        Padding="12,7" />

                <Button x:Name="TabNotas"
                        Text="Notas"
                        Clicked="Tab_Clicked"
                        CommandParameter="notas"
                        BackgroundColor="#1A1D22"
                        TextColor="#9CC3F5"
                        FontSize="12.5"
                        CornerRadius="9"
                        Padding="12,7" />

                <Button x:Name="TabInformacion"
                        Text="Información"
                        Clicked="Tab_Clicked"
                        CommandParameter="informacion"
                        BackgroundColor="#1A1D22"
                        TextColor="#9CC3F5"
                        FontSize="12.5"
                        CornerRadius="9"
                        Padding="12,7" />

                <Button x:Name="TabGrupos"
                        Text="Grupos"
                        Clicked="Tab_Clicked"
                        CommandParameter="grupos"
                        BackgroundColor="#1A1D22"
                        TextColor="#9CC3F5"
                        FontSize="12.5"
                        CornerRadius="9"
                        Padding="12,7" />

                <Button x:Name="TabTerritorios"
                        Text="Territorios"
                        Clicked="Tab_Clicked"
                        CommandParameter="territorios"
                        BackgroundColor="#1A1D22"
                        TextColor="#9CC3F5"
                        FontSize="12.5"
                        CornerRadius="9"
                        Padding="12,7" />

                <Button x:Name="TabContabilidad"
                        Text="Contabilidad"
                        Clicked="Tab_Clicked"
                        CommandParameter="contabilidad"
                        BackgroundColor="#1A1D22"
                        TextColor="#9CC3F5"
                        FontSize="12.5"
                        CornerRadius="9"
                        Padding="12,7" />

                <Button x:Name="TabS303"
                        Text="S-303"
                        Clicked="Tab_Clicked"
                        CommandParameter="s303"
                        BackgroundColor="#1A1D22"
                        TextColor="#9CC3F5"
                        FontSize="12.5"
                        CornerRadius="9"
                        Padding="12,7" />
            </HorizontalStackLayout>
        </ScrollView>

        <ScrollView x:Name="ScrollContenido"
                    Grid.Row="2">
            <VerticalStackLayout Padding="16,0,16,28"
                                 Spacing="12">

                <Border x:Name="PanelDatosCongregacion"
                        IsVisible="False"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        Padding="13">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="DATOS DE LA CONGREGACIÓN"
                               TextColor="#80C4FF"
                               FontSize="11"
                               FontAttributes="Bold" />

                        <Label x:Name="LblReuniones"
                               TextColor="#B6BBC2"
                               FontSize="12"
                               IsVisible="False" />

                        <Label x:Name="LblEmail"
                               TextColor="#B6BBC2"
                               FontSize="12"
                               IsVisible="False" />

                        <Label x:Name="LblEmailAV"
                               TextColor="#B6BBC2"
                               FontSize="12"
                               IsVisible="False" />

                        <Button x:Name="BtnMapaSalon"
                                Text="Ver Salón del Reino en el mapa"
                                Clicked="BtnMapaSalon_Clicked"
                                BackgroundColor="#163553"
                                TextColor="#B9DEFF"
                                CornerRadius="9"
                                HeightRequest="42"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="SeccionInformacion"
                                     IsVisible="False"
                                     Spacing="12">

                <Label Text="Resumen de la congregación"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="17"
                       Margin="0,5,0,0" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="8"
                      RowSpacing="8">

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            Padding="11">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Publicadores"
                                   TextColor="#9EA4AE"
                                   FontSize="11" />
                            <Label x:Name="LblPublicadores"
                                   Text="0"
                                   TextColor="White"
                                   FontSize="24"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            Padding="11">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Media de edad"
                                   TextColor="#9EA4AE"
                                   FontSize="11" />
                            <Label x:Name="LblEdad"
                                   Text="0"
                                   TextColor="White"
                                   FontSize="24"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            Padding="11">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Ancianos / SM"
                                   TextColor="#9EA4AE"
                                   FontSize="11" />
                            <Label x:Name="LblNombrados"
                                   Text="0 / 0"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            Padding="11">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="PR / Especiales"
                                   TextColor="#9EA4AE"
                                   FontSize="11" />
                            <Label x:Name="LblPrecursores"
                                   Text="0 / 0"
                                   TextColor="#80C4FF"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.Column="0"
                            BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            Padding="11">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="Hombres / Mujeres"
                                   TextColor="#9EA4AE"
                                   FontSize="11" />
                            <Label x:Name="LblSexo"
                                   Text="0 / 0"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            Padding="11">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <VerticalStackLayout>
                            <Label Text="No bautizados"
                                   TextColor="#9EA4AE"
                                   FontSize="11" />
                            <Label x:Name="LblNoBautizados"
                                   Text="0"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeccionGrupos"
                                     IsVisible="False"
                                     Spacing="12">

                <Label Text="Grupos de predicación"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="17"
                       Margin="0,6,0,0" />

                <CollectionView x:Name="ListaGrupos"
                                ItemsLayout="HorizontalList"
                                SelectionMode="None"
                                HeightRequest="170"
                                HorizontalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource Superficie}"
                                    Stroke="{StaticResource Borde}"
                                    Padding="14"
                                    Margin="0,0,9,0"
                                    WidthRequest="330">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="7">
                                    <Label Text="{Binding Grupo, StringFormat='Grupo {0}'}"
                                           TextColor="#80C4FF"
                                           FontAttributes="Bold"
                                           FontSize="16" />

                                    <Grid ColumnDefinitions="*,Auto"
                                          RowDefinitions="Auto,Auto,Auto,Auto"
                                          RowSpacing="4">
                                        <Label Text="Publicadores"
                                               TextColor="#B6BBC2"
                                               FontSize="12" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Publicadores}"
                                               TextColor="White"
                                               FontAttributes="Bold" />

                                        <Label Grid.Row="1"
                                               Text="Precursores / misioneros"
                                               TextColor="#B6BBC2"
                                               FontSize="12" />
                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding Precursores}"
                                               TextColor="#7ED889"
                                               FontAttributes="Bold" />

                                        <Label Grid.Row="2"
                                               Text="Ancianos"
                                               TextColor="#B6BBC2"
                                               FontSize="12" />
                                        <Label Grid.Row="2"
                                               Grid.Column="1"
                                               Text="{Binding Ancianos}"
                                               TextColor="#FFAA75"
                                               FontAttributes="Bold" />

                                        <Label Grid.Row="3"
                                               Text="Siervos ministeriales"
                                               TextColor="#B6BBC2"
                                               FontSize="12" />
                                        <Label Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding Siervos}"
                                               TextColor="#FFD76B"
                                               FontAttributes="Bold" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeccionMinisterio"
                                     Spacing="12">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10"
                      Margin="0,2,0,0">

                    <Picker x:Name="PickerGrupo"
                            Grid.Column="0"
                            SelectedIndexChanged="PickerGrupo_SelectedIndexChanged"
                            BackgroundColor="#1A1D22"
                            TextColor="White"
                            HorizontalOptions="Start"
                            WidthRequest="150"
                            Title="Grupo" />

                    <HorizontalStackLayout x:Name="CintaMesMinisterio"
                                           Grid.Column="1"
                                           Spacing="2"
                                           VerticalOptions="Center">
                        <Button Text="‹"
                                Clicked="BtnMesAntMinisterio_Clicked"
                                BackgroundColor="#242830"
                                TextColor="White"
                                WidthRequest="34"
                                HeightRequest="34"
                                Padding="0" />

                        <Label x:Name="LblMesMinisterio"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="13"
                               WidthRequest="104"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />

                        <Button Text="›"
                                Clicked="BtnMesSigMinisterio_Clicked"
                                BackgroundColor="#242830"
                                TextColor="White"
                                WidthRequest="34"
                                HeightRequest="34"
                                Padding="0" />
                    </HorizontalStackLayout>
                </Grid>

                <CollectionView x:Name="ListaPersonas"
                                Margin="-16,0,-16,0"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid>

                            <Border BackgroundColor="{StaticResource Superficie}"
                                    Stroke="{StaticResource Borde}"
                                    Padding="10"
                                    Margin="16,0,16,7"
                                    IsVisible="{Binding EsPersona}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="58,*"
                                      ColumnSpacing="10">

                                    <VerticalStackLayout Grid.Row="0"
                                                         Grid.Column="0"
                                                         Spacing="4"
                                                         HorizontalOptions="Center">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                CommandParameter="{Binding PersonaId}"
                                                Tapped="PersonaVisita_Tapped" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <Border WidthRequest="50"
                                                HeightRequest="50"
                                                BackgroundColor="#242830"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="25" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding FotoSource}"
                                                   Aspect="AspectFill" />
                                        </Border>

                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="0"
                                                         Grid.Column="1"
                                                         Spacing="2"
                                                         VerticalOptions="Center">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                CommandParameter="{Binding PersonaId}"
                                                Tapped="PersonaVisita_Tapped" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <!-- Nombre + abreviaturas + aviso -->
                                        <Grid ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto"
                                              ColumnSpacing="4">

                                            <Label Text="{Binding NombreVisual}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="14.5"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   HeightRequest="22"
                                                   VerticalTextAlignment="Center" />

                                            <HorizontalStackLayout Grid.Column="1"
                                                                   Spacing="4"
                                                                   HeightRequest="22"
                                                                   VerticalOptions="Center">

                                                <Border BackgroundColor="#2E2418"
                                                        StrokeThickness="0"
                                                        Padding="5,0"
                                                        HeightRequest="18"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding MostrarNombramiento}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding EtiquetaNombramiento}"
                                                           TextColor="#FFAA75"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           VerticalTextAlignment="Center" />
                                                </Border>

                                                <Border BackgroundColor="#1B2A20"
                                                        StrokeThickness="0"
                                                        Padding="5,0"
                                                        HeightRequest="18"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding MostrarServicio}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="4" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding EtiquetaServicio}"
                                                           TextColor="#7ED889"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           VerticalTextAlignment="Center" />
                                                </Border>

                                                <Button Text="⚠"
                                                        IsVisible="{Binding MostrarAlertaHoras}"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="AdvertenciaHoras_Clicked"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#FFD38A"
                                                        FontSize="15"
                                                        Padding="0"
                                                        WidthRequest="24"
                                                        HeightRequest="20"
                                                        VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- 6 últimos meses de actividad -->
                                        <Grid Margin="0,2,0,0"
                                              IsVisible="{Binding MostrarCuadrosHoras}"
                                              ColumnDefinitions="*,*,*,*,*,*"
                                              ColumnSpacing="4">

                                        <Border Grid.Column="0"
                                                BackgroundColor="{Binding Actividad1.Fondo}"
                                                StrokeThickness="0"
                                                Padding="3,1,3,0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="7" />
                                            </Border.StrokeShape>
                                            <Grid>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Fill"><HorizontalStackLayout Spacing="2" HorizontalOptions="Center"><Label Text="{Binding Actividad1.Mes}" TextColor="#9EA4AE" FontSize="9" VerticalTextAlignment="Center"/></HorizontalStackLayout><HorizontalStackLayout Spacing="1" HorizontalOptions="Center"><Label Text="{Binding Actividad1.Valor}" TextColor="{Binding Actividad1.TextoColor}" FontSize="{Binding Actividad1.ValorFontSize}" FontAttributes="Bold" VerticalTextAlignment="Center"/><Label Text="*" IsVisible="{Binding Actividad1.TieneNotas}" TextColor="#80C4FF" FontAttributes="Bold" FontSize="13" Margin="1,-2,0,-1" VerticalTextAlignment="Center"/></HorizontalStackLayout></VerticalStackLayout>
                                        
                                            <Button Text=""
                                                    CommandParameter="{Binding Actividad1}"
                                                    Clicked="ActividadMes_Clicked"
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    Padding="0"
                                                    Margin="0"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"
                                                    SemanticProperties.Description="Abrir detalle del mes" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding Actividad2.Fondo}"
                                                StrokeThickness="0"
                                                Padding="3,1,3,0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
                                            <Grid>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Fill"><HorizontalStackLayout Spacing="2" HorizontalOptions="Center"><Label Text="{Binding Actividad2.Mes}" TextColor="#9EA4AE" FontSize="9" VerticalTextAlignment="Center"/></HorizontalStackLayout><HorizontalStackLayout Spacing="1" HorizontalOptions="Center"><Label Text="{Binding Actividad2.Valor}" TextColor="{Binding Actividad2.TextoColor}" FontSize="{Binding Actividad2.ValorFontSize}" FontAttributes="Bold" VerticalTextAlignment="Center"/><Label Text="*" IsVisible="{Binding Actividad2.TieneNotas}" TextColor="#80C4FF" FontAttributes="Bold" FontSize="13" Margin="1,-2,0,-1" VerticalTextAlignment="Center"/></HorizontalStackLayout></VerticalStackLayout>
                                        
                                            <Button Text=""
                                                    CommandParameter="{Binding Actividad2}"
                                                    Clicked="ActividadMes_Clicked"
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    Padding="0"
                                                    Margin="0"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"
                                                    SemanticProperties.Description="Abrir detalle del mes" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2"
                                                BackgroundColor="{Binding Actividad3.Fondo}"
                                                StrokeThickness="0"
                                                Padding="3,1,3,0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
                                            <Grid>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Fill"><HorizontalStackLayout Spacing="2" HorizontalOptions="Center"><Label Text="{Binding Actividad3.Mes}" TextColor="#9EA4AE" FontSize="9" VerticalTextAlignment="Center"/></HorizontalStackLayout><HorizontalStackLayout Spacing="1" HorizontalOptions="Center"><Label Text="{Binding Actividad3.Valor}" TextColor="{Binding Actividad3.TextoColor}" FontSize="{Binding Actividad3.ValorFontSize}" FontAttributes="Bold" VerticalTextAlignment="Center"/><Label Text="*" IsVisible="{Binding Actividad3.TieneNotas}" TextColor="#80C4FF" FontAttributes="Bold" FontSize="13" Margin="1,-2,0,-1" VerticalTextAlignment="Center"/></HorizontalStackLayout></VerticalStackLayout>
                                        
                                            <Button Text=""
                                                    CommandParameter="{Binding Actividad3}"
                                                    Clicked="ActividadMes_Clicked"
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    Padding="0"
                                                    Margin="0"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"
                                                    SemanticProperties.Description="Abrir detalle del mes" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="3"
                                                BackgroundColor="{Binding Actividad4.Fondo}"
                                                StrokeThickness="0"
                                                Padding="3,1,3,0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
                                            <Grid>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Fill"><HorizontalStackLayout Spacing="2" HorizontalOptions="Center"><Label Text="{Binding Actividad4.Mes}" TextColor="#9EA4AE" FontSize="9" VerticalTextAlignment="Center"/></HorizontalStackLayout><HorizontalStackLayout Spacing="1" HorizontalOptions="Center"><Label Text="{Binding Actividad4.Valor}" TextColor="{Binding Actividad4.TextoColor}" FontSize="{Binding Actividad4.ValorFontSize}" FontAttributes="Bold" VerticalTextAlignment="Center"/><Label Text="*" IsVisible="{Binding Actividad4.TieneNotas}" TextColor="#80C4FF" FontAttributes="Bold" FontSize="13" Margin="1,-2,0,-1" VerticalTextAlignment="Center"/></HorizontalStackLayout></VerticalStackLayout>
                                        
                                            <Button Text=""
                                                    CommandParameter="{Binding Actividad4}"
                                                    Clicked="ActividadMes_Clicked"
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    Padding="0"
                                                    Margin="0"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"
                                                    SemanticProperties.Description="Abrir detalle del mes" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="4"
                                                BackgroundColor="{Binding Actividad5.Fondo}"
                                                StrokeThickness="0"
                                                Padding="3,1,3,0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
                                            <Grid>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Fill"><HorizontalStackLayout Spacing="2" HorizontalOptions="Center"><Label Text="{Binding Actividad5.Mes}" TextColor="#9EA4AE" FontSize="9" VerticalTextAlignment="Center"/></HorizontalStackLayout><HorizontalStackLayout Spacing="1" HorizontalOptions="Center"><Label Text="{Binding Actividad5.Valor}" TextColor="{Binding Actividad5.TextoColor}" FontSize="{Binding Actividad5.ValorFontSize}" FontAttributes="Bold" VerticalTextAlignment="Center"/><Label Text="*" IsVisible="{Binding Actividad5.TieneNotas}" TextColor="#80C4FF" FontAttributes="Bold" FontSize="13" Margin="1,-2,0,-1" VerticalTextAlignment="Center"/></HorizontalStackLayout></VerticalStackLayout>
                                        
                                            <Button Text=""
                                                    CommandParameter="{Binding Actividad5}"
                                                    Clicked="ActividadMes_Clicked"
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    Padding="0"
                                                    Margin="0"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"
                                                    SemanticProperties.Description="Abrir detalle del mes" />
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="5"
                                                BackgroundColor="{Binding Actividad6.Fondo}"
                                                StrokeThickness="0"
                                                Padding="3,1,3,0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="7" /></Border.StrokeShape>
                                            <Grid>
                                            <VerticalStackLayout Spacing="0" HorizontalOptions="Fill"><HorizontalStackLayout Spacing="2" HorizontalOptions="Center"><Label Text="{Binding Actividad6.Mes}" TextColor="#9EA4AE" FontSize="9" VerticalTextAlignment="Center"/></HorizontalStackLayout><HorizontalStackLayout Spacing="1" HorizontalOptions="Center"><Label Text="{Binding Actividad6.Valor}" TextColor="{Binding Actividad6.TextoColor}" FontSize="{Binding Actividad6.ValorFontSize}" FontAttributes="Bold" VerticalTextAlignment="Center"/><Label Text="*" IsVisible="{Binding Actividad6.TieneNotas}" TextColor="#80C4FF" FontAttributes="Bold" FontSize="13" Margin="1,-2,0,-1" VerticalTextAlignment="Center"/></HorizontalStackLayout></VerticalStackLayout>
                                        
                                            <Button Text=""
                                                    CommandParameter="{Binding Actividad6}"
                                                    Clicked="ActividadMes_Clicked"
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    Padding="0"
                                                    Margin="0"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"
                                                    SemanticProperties.Description="Abrir detalle del mes" />
                                            </Grid>
                                        </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Separación clara de los inactivos -->
                            <Border BackgroundColor="#2A2117"
                                    StrokeThickness="0"
                                    Padding="16,8"
                                    Margin="0,8,0,6"
                                    IsVisible="{Binding EsSeparador}">
                                <Label Text="{Binding TextoSeparador}"
                                       TextColor="#FFD38A"
                                       FontSize="13"
                                       FontAttributes="Bold" />
                            </Border>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeccionPrograma"
                                     IsVisible="False"
                                     Spacing="7">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="7"
                      Margin="0,0,0,0">
                    <Button x:Name="BtnPrograma"
                            Text="Programa de la visita"
                            Clicked="BtnPrograma_Clicked"
                            IsVisible="False"
                            BackgroundColor="#1B2433"
                            BorderWidth="0"
                            TextColor="#9CC3F5"
                            FontAttributes="Bold"
                            FontSize="14.5"
                            HorizontalOptions="Fill"
                            CornerRadius="0"
                            Padding="16,13" />

                    <Button Grid.Column="1"
                            Text="＋"
                            Clicked="BtnNuevaActividad_Clicked"
                            BackgroundColor="#245C38"
                            TextColor="White"
                            FontSize="18"
                            CornerRadius="10"
                            WidthRequest="48" />
                </Grid>

                <VerticalStackLayout x:Name="PanelPrograma"
                                     IsVisible="True"
                                     Spacing="7">

                    <Button Text="Importar programa desde JSON"
                            Clicked="BtnImportarPrograma_Clicked"
                            BackgroundColor="#265B36"
                            TextColor="#D6F6DE"
                            CornerRadius="9"
                            HeightRequest="42" />

                    <Label x:Name="LblSinPrograma"
                           Text="No hay actividades programadas para esta visita."
                           TextColor="#8F969F"
                           FontSize="12"
                           IsVisible="False" />

                    <CollectionView x:Name="ListaPrograma"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource Superficie}"
                                        Stroke="{StaticResource Borde}"
                                        StrokeThickness="1"
                                        Padding="12"
                                        Margin="0,0,0,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="62,*,Auto"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="8"
                                          RowSpacing="2">

                                        <!-- Hora, como en Inicio -->
                                        <Label Grid.RowSpan="5"
                                               Text="{Binding Original.Hora}"
                                               TextColor="#4BA3E3"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               VerticalOptions="Start" />

                                        <!-- Tipo de actividad y día/turno -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Original.TipoActividad}"
                                               TextColor="White"
                                               FontSize="15"
                                               FontAttributes="Bold" />

                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding DiaTurno}"
                                               TextColor="#9EA4AE"
                                               FontSize="12" />

                                        <!-- Responsable (chip), como en Inicio -->
                                        <Border Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="2"
                                                BackgroundColor="#242A33"
                                                Padding="8,3"
                                                StrokeThickness="0"
                                                VerticalOptions="Start"
                                                IsVisible="{Binding MostrarResponsable}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Responsable}"
                                                   TextColor="#EBCB8B"
                                                   FontSize="11.5"
                                                   FontAttributes="Bold" />
                                        </Border>

                                        <!-- Compañero -->
                                        <Label Grid.Row="2"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding CompaneroVisual}"
                                               TextColor="#9299A3"
                                               FontSize="12.5"
                                               IsVisible="{Binding MostrarCompanero}" />

                                        <!-- Ubicación con botón de mapa -->
                                        <Grid Grid.Row="3"
                                              Grid.Column="1"
                                              Grid.ColumnSpan="2"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="6"
                                              IsVisible="{Binding MostrarUbicacion}">
                                            <Label Text="{Binding Original.Ubicacion}"
                                                   TextColor="#80C4FF"
                                                   FontSize="11.5"
                                                   LineBreakMode="WordWrap"
                                                   VerticalTextAlignment="Center" />

                                            <Button Grid.Column="1"
                                                    Text="📍"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="BtnMapaPrograma_Clicked"
                                                    BackgroundColor="#242830"
                                                    TextColor="#8BC9E8"
                                                    FontSize="14"
                                                    Padding="8,2"
                                                    CornerRadius="8"
                                                    IsVisible="{Binding MostrarMapa}" />
                                        </Grid>

                                        <!-- Notas -->
                                        <Label Grid.Row="4"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Notas}"
                                               TextColor="#8A919B"
                                               FontSize="12"
                                               LineBreakMode="WordWrap"
                                               IsVisible="{Binding MostrarNotas}" />

                                        <!-- Editar / borrar -->
                                        <HorizontalStackLayout Grid.RowSpan="5"
                                                               Grid.Column="2"
                                                               Spacing="4"
                                                               VerticalOptions="End"
                                                               HorizontalOptions="End"
                                                               Margin="0,40,0,0">
                                            <Button Text="✏️"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="BtnEditarActividad_Clicked"
                                                    BackgroundColor="#242830"
                                                    TextColor="White"
                                                    Padding="6,2"
                                                    CornerRadius="7" />

                                            <Button Text="🗑️"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="BtnEliminarActividad_Clicked"
                                                    BackgroundColor="#4B2227"
                                                    TextColor="#FFD4D8"
                                                    Padding="6,2"
                                                    CornerRadius="7" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeccionNotas"
                                     IsVisible="False"
                                     Spacing="7">

                <Button x:Name="BtnNotas"
                        Text="Notas personales de la visita"
                        Clicked="BtnNotas_Clicked"
                        IsVisible="False"
                        BackgroundColor="#1B2433"
                        BorderWidth="0"
                        TextColor="#9CC3F5"
                        FontAttributes="Bold"
                        FontSize="14.5"
                        HorizontalOptions="Fill"
                        CornerRadius="0"
                        Padding="16,13"
                        Margin="0" />

                <VerticalStackLayout x:Name="PanelNotasContenedor"
                                     IsVisible="True"
                                     Spacing="8">

                    <Picker x:Name="PickerCategoriaNotas"
                            Title="Categoría"
                            SelectedIndexChanged="PickerCategoriaNotas_SelectedIndexChanged"
                            BackgroundColor="#1A1D22"
                            TextColor="White" />

                    <Label x:Name="LblSinNotas"
                           Text="No hay notas para esta visita."
                           TextColor="#8F969F"
                           FontSize="12"
                           IsVisible="False" />

                    <VerticalStackLayout x:Name="PanelNotas"
                                         Spacing="8" />
                </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeccionTerritorios"
                                     IsVisible="False"
                                     Spacing="7">

                <Button x:Name="BtnTerritorios"
                        Text="Territorios (S-13)"
                        Clicked="BtnTerritorios_Clicked"
                        IsVisible="False"
                        BackgroundColor="#1B2433"
                        BorderWidth="0"
                        TextColor="#9CC3F5"
                        FontAttributes="Bold"
                        FontSize="14.5"
                        HorizontalOptions="Fill"
                        CornerRadius="0"
                        Padding="16,13"
                        Margin="0" />

                <VerticalStackLayout x:Name="PanelTerritorios"
                                     IsVisible="True"
                                     Spacing="7">
                    <Label x:Name="LblTotalTerritorios"
                           TextColor="#9EA4AE"
                           FontSize="12" />

                    <Button x:Name="BtnImportarTerritoriosJson"
                            Text="⬆ Importar JSON (S-13)"
                            Clicked="BtnImportarTerritoriosJson_Clicked"
                            BackgroundColor="#163553"
                            TextColor="#B9DEFF"
                            FontSize="12.5"
                            CornerRadius="9"
                            Padding="10,6"
                            HorizontalOptions="Start" />

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8">
                        <Button x:Name="BtnTerrAnt"
                                Grid.Column="0"
                                Text="‹ Anterior"
                                Clicked="BtnTerrAnt_Clicked"
                                BackgroundColor="#242830"
                                TextColor="White"
                                FontSize="12"
                                Padding="10,6" />
                        <Label x:Name="LblPaginaTerritorios"
                               Grid.Column="1"
                               Text=""
                               TextColor="#9EA4AE"
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                        <Button x:Name="BtnTerrSig"
                                Grid.Column="2"
                                Text="Siguiente ›"
                                Clicked="BtnTerrSig_Clicked"
                                BackgroundColor="#242830"
                                TextColor="White"
                                FontSize="12"
                                Padding="10,6" />
                    </Grid>

                    <CollectionView x:Name="ListaTerritorios"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource Superficie}"
                                        Stroke="{StaticResource Borde}"
                                        Padding="10"
                                        Margin="0,0,0,7">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="Territorio_Tapped"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="3">
                                            <Label Text="{Binding Nombre}"
                                                   TextColor="White"
                                                   FontAttributes="Bold"
                                                   FontSize="13" />
                                            <Label Text="{Binding Estado}"
                                                   TextColor="#B6BBC2"
                                                   FontSize="11" />
                                            <Label Text="{Binding Ultima}"
                                                   TextColor="#8F969F"
                                                   FontSize="10"
                                                   IsVisible="{Binding MostrarUltima}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="Editar"
                                               TextColor="#80C4FF"
                                               FontSize="12"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeccionMapa"
                                     IsVisible="False"
                                     Spacing="7">

                <Button x:Name="BtnMapa"
                        Text="Mapa"
                        Clicked="BtnMapa_Clicked"
                        IsVisible="False"
                        BackgroundColor="#1B2433"
                        BorderWidth="0"
                        TextColor="#9CC3F5"
                        FontAttributes="Bold"
                        FontSize="14.5"
                        HorizontalOptions="Fill"
                        CornerRadius="0"
                        Padding="16,13"
                        Margin="0" />

                <VerticalStackLayout x:Name="PanelMapa"
                                     IsVisible="True"
                                     Spacing="7">

                    <Label x:Name="LblMapaEstado"
                           Text=""
                           Style="{StaticResource TextoNota}" />

                    <Border BackgroundColor="{StaticResource SuperficieBaja}"
                            Stroke="{StaticResource Borde}"
                            Padding="2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <WebView x:Name="MapaWebView"
                                 HeightRequest="420" />
                    </Border>
                </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeccionContabilidad"
                                     IsVisible="False"
                                     Spacing="7">

                <Button x:Name="BtnContabilidad"
                        Text="Contabilidad"
                        Clicked="BtnContabilidad_Clicked"
                        IsVisible="False"
                        BackgroundColor="#1B2433"
                        BorderWidth="0"
                        TextColor="#9CC3F5"
                        FontAttributes="Bold"
                        FontSize="14.5"
                        HorizontalOptions="Fill"
                        CornerRadius="0"
                        Padding="16,13"
                        Margin="0" />

                <VerticalStackLayout x:Name="PanelContabilidad"
                                     IsVisible="True"
                                     Spacing="8">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8">
                        <Button Text="‹"
                                Clicked="BtnMesAntContabilidad_Clicked"
                                BackgroundColor="#242830"
                                TextColor="White"
                                WidthRequest="46" />

                        <Label x:Name="LblMesContabilidad"
                               Grid.Column="1"
                               TextColor="White"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />

                        <Button Grid.Column="2"
                                Text="›"
                                Clicked="BtnMesSigContabilidad_Clicked"
                                BackgroundColor="#242830"
                                TextColor="White"
                                WidthRequest="46" />
                    </Grid>

                    <Label Text="Los cambios se guardan al salir de cada campo."
                           TextColor="#8F969F"
                           FontSize="10" />

                    <VerticalStackLayout x:Name="PanelContabilidadFilas"
                                         Spacing="8" />
                </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeccionS303"
                                     IsVisible="False"
                                     Spacing="7">

                <Button x:Name="BtnS303"
                        Text="S-303 y S-2"
                        Clicked="BtnS303_Clicked"
                        IsVisible="False"
                        BackgroundColor="#1B2433"
                        BorderWidth="0"
                        TextColor="#9CC3F5"
                        FontAttributes="Bold"
                        FontSize="14.5"
                        HorizontalOptions="Fill"
                        CornerRadius="0"
                        Padding="16,13"
                        Margin="0" />

                <VerticalStackLayout x:Name="PanelS303"
                                     IsVisible="True"
                                     Spacing="10">

                    <Border BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="DOCUMENTO S-303"
                                   TextColor="#80C4FF"
                                   FontAttributes="Bold"
                                   FontSize="12" />

                            <Label x:Name="LblEstadoS303"
                                   TextColor="#B6BBC2"
                                   FontSize="11"
                                   LineBreakMode="WordWrap" />

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="7"
                                  RowSpacing="7">
                                <Button Text="Plantilla PDF"
                                        Clicked="BtnSeleccionarPlantillaS303_Clicked"
                                        BackgroundColor="#242830"
                                        TextColor="White"
                                        CornerRadius="8" />

                                <Button Grid.Column="1"
                                        Text="Crear / abrir"
                                        Clicked="BtnCrearAbrirS303_Clicked"
                                        BackgroundColor="#2478B5"
                                        TextColor="White"
                                        CornerRadius="8" />

                                <Button Grid.Row="1"
                                        Text="Importar completado"
                                        Clicked="BtnImportarS303Completado_Clicked"
                                        BackgroundColor="#245C38"
                                        TextColor="White"
                                        CornerRadius="8" />

                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Text="Eliminar"
                                        Clicked="BtnEliminarS303_Clicked"
                                        BackgroundColor="#4B2227"
                                        TextColor="#FFD4D8"
                                        CornerRadius="8" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="RECOMENDACIONES Y BAJAS PENDIENTES (S-2)"
                                   TextColor="#80C4FF"
                                   FontAttributes="Bold"
                                   FontSize="12" />

                            <Label x:Name="LblSinS2"
                                   Text="No hay recomendaciones ni bajas pendientes."
                                   TextColor="#8F969F"
                                   FontSize="11"
                                   IsVisible="False" />

                            <VerticalStackLayout x:Name="PanelS2"
                                                 Spacing="6" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="7">
                            <Label Text="MENSAJE A LA CONGREGACIÓN"
                                   TextColor="#80C4FF"
                                   FontAttributes="Bold"
                                   FontSize="12" />

                            <Label Text="Asunto"
                                   TextColor="#9EA4AE"
                                   FontSize="10" />

                            <Entry x:Name="TxtAsuntoS303"
                                   TextColor="White"
                                   BackgroundColor="#1A1D22" />

                            <Label Text="Mensaje (HTML mostrado como texto limpio)"
                                   TextColor="#9EA4AE"
                                   FontSize="10" />

                            <Editor x:Name="TxtCuerpoS303"
                                    TextColor="White"
                                    BackgroundColor="#1A1D22"
                                    MinimumHeightRequest="130"
                                    AutoSize="TextChanges" />

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <Label Text="Copia a SRV"
                                       TextColor="#B6BBC2"
                                       VerticalTextAlignment="Center" />
                                <Switch x:Name="ChkCopiaSRV"
                                        Grid.Column="1" />
                            </Grid>

                            <Button Text="Preparar correo con S-303 y S-2"
                                    Clicked="BtnEnviarS303_Clicked"
                                    BackgroundColor="#2478B5"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="9" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="OverlayCargando"
              Grid.RowSpan="3"
              BackgroundColor="#C0101216"
              IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   Color="#4BA3E3"
                                   WidthRequest="42"
                                   HeightRequest="42" />
                <Label x:Name="LblCargando"
                       Text="Cargando visita..."
                       TextColor="White"
                       FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
