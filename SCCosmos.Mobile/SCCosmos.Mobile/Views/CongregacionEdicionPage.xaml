<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.CongregacionEdicionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Congregación"
    BackgroundColor="{StaticResource FondoPagina}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16,20,24"
                                 Spacing="16">

                <Border BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="DATOS DE LA CONGREGACIÓN"
                               Style="{StaticResource Antetitulo}"
                               CharacterSpacing="1" />

                        <Label Text="Código"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtCodigo"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Nombre"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtNombre"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Email"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtEmail"
                               Keyboard="Email"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Sección"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Picker x:Name="PickerSeccion"
                                Title="(Sin sección)"
                                TextColor="{StaticResource TextoPrincipal}"
                                ItemDisplayBinding="{Binding Nombre}" />

                        <Label Text="Provincia"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtProvincia"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Municipio"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtMunicipio"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Dirección del Salón"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtDireccion"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="ID de Zoom"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtIdZoom"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Contraseña de Zoom"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtClaveZoom"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Email del AV"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtEmailAV"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="5">
                                <Label Text="Día entre semana"
                                       TextColor="{StaticResource TextoTerciario}"
                                       FontSize="12" />
                                <Entry x:Name="TxtDiaEntre"
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="5">
                                <Label Text="Hora entre semana"
                                       TextColor="{StaticResource TextoTerciario}"
                                       FontSize="12" />
                                <Entry x:Name="TxtHoraEntre"
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="5">
                                <Label Text="Día fin de semana"
                                       TextColor="{StaticResource TextoTerciario}"
                                       FontSize="12" />
                                <Entry x:Name="TxtDiaFin"
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="5">
                                <Label Text="Hora fin de semana"
                                       TextColor="{StaticResource TextoTerciario}"
                                       FontSize="12" />
                                <Entry x:Name="TxtHoraFin"
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="5">
                                <Label Text="Capacidad"
                                       TextColor="{StaticResource TextoTerciario}"
                                       FontSize="12" />
                                <Entry x:Name="TxtCapacidad"
                                       Keyboard="Numeric"
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="5">
                                <Label Text="Población"
                                       TextColor="{StaticResource TextoTerciario}"
                                       FontSize="12" />
                                <Entry x:Name="TxtPoblacion"
                                       Keyboard="Numeric"
                                       TextColor="{StaticResource TextoPrincipal}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Button x:Name="BtnEliminar"
                        Text="Eliminar congregación"
                        Clicked="BtnEliminar_Clicked"
                        BackgroundColor="{StaticResource PeligroSuave}"
                        TextColor="#FFB7BC"
                        CornerRadius="10"
                        HeightRequest="48"
                        IsVisible="False" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Padding="18,10,18,16"
              BackgroundColor="{StaticResource Superficie}">

            <Button Grid.Column="0"
                    Text="Cancelar"
                    BackgroundColor="#30343B"
                    Clicked="BtnCancelar_Clicked" />

            <Button Grid.Column="1"
                    Text="Guardar"
                    BackgroundColor="{StaticResource AcentoFuerte}"
                    TextColor="{StaticResource TextoPrincipal}"
                    FontAttributes="Bold"
                    Clicked="BtnGuardar_Clicked" />

        </Grid>

    </Grid>
</ContentPage>
