<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.TerritorioEdicionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Territorio"
    BackgroundColor="{StaticResource FondoPagina}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16,20,24"
                                 Spacing="16">

                <Border BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="TERRITORIO"
                               Style="{StaticResource Antetitulo}"
                               CharacterSpacing="1" />

                        <Label x:Name="LblNombre"
                               TextColor="{StaticResource TextoPrincipal}"
                               FontSize="17"
                               FontAttributes="Bold" />

                        <Label x:Name="LblEstado"
                               TextColor="{StaticResource TextoSecundario}"
                               FontSize="13" />

                        <Label Text="Vincular a publicador"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12"
                               Margin="0,6,0,0" />

                        <Picker x:Name="PickerPersona"
                                Title="Selecciona un publicador"
                                TextColor="{StaticResource TextoPrincipal}"
                                ItemDisplayBinding="{Binding NombreMostrarTabla}"
                                SelectedIndexChanged="PickerPersona_SelectedIndexChanged" />

                        <Label Text="Nombre vinculado"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />

                        <Entry x:Name="TxtVinculado"
                               Placeholder="Nombre a vincular (o vacío para quitar)"
                               TextColor="{StaticResource TextoPrincipal}" />

                    </VerticalStackLayout>
                </Border>

                <Button x:Name="BtnEliminar"
                        Text="Eliminar registro de territorio"
                        Clicked="BtnEliminar_Clicked"
                        BackgroundColor="{StaticResource PeligroSuave}"
                        TextColor="#FFB7BC"
                        CornerRadius="10"
                        HeightRequest="48" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Padding="18,10,18,16"
              BackgroundColor="{StaticResource Superficie}">

            <Button Grid.Column="0"
                    Text="Cancelar"
                    BackgroundColor="#30343B"
                    Clicked="BtnCancelar_Clicked" />

            <Button Grid.Column="1"
                    Text="Guardar"
                    BackgroundColor="{StaticResource AcentoFuerte}"
                    TextColor="{StaticResource TextoPrincipal}"
                    FontAttributes="Bold"
                    Clicked="BtnGuardar_Clicked" />

        </Grid>

    </Grid>
</ContentPage>
