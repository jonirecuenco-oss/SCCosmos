<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.CalendarioPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Calendario"
    BackgroundColor="#101216">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="BtnCiclo"
                     Text="🔄"
                     Order="Primary"
                     Priority="0"
                     Clicked="BtnConfigurarCiclo_Clicked" />
        <ToolbarItem x:Name="BtnVista"
                     Text="📅"
                     Order="Primary"
                     Priority="1"
                     Clicked="BtnCambiarVista_Clicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="0,6,0,10"
          RowSpacing="8">

        <!-- El título ya está en la barra superior; «Ciclo» va en la barra
             (icono arriba a la derecha) y «Hoy» es el botón flotante. -->

        <!-- LISTADO -->
        <RefreshView x:Name="RefrescarCalendario"
                     Grid.Row="2"
                     Refreshing="RefrescarCalendario_Refreshing">

            <CollectionView x:Name="ListaCalendario"
                            MaximumWidthRequest="820"
                            HorizontalOptions="Center"
                            IsGrouped="True"
                            SelectionMode="None"
                            Scrolled="ListaCalendario_Scrolled"
                            VerticalScrollBarVisibility="Default">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20,50"
                                         HorizontalOptions="Center"
                                         Spacing="8">
                        <Label Text="No hay semanas para mostrar."
                               TextColor="#9EA4AE"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Grid BackgroundColor="#1B2433"
                              Padding="16,9"
                              Margin="0,12,0,6">
                            <Label Text="{Binding Titulo}"
                                   FontSize="12.5"
                                   FontAttributes="Bold"
                                   TextColor="#9CC3F5"
                                   CharacterSpacing="1.4"
                                   HorizontalTextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{Binding Fondo}"
                                Stroke="{Binding Borde}"
                                StrokeThickness="{Binding GrosorBorde}"
                                Padding="13,5,13,5"
                                Margin="16,0,16,8">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="TarjetaSemana_Tapped"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="2">

                                <!-- FECHAS -->
                                <VerticalStackLayout Grid.Row="0"
                                                     Grid.Column="0"
                                                     Spacing="1">
                                    <Label Text="{Binding RangoFechas}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="White" />
                                    <Label Text="{Binding MarcadorParalela}"
                                           FontSize="11"
                                           TextColor="#9EA4AE"
                                           IsVisible="{Binding EsActividadParalela}" />
                                </VerticalStackLayout>

                                <!-- ACTIVIDAD -->
                                <Label Grid.Row="1"
                                       Text="{Binding ActividadVisual}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{Binding ColorActividad}" />

                                <!-- CONGREGACIÓN / ASAMBLEA -->
                                <Label Grid.Row="2"
                                       Text="{Binding DetallePrincipal}"
                                       FontSize="14"
                                       TextColor="#E7E9EC"
                                       IsVisible="{Binding MostrarDetallePrincipal}"
                                       LineBreakMode="WordWrap" />

                                <!-- TIPO / ACOMPAÑANTE / ALOJAMIENTO -->
                                <Label Grid.Row="3"
                                       Text="{Binding DetalleSecundario}"
                                       FontSize="12"
                                       TextColor="#AEB4BC"
                                       IsVisible="{Binding MostrarDetalleSecundario}"
                                       LineBreakMode="WordWrap" />

                                <!-- ACCIONES (una sola fila compacta abajo) -->
                                <HorizontalStackLayout Grid.Row="4"
                                                       Grid.ColumnSpan="2"
                                                       Spacing="7"
                                                       Margin="0,3,0,0">

                                    <Button Text="✏️"
                                            Clicked="BtnEditar_Clicked"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Editar semana"
                                            Padding="0"
                                            Margin="0"
                                            FontSize="11"
                                            WidthRequest="26"
                                            HeightRequest="24"
                                            BackgroundColor="#242830"
                                            CornerRadius="7"
                                            IsVisible="{Binding MostrarBotonEditar}" />

                                    <Button Text="👁️"
                                            Clicked="BtnVerVisita_Clicked"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Ver visita"
                                            Padding="0"
                                            Margin="0"
                                            FontSize="11"
                                            WidthRequest="26"
                                            HeightRequest="24"
                                            BackgroundColor="#0B6FC2"
                                            CornerRadius="7"
                                            IsVisible="{Binding MostrarVerVisita}" />

                                    <Button Text="📨"
                                            Clicked="BtnAcciones_Clicked"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Acciones de la semana"
                                            Padding="0"
                                            Margin="0"
                                            FontSize="11"
                                            WidthRequest="26"
                                            HeightRequest="24"
                                            BackgroundColor="#3A3520"
                                            CornerRadius="7"
                                            IsVisible="{Binding MostrarBotonAcciones}" />

                                    <Button Text="🗂️"
                                            Clicked="BtnImportarJson_Clicked"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Importar o actualizar JSON"
                                            Padding="0"
                                            Margin="0"
                                            FontSize="11"
                                            WidthRequest="26"
                                            HeightRequest="24"
                                            BackgroundColor="#265B36"
                                            CornerRadius="7"
                                            IsVisible="{Binding MostrarBotonImportarJson}" />

                                    <Button Text="➕"
                                            Clicked="BtnSolapar_Clicked"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Añadir actividad"
                                            Padding="0"
                                            Margin="0"
                                            FontSize="11"
                                            WidthRequest="26"
                                            HeightRequest="24"
                                            BackgroundColor="#163553"
                                            CornerRadius="7"
                                            IsVisible="{Binding MostrarBotonSolapar}" />

                                    <Button Text="🗑️"
                                            Clicked="BtnEliminar_Clicked"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="Eliminar actividad"
                                            Padding="0"
                                            Margin="0"
                                            FontSize="11"
                                            WidthRequest="26"
                                            HeightRequest="24"
                                            BackgroundColor="#3A2023"
                                            CornerRadius="7"
                                            IsVisible="{Binding MostrarBotonEliminar}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- VISTA DE CALENDARIO (MES) -->
        <VerticalStackLayout x:Name="PanelCalendario"
                             Grid.Row="2"
                             IsVisible="False"
                             Spacing="14">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="8">

                <Button Text="◀"
                        Clicked="BtnMesAnterior_Clicked"
                        FontSize="16"
                        Padding="12,4"
                        BackgroundColor="#242830"
                        TextColor="#4BA3E3"
                        CornerRadius="10"/>

                <Label x:Name="LblMesCalendario"
                       Grid.Column="1"
                       Text=""
                       TextColor="White"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>

                <Button Grid.Column="2"
                        Text="▶"
                        Clicked="BtnMesSiguiente_Clicked"
                        FontSize="16"
                        Padding="12,4"
                        BackgroundColor="#242830"
                        TextColor="#4BA3E3"
                        CornerRadius="10"/>
            </Grid>

            <Grid x:Name="GridMesCalendario"
                  ColumnSpacing="4"
                  RowSpacing="4"/>

        </VerticalStackLayout>

        <!-- OVERLAY -->
        <Grid x:Name="OverlayCargando"
              Grid.RowSpan="4"
              BackgroundColor="#B8101216"
              IsVisible="False"
              InputTransparent="False">
            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   Color="#4BA3E3"
                                   WidthRequest="42"
                                   HeightRequest="42" />
                <Label x:Name="LblCargando"
                       Text="Cargando calendario..."
                       TextColor="White"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- BOTÓN FLOTANTE: HOY (por encima de la lista) -->
        <Button x:Name="BtnHoy"
                Grid.Row="2"
                Text="Hoy"
                Clicked="BtnHoy_Clicked"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,18,16"
                BackgroundColor="#0B6FC2"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="13"
                CornerRadius="22"
                HeightRequest="44"
                Padding="18,0">
            <Button.Shadow>
                <Shadow Brush="#000000"
                        Opacity="0.4"
                        Radius="8"
                        Offset="0,3" />
            </Button.Shadow>
        </Button>

    </Grid>
</ContentPage>
