<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SCCosmos.Mobile.Views.InicioPage"
    Title="Inicio"
    BackgroundColor="{StaticResource FondoPagina}">

    <ContentPage.ToolbarItems>
    </ContentPage.ToolbarItems>

    <ScrollView>

        <VerticalStackLayout
            Padding="20,18,20,35"
            Spacing="20">

            <!-- SALUDO -->

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">

                <VerticalStackLayout Grid.Column="0"
                                     Spacing="2">

                    <Label
                        x:Name="TxtSaludo"
                        Text="¡Hola!"
                        TextColor="{StaticResource TextoPrincipal}"
                        FontSize="29"
                        FontAttributes="Bold"/>

                </VerticalStackLayout>

                <Border x:Name="PanelCampana"
                        Grid.Column="1"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        Padding="9,6"
                        VerticalOptions="Start"
                        Margin="0,4,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Campana_Tapped"/>
                    </Border.GestureRecognizers>
                    <Grid>
                        <Label
                            x:Name="LblCampana"
                            Text="🔕"
                            FontSize="20"
                            Opacity="0.45"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center"/>
                        <Border
                            x:Name="BadgeCampana"
                            IsVisible="False"
                            BackgroundColor="#FFB900"
                            StrokeThickness="0"
                            Padding="5,0"
                            MinimumHeightRequest="16"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,-2,-4,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label
                                x:Name="LblCampanaNumero"
                                Text="0"
                                TextColor="#1A1D22"
                                FontSize="10"
                                FontAttributes="Bold"/>
                        </Border>
                    </Grid>
                </Border>

            </Grid>


            <Border
                BackgroundColor="{StaticResource Superficie}"
                Stroke="{StaticResource Borde}"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Grid
                        ColumnDefinitions="*,Auto">

                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="3">

                            <Label
                                x:Name="LblTipoSemana"
                                Text="Actividad"
                                Style="{StaticResource Antetitulo}"/>

                            <Label
                                x:Name="LblActividad"
                                Text="Cargando..."
                                TextColor="{StaticResource TextoPrincipal}"
                                FontSize="22"
                                FontAttributes="Bold"/>

                        </VerticalStackLayout>

                        <Border
                            x:Name="MarcoIconoSemana"
                            Grid.Column="1"
                            BackgroundColor="{StaticResource SuperficieAlta}"
                            Padding="11"
                            StrokeThickness="0">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Label
                                x:Name="LblIconoSemana"
                                Text="●"
                                TextColor="{StaticResource Acento}"
                                FontSize="20"/>

                        </Border>

                        <Button
                            x:Name="BtnVerVisitaSemana"
                            Grid.Column="1"
                            Text="👁️"
                            SemanticProperties.Description="Ver visita"
                            Clicked="BtnVerVisitaInicio_Click"
                            BackgroundColor="#0B6FC2"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="20"
                            CornerRadius="9"
                            WidthRequest="54"
                            HeightRequest="44"
                            Padding="0"
                            IsVisible="False"
                            VerticalOptions="Center"/>

                    </Grid>

                    <Label
                        x:Name="LblFechas"
                        Text=""
                        TextColor="{StaticResource TextoSecundario}"
                        FontSize="14"/>

                    <!-- VISITA -->

                    <VerticalStackLayout
                        x:Name="PanelVisita"
                        IsVisible="False"
                        Spacing="7">

                        <Label
                            x:Name="LblAcompanante"
                            Text=""
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="14"
                            IsVisible="False"/>

                    </VerticalStackLayout>

                    <!-- OTRA ACTIVIDAD -->

                    <VerticalStackLayout
                        x:Name="PanelOtraActividad"
                        IsVisible="False"
                        Spacing="5">

                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource Borde}"/>

                        <Label
                            x:Name="LblOtraActividad"
                            Text=""
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="15"
                            Margin="0,6,0,0"/>

                    </VerticalStackLayout>

                    <!-- PRÓXIMA ACTIVIDAD (enlace al calendario) -->

                    <Label
                        x:Name="LblProximaActividad"
                        Text=""
                        TextColor="#80C4FF"
                        FontSize="13.5"
                        TextDecorations="Underline"
                        LineBreakMode="WordWrap"
                        IsVisible="False">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Tapped="ProximaActividad_Tapped"/>
                        </Label.GestureRecognizers>

                    </Label>

                    <!-- SIN DATOS -->

                    <Label
                        x:Name="TxtSinDatos"
                        Text="No hay ninguna actividad registrada para esta semana."
                        TextColor="{StaticResource TextoSecundario}"
                        FontSize="14"
                        IsVisible="False"/>

                </VerticalStackLayout>

            </Border>


            <!-- HORAS PREDICADAS -->
            <Border
                BackgroundColor="{StaticResource Superficie}"
                Stroke="{StaticResource Borde}"
                StrokeThickness="1"
                Padding="18">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="2">

                        <Label
                            Text="PREDICACIÓN ESTE MES"
                            TextColor="{StaticResource TextoTerciario}"
                            FontSize="12"
                            FontAttributes="Bold"
                            CharacterSpacing="1.5"/>

                        <Label
                            x:Name="LblHorasMes"
                            Text="0"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="30"
                            FontAttributes="Bold"/>

                        <Label
                            x:Name="LblHorasMesEtiqueta"
                            Text=""
                            TextColor="{StaticResource TextoTerciario}"
                            FontSize="12"/>
                    </VerticalStackLayout>

                    <Button
                        Grid.Column="1"
                        Text="+"
                        Clicked="BtnSumarHoras_Clicked"
                        SemanticProperties.Description="Añadir horas"
                        FontSize="20"
                        FontAttributes="Bold"
                        WidthRequest="54"
                        HeightRequest="44"
                        Padding="0"
                        BackgroundColor="#0B6FC2"
                        TextColor="{StaticResource TextoPrincipal}"
                        CornerRadius="12"
                        VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- PROGRAMA DE HOY -->

            <VerticalStackLayout
                x:Name="PanelProgramaDia"
                IsVisible="False"
                Spacing="11">

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="6">

                    <Button
                        Text="◀"
                        Clicked="BtnDiaAnterior_Clicked"
                        SemanticProperties.Description="Día anterior"
                        Padding="10,2"
                        FontSize="14"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        TextColor="{StaticResource Acento}"
                        CornerRadius="8"
                        VerticalOptions="Center"/>

                    <Label
                        x:Name="LblDiaPrograma"
                        Grid.Column="1"
                        Text="HOY"
                        TextColor="{StaticResource TextoTerciario}"
                        FontSize="12"
                        FontAttributes="Bold"
                        CharacterSpacing="1.5"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"/>

                    <Button
                        Grid.Column="2"
                        Text="▶"
                        Clicked="BtnDiaSiguiente_Clicked"
                        SemanticProperties.Description="Día siguiente"
                        Padding="10,2"
                        FontSize="14"
                        BackgroundColor="{StaticResource SuperficieAlta}"
                        TextColor="{StaticResource Acento}"
                        CornerRadius="8"
                        VerticalOptions="Center"/>
                </Grid>

                <Label
                    x:Name="TxtSinProgramaDia"
                    Text="No hay actividades programadas para este día."
                    TextColor="{StaticResource TextoTerciario}"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    Margin="0,4,0,6"
                    IsVisible="False"/>

                <Border
                    x:Name="MarcoListaProgramaDia"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    StrokeThickness="1"
                    Padding="6">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout
                        x:Name="ListaProgramaHoy"
                        BindableLayout.ItemsSource="{Binding ProgramaHoy}">

                        <BindableLayout.ItemTemplate>

                            <DataTemplate>

                                <Grid
                                    Padding="12"
                                    ColumnDefinitions="62,*,Auto,Auto"
                                    RowDefinitions="Auto,Auto,Auto"
                                    ColumnSpacing="8"
                                    RowSpacing="2">

                                    <Label
                                        Grid.RowSpan="3"
                                        Text="{Binding Hora}"
                                        TextColor="{StaticResource Acento}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        VerticalOptions="Start"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding TipoActividad}"
                                        TextColor="{StaticResource TextoPrincipal}"
                                        FontSize="15"
                                        FontAttributes="Bold"/>

                                    <Border
                                        Grid.Column="2"
                                        Grid.RowSpan="2"
                                        BackgroundColor="{StaticResource SuperficieAlta}"
                                        Padding="8,3"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        IsVisible="{Binding MostrarResponsable}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>
                                        <Label
                                            Text="{Binding Responsable}"
                                            TextColor="#EBCB8B"
                                            FontSize="11.5"
                                            FontAttributes="Bold"/>
                                    </Border>

                                    <HorizontalStackLayout
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Spacing="10">
                                        <Label
                                            Text="{Binding CompaneroNombre, StringFormat='con {0}'}"
                                            TextColor="{StaticResource TextoTerciario}"
                                            FontSize="13"
                                            IsVisible="{Binding VerCompanero}"/>
                                        <Label
                                            Text="{Binding TiempoCocheTexto}"
                                            TextColor="#8BC9E8"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            IsVisible="{Binding VerTiempoCoche}"/>
                                    </HorizontalStackLayout>

                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding Notas}"
                                        TextColor="{StaticResource TextoTerciario}"
                                        FontSize="12.5"
                                        LineBreakMode="WordWrap"
                                        IsVisible="{Binding MostrarNotas}"/>

                                    <Button
                                        Grid.Column="3"
                                        Grid.RowSpan="3"
                                        IsVisible="{Binding MostrarMapa}"
                                        Text="📍"
                                        Clicked="BtnMapaActividadInicio_Clicked"
                                        CommandParameter="{Binding .}"
                                        SemanticProperties.Description="Ver en Google Maps"
                                        FontSize="15"
                                        Padding="9,4"
                                        BackgroundColor="{StaticResource SuperficieAlta}"
                                        TextColor="#8BC9E8"
                                        CornerRadius="10"
                                        VerticalOptions="Center"/>

                                </Grid>

                            </DataTemplate>

                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>


            <!-- ESTADÍSTICAS -->

            <Label
                Text="RESUMEN DEL CIRCUITO"
                TextColor="{StaticResource TextoTerciario}"
                FontSize="12"
                FontAttributes="Bold"
                CharacterSpacing="1.5"
                Margin="0,5,0,0"/>

            <Grid
                x:Name="GridEstadisticas"
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <!-- PREC REG -->

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
            Tapped="TarjetaEstadistica_Tapped"
            CommandParameter="Servicio|Precursor regular"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="P. regulares"
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="13"/>
                        <Label
                            x:Name="TxtTotalPrecReg"
                            Text="—"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="27"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>

                </Border>

                <!-- PREC ESP -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
        Tapped="TarjetaEstadistica_Tapped"
        CommandParameter="Servicio|Precursor especial"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="P. especiales"
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="13"/>
                        <Label
                            x:Name="TxtTotalPrecEsp"
                            Text="—"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="27"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>

                </Border>

                <!-- ANCIANOS -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    Padding="16">
                    

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
        Tapped="TarjetaEstadistica_Tapped"
        CommandParameter="Nombramiento|Anciano"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Ancianos"
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="13"/>
                        <Label
                            x:Name="TxtTotalAncianos"
                            Text="—"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="27"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>

                </Border>

                <!-- SIERVOS -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
        Tapped="TarjetaEstadistica_Tapped"
        CommandParameter="Nombramiento|Siervo ministerial"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Siervos M."
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="13"/>
                        <Label
                            x:Name="TxtTotalSM"
                            Text="—"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="27"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>

                </Border>

                <!-- A2 -->

                <Border
                    Grid.Row="2"
                    Grid.Column="0"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
        Tapped="TarjetaEstadistica_Tapped"
        CommandParameter="Solicitud|A-2"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Sol. A-2"
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="13"/>
                        <Label
                            x:Name="TxtTotalA2"
                            Text="—"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="27"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>

                </Border>

                <!-- A19 -->

                <Border
                    Grid.Row="2"
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
        Tapped="TarjetaEstadistica_Tapped"
        CommandParameter="Solicitud|A-19"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Sol. A-19"
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="13"/>
                        <Label
                            x:Name="TxtTotalA19"
                            Text="—"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="27"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>

                </Border>

                <!-- A8 -->

                <Border
                    Grid.Row="3"
                    Grid.Column="0"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
        Tapped="TarjetaEstadistica_Tapped"
        CommandParameter="Solicitud|A-8"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Sol. A-8"
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="13"/>
                        <Label
                            x:Name="TxtTotalA8"
                            Text="—"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="27"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>

                </Border>

                <!-- G8 -->

                <Border
                    Grid.Row="3"
                    Grid.Column="1"
                    BackgroundColor="{StaticResource Superficie}"
                    Stroke="{StaticResource Borde}"
                    Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
        Tapped="TarjetaEstadistica_Tapped"
        CommandParameter="Solicitud|G-8"/>
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Sol. G-8"
                            TextColor="{StaticResource TextoSecundario}"
                            FontSize="13"/>
                        <Label
                            x:Name="TxtTotalG8"
                            Text="—"
                            TextColor="{StaticResource TextoPrincipal}"
                            FontSize="27"
                            FontAttributes="Bold"/>
                    </VerticalStackLayout>

                </Border>

                <!-- PUBLICADORES -->
                <Border Grid.Row="4" Grid.Column="0"
                        BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Publicadores" TextColor="{StaticResource TextoSecundario}" FontSize="13"/>
                        <Label x:Name="TxtTotalPublicadores" Text="—" TextColor="{StaticResource TextoPrincipal}" FontSize="27" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- HOMBRES -->
                <Border Grid.Row="4" Grid.Column="1"
                        BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Hombres" TextColor="{StaticResource TextoSecundario}" FontSize="13"/>
                        <Label x:Name="TxtTotalHombres" Text="—" TextColor="{StaticResource TextoPrincipal}" FontSize="27" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- MUJERES -->
                <Border Grid.Row="5" Grid.Column="0"
                        BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Mujeres" TextColor="{StaticResource TextoSecundario}" FontSize="13"/>
                        <Label x:Name="TxtTotalMujeres" Text="—" TextColor="{StaticResource TextoPrincipal}" FontSize="27" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- NO BAUTIZADOS -->
                <Border Grid.Row="5" Grid.Column="1"
                        BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="No bautizados" TextColor="{StaticResource TextoSecundario}" FontSize="13"/>
                        <Label x:Name="TxtTotalNoBautizados" Text="—" TextColor="{StaticResource TextoPrincipal}" FontSize="27" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- CURSOS -->
                <Border Grid.Row="6" Grid.Column="0"
                        BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Cursos bíblicos" TextColor="{StaticResource TextoSecundario}" FontSize="13"/>
                        <Label x:Name="TxtTotalCursos" Text="—" TextColor="{StaticResource TextoPrincipal}" FontSize="27" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- MEDIA EDAD -->
                <Border Grid.Row="6" Grid.Column="1"
                        BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Media de edad" TextColor="{StaticResource TextoSecundario}" FontSize="13"/>
                        <Label x:Name="TxtMediaEdad" Text="—" TextColor="{StaticResource TextoPrincipal}" FontSize="27" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- MEDIA PREC AUX -->
                <Border Grid.Row="7" Grid.Column="0"
                        BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Media prec. auxiliares" TextColor="{StaticResource TextoSecundario}" FontSize="13"/>
                        <Label x:Name="TxtMediaPrecAux" Text="—" TextColor="{StaticResource TextoPrincipal}" FontSize="27" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

                <!-- BETEL -->
                <Border Grid.Row="7" Grid.Column="1"
                        BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Betel" TextColor="{StaticResource TextoSecundario}" FontSize="13"/>
                        <Label x:Name="TxtTotalBetel" Text="—" TextColor="{StaticResource TextoPrincipal}" FontSize="27" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Label
                x:Name="LblError"
                Text=""
                TextColor="#FF7070"
                FontSize="13"
                IsVisible="False"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>