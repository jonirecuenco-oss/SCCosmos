<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.EscuelaTalleresPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Talleres"
    BackgroundColor="#101216">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0"
                             Padding="20,14,20,8"
                             Spacing="6">

            <Label Text="TALLERES"
                   Style="{StaticResource Antetitulo}" />

            <Label x:Name="LblSubtitulo"
                   Text=""
                   Style="{StaticResource TextoNota}" />

            <Button x:Name="BtnPdfTalleres"
                    Text="PDF de los talleres"
                    Clicked="BtnPdfTalleres_Clicked"
                    Style="{StaticResource BotonSecundario}"
                    HeightRequest="42"
                    FontSize="13.5"
                    Margin="0,4,0,0" />

        </VerticalStackLayout>

        <ScrollView Grid.Row="1"
                    Padding="20,4,20,20">

            <VerticalStackLayout x:Name="PanelTalleres"
                                 Spacing="8" />

        </ScrollView>

    </Grid>
</ContentPage>
