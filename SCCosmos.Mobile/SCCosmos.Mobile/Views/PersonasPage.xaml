<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SCCosmos.Mobile.Converters"
    x:Class="SCCosmos.Mobile.Views.PersonasPage"
    Title="Personas"
    BackgroundColor="#101216">

    <ContentPage.Resources>

        <converters:Base64ImageConverter
            x:Key="Base64ImageConverter"/>

    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Nombramientos"
            Clicked="BtnNombramientos_Click"/>
    </ContentPage.ToolbarItems>


    <Grid
        RowDefinitions="Auto,Auto,Auto,*"
        Padding="18,16,18,0">


        <!-- ================================================= -->
        <!-- CABECERA -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="0"
            RowDefinitions="Auto,Auto,Auto,Auto,Auto"
            RowSpacing="8"
            Margin="2,0,2,12">


            <!-- ================================================= -->
            <!-- TÍTULO Y FILTROS -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="0"
                ColumnDefinitions="*,Auto">

                <VerticalStackLayout
                    Spacing="2">

                    <Label
                        Text="Personas"
                        TextColor="{StaticResource TextoPrincipal}"
                        FontSize="26"
                        FontAttributes="Bold"/>

                    <Label
                        x:Name="LblTotal"
                        Text="Cargando..."
                        TextColor="{StaticResource TextoSecundario}"
                        FontSize="12.5"/>

                </VerticalStackLayout>


                <Button
                    Grid.Column="1"
                    Text="Filtros"
                    Style="{StaticResource BotonSecundario}"
                    HeightRequest="40"
                    Padding="14,6"
                    FontSize="12.5"
                    VerticalOptions="Center"
                    Clicked="BtnFiltros_Click"/>

            </Grid>


            <!-- ================================================= -->
            <!-- SINCRONIZADOR -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,Auto"
                ColumnSpacing="8">

                <Button
                    x:Name="BtnSintonizarHub"
                    Grid.Column="0"
                    Text="Sincronizar JW Hub"
                    HeightRequest="46"
                    BackgroundColor="#2478B5"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Clicked="BtnSintonizarHub_Click"/>


                <Button
                    x:Name="BtnCancelarHub"
                    Grid.Column="1"
                    Text="Cancelar"
                    HeightRequest="46"
                    BackgroundColor="#6A3030"
                    TextColor="White"
                    CornerRadius="8"
                    IsVisible="False"
                    Clicked="BtnCancelarHub_Click"/>

            </Grid>


            <!-- ================================================= -->
            <!-- REVISAR RESULTADOS -->
            <!--
                Va en una fila independiente.

                Así nunca se superpone con el botón
                "Sincronizar JW Hub".
            -->
            <!-- ================================================= -->

            <Button
                x:Name="BtnRevisarHub"
                Grid.Row="2"
                Text="Revisar resultados JW Hub"
                HeightRequest="44"
                BackgroundColor="#315A3A"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                IsVisible="False"
                Clicked="BtnRevisarHub_Clicked"/>


            <!-- ================================================= -->
            <!-- PROGRESO -->
            <!-- ================================================= -->

            <ProgressBar
                x:Name="ProgresoHub"
                Grid.Row="3"
                Progress="0"
                IsVisible="False"
                HeightRequest="5"/>


            <!-- ================================================= -->
            <!-- ESTADO -->
            <!-- ================================================= -->

            <Label
                x:Name="LblEstadoHub"
                Grid.Row="4"
                Text=""
                TextColor="#9EA4AE"
                FontSize="12"
                LineBreakMode="WordWrap"
                IsVisible="False"/>

        </Grid>


        <!-- ================================================= -->
        <!-- BUSCADOR -->
        <!-- ================================================= -->

        <SearchBar
            Grid.Row="1"
            x:Name="TxtBuscar"
            Placeholder="Buscar persona..."
            TextChanged="TxtBuscar_TextChanged"
            TextColor="White"
            PlaceholderColor="#777E89"
            CancelButtonColor="#4BA3E3"
            BackgroundColor="#1A1E24"
            Margin="0,0,0,10"/>


        <!-- ================================================= -->
        <!-- FILTRO ACTIVO -->
        <!-- ================================================= -->

        <Border
            Grid.Row="2"
            x:Name="PanelFiltroActivo"
            IsVisible="False"
            BackgroundColor="#192B3A"
            Stroke="#295A7A"
            Padding="12,8"
            Margin="0,0,0,10">

            <Border.StrokeShape>
                <RoundRectangle
                    CornerRadius="12"/>
            </Border.StrokeShape>


            <Grid
                ColumnDefinitions="*,Auto">

                <Label
                    x:Name="LblFiltroActivo"
                    Text=""
                    TextColor="#A9D8F7"
                    FontSize="13"
                    VerticalOptions="Center"/>


                <Button
                    Grid.Column="1"
                    Text="✕"
                    FontSize="13"
                    Padding="8,2"
                    BackgroundColor="Transparent"
                    TextColor="#A9D8F7"
                    Clicked="BtnQuitarFiltro_Click"/>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- LISTA -->
        <!-- ================================================= -->

        <RefreshView
            Grid.Row="3"
            x:Name="RefrescarLista"
            Refreshing="RefrescarLista_Refreshing">

            <CollectionView
                x:Name="ListaPersonas"
                SelectionMode="None"
                ItemsLayout="VerticalList"
                EmptyView="No se encontraron personas.">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            BackgroundColor="{StaticResource Superficie}"
                            Stroke="{StaticResource Borde}"
                            StrokeThickness="1"
                            Padding="14"
                            Margin="0,0,0,10">

                            <Border.StrokeShape>
                                <RoundRectangle
                                    CornerRadius="17"/>
                            </Border.StrokeShape>


                            <Border.GestureRecognizers>

                                <TapGestureRecognizer
                                    Tapped="Persona_Tapped"
                                    CommandParameter="{Binding .}"/>

                            </Border.GestureRecognizers>


                            <Grid
                                ColumnDefinitions="58,*,Auto"
                                RowDefinitions="Auto">


                                <!-- FOTO -->

                                <Border
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    BackgroundColor="#272D36"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">

                                    <Border.StrokeShape>
                                        <RoundRectangle
                                            CornerRadius="24"/>
                                    </Border.StrokeShape>


                                    <Grid>

                                        <Label
                                            Text="👤"
                                            FontSize="21"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"/>


                                        <Image
                                            Source="{Binding Foto,
                                                Converter={StaticResource Base64ImageConverter}}"
                                            Aspect="AspectFill"
                                            WidthRequest="48"
                                            HeightRequest="48"/>

                                    </Grid>

                                </Border>


                                <!-- DATOS -->

                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="3"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding NombreMostrarTabla}"
                                        TextColor="White"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"/>


                                    <Label
                                        Text="{Binding CongregacionNombre}"
                                        TextColor="#9299A3"
                                        FontSize="13"
                                        LineBreakMode="TailTruncation"/>


                                    <HorizontalStackLayout
                                        Spacing="8">

                                        <Label
                                            Text="{Binding Nombramiento}"
                                            TextColor="#4BA3E3"
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"/>


                                        <Label
                                            Text="{Binding Servicio}"
                                            TextColor="#AAB0B9"
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"/>

                                    </HorizontalStackLayout>


                                    <Label
                                        Text="{Binding Solicitudes}"
                                        TextColor="#C1A765"
                                        FontSize="11"
                                        LineBreakMode="TailTruncation"/>

                                </VerticalStackLayout>


                                <Label
                                    Grid.Column="2"
                                    Text="›"
                                    TextColor="#6E7682"
                                    FontSize="30"
                                    VerticalOptions="Center"
                                    Margin="8,0,0,0"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>