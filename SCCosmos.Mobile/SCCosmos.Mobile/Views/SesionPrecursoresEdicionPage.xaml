<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.SesionPrecursoresEdicionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sesión de precursores"
    BackgroundColor="{StaticResource FondoPagina}">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16,20,24"
                                 Spacing="14">

                <Border BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">

                        <Label Text="SESIÓN"
                               Style="{StaticResource Antetitulo}"
                               CharacterSpacing="1" />

                        <Label Text="Número"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtNumero"
                               Keyboard="Numeric"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Fecha"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtFecha"
                               Placeholder="dd/MM/aaaa"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Hora"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtHora"
                               Placeholder="16:00"
                               TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Congregaciones"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Editor x:Name="TxtCongregaciones"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="70"
                                TextColor="{StaticResource TextoPrincipal}" />

                        <Label Text="Lugar"
                               TextColor="{StaticResource TextoTerciario}"
                               FontSize="12" />
                        <Entry x:Name="TxtLugar"
                               TextColor="{StaticResource TextoPrincipal}" />

                    </VerticalStackLayout>
                </Border>

                <Button x:Name="BtnEliminar"
                        Text="Eliminar sesión"
                        Clicked="BtnEliminar_Clicked"
                        BackgroundColor="{StaticResource PeligroSuave}"
                        TextColor="#FFB7BC"
                        CornerRadius="10"
                        HeightRequest="48"
                        IsVisible="False" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Padding="18,10,18,16"
              BackgroundColor="{StaticResource Superficie}">

            <Button Grid.Column="0"
                    Text="Cancelar"
                    BackgroundColor="#30343B"
                    Clicked="BtnCancelar_Clicked" />

            <Button Grid.Column="1"
                    Text="Guardar"
                    BackgroundColor="{StaticResource AcentoFuerte}"
                    TextColor="{StaticResource TextoPrincipal}"
                    FontAttributes="Bold"
                    Clicked="BtnGuardar_Clicked" />

        </Grid>

    </Grid>
</ContentPage>
