<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.CarpetaVfsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Carpeta"
    BackgroundColor="{StaticResource FondoPagina}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,28"
                             Spacing="10">

            <Label x:Name="LblRuta"
                   Text=""
                   FontSize="13"
                   TextColor="{StaticResource TextoSecundario}" />

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="ï¼‹ Carpeta"
                        Clicked="BtnNuevaCarpeta_Clicked"
                        BackgroundColor="{StaticResource AcentoSuave}"
                        TextColor="#B9DEFF"
                        CornerRadius="9"
                        HeightRequest="44" />
                <Button Grid.Column="1"
                        Text="ï¼‹ Subir archivo"
                        Clicked="BtnSubir_Clicked"
                        BackgroundColor="{StaticResource ExitoSuave}"
                        TextColor="{StaticResource TextoPrincipal}"
                        CornerRadius="9"
                        HeightRequest="44" />
            </Grid>

            <Label Text="CARPETAS"
                   Style="{StaticResource Antetitulo}"
                   Margin="0,6,0,0" />
            <Label x:Name="LblSinCarpetas"
                   Text="Sin subcarpetas."
                   TextColor="{StaticResource TextoTerciario}"
                   FontSize="13" />
            <VerticalStackLayout x:Name="ListaCarpetas"
                                 Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource SuperficieAlta}"
                                Stroke="{StaticResource Borde}"
                                StrokeThickness="1"
                                Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding Nombre}"
                                       TextColor="{StaticResource TextoPrincipal}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Abrir"
                                        Clicked="BtnAbrirCarpeta_Clicked"
                                        CommandParameter="{Binding .}"
                                        Padding="9,4"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource AcentoSuave}"
                                        TextColor="#B9DEFF"
                                        CornerRadius="7"
                                        Margin="0,0,5,0" />
                                <Button Grid.Column="2"
                                        Text="Nombre"
                                        Clicked="BtnRenombrarCarpeta_Clicked"
                                        CommandParameter="{Binding .}"
                                        Padding="9,4"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource SuperficieAlta}"
                                        TextColor="{StaticResource TextoPrincipal}"
                                        CornerRadius="7"
                                        Margin="0,0,5,0" />
                                <Button Grid.Column="3"
                                        Text="Eliminar"
                                        Clicked="BtnEliminarCarpeta_Clicked"
                                        CommandParameter="{Binding .}"
                                        Padding="9,4"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource PeligroSuave}"
                                        TextColor="#FFB7BC"
                                        CornerRadius="7" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="ARCHIVOS"
                   Style="{StaticResource Antetitulo}"
                   Margin="0,8,0,0" />
            <Label x:Name="LblSinArchivos"
                   Text="Sin archivos."
                   TextColor="{StaticResource TextoTerciario}"
                   FontSize="13" />
            <VerticalStackLayout x:Name="ListaArchivos"
                                 Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource SuperficieAlta}"
                                Stroke="{StaticResource Borde}"
                                StrokeThickness="1"
                                Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding NombreOriginal}"
                                       TextColor="{StaticResource TextoPrincipal}"
                                       FontSize="13"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Abrir"
                                        Clicked="BtnAbrirArchivo_Clicked"
                                        CommandParameter="{Binding .}"
                                        Padding="9,4"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource SuperficieAlta}"
                                        TextColor="{StaticResource TextoPrincipal}"
                                        CornerRadius="7"
                                        Margin="0,0,5,0" />
                                <Button Grid.Column="2"
                                        Text="Nombre"
                                        Clicked="BtnRenombrarArchivo_Clicked"
                                        CommandParameter="{Binding .}"
                                        Padding="9,4"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource SuperficieAlta}"
                                        TextColor="{StaticResource TextoPrincipal}"
                                        CornerRadius="7"
                                        Margin="0,0,5,0" />
                                <Button Grid.Column="3"
                                        Text="Eliminar"
                                        Clicked="BtnEliminarArchivo_Clicked"
                                        CommandParameter="{Binding .}"
                                        Padding="9,4"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource PeligroSuave}"
                                        TextColor="#FFB7BC"
                                        CornerRadius="7" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
