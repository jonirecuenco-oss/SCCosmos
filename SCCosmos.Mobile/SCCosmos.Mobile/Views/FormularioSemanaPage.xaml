<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SCCosmos.Mobile.Views.FormularioSemanaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Editar semana"
    BackgroundColor="{StaticResource FondoPagina}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,18,18,20"
                                 Spacing="15">

                <!-- CABECERA -->
                <VerticalStackLayout Spacing="3"
                                     Margin="0,0,0,5">
                    <Label Text="Planificación de la semana"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Acento}" />

                    <Label x:Name="LblRango"
                           TextColor="{StaticResource TextoSecundario}"
                           FontSize="13" />
                </VerticalStackLayout>

                <!-- ACTIVIDAD -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Actividad de la semana"
                           TextColor="{StaticResource TextoPrincipal}"
                           FontAttributes="Bold" />

                    <Picker x:Name="PickerActividad"
                            SelectedIndexChanged="PickerActividad_SelectedIndexChanged"
                            BackgroundColor="{StaticResource Superficie}"
                            TextColor="{StaticResource TextoPrincipal}"
                            Title="Seleccionar actividad"
                            TitleColor="{StaticResource TextoSecundario}" />
                </VerticalStackLayout>

                <!-- CONGREGACIÓN -->
                <VerticalStackLayout x:Name="PanelCongregacion"
                                     Spacing="6">
                    <Label Text="Congregación asignada"
                           TextColor="{StaticResource TextoPrincipal}"
                           FontAttributes="Bold" />

                    <Picker x:Name="PickerCongregacion"
                            BackgroundColor="{StaticResource Superficie}"
                            TextColor="{StaticResource TextoPrincipal}"
                            Title="Seleccionar congregación"
                            TitleColor="{StaticResource TextoSecundario}" />
                </VerticalStackLayout>

                <!-- ASAMBLEA -->
                <Border x:Name="PanelAsamblea"
                        IsVisible="False"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        Padding="13">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="13">
                        <Label Text="ASAMBLEA DE CIRCUITO"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#80C4FF" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Sección que asiste"
                                   TextColor="{StaticResource TextoPrincipal}" />
                            <Picker x:Name="PickerSeccion"
                                    BackgroundColor="{StaticResource Superficie}"
                                    TextColor="{StaticResource TextoPrincipal}"
                                    Title="Seleccionar sección"
                                    TitleColor="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Día del fin de semana"
                                   TextColor="{StaticResource TextoPrincipal}" />
                            <Picker x:Name="PickerDiaAsamblea"
                                    BackgroundColor="{StaticResource Superficie}"
                                    TextColor="{StaticResource TextoPrincipal}"
                                    Title="Seleccionar día"
                                    TitleColor="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- VISITA -->
                <Border x:Name="PanelDetallesVisita"
                        IsVisible="False"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="{StaticResource Borde}"
                        StrokeThickness="1"
                        Padding="13">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="11" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="14">
                        <Label Text="DETALLES DE LA VISITA"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#80C4FF" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Tipo de visita"
                                   TextColor="{StaticResource TextoPrincipal}" />
                            <Picker x:Name="PickerTipo"
                                    SelectedIndexChanged="PickerTipo_SelectedIndexChanged"
                                    BackgroundColor="{StaticResource Superficie}"
                                    TextColor="{StaticResource TextoPrincipal}"
                                    Title="Seleccionar tipo"
                                    TitleColor="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Régimen de alojamiento"
                                   TextColor="{StaticResource TextoPrincipal}" />
                            <Picker x:Name="PickerAlojamiento"
                                    BackgroundColor="{StaticResource Superficie}"
                                    TextColor="{StaticResource TextoPrincipal}"
                                    Title="Seleccionar alojamiento"
                                    TitleColor="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>

                        <!-- SCS -->
                        <VerticalStackLayout x:Name="PanelSCS"
                                             IsVisible="False"
                                             Spacing="12">
                            <BoxView HeightRequest="1"
                                     Color="{StaticResource Borde}"
                                     Margin="0,2" />

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Superintendente sustituto"
                                       TextColor="{StaticResource TextoPrincipal}" />
                                <Picker x:Name="PickerSCS"
                                        SelectedIndexChanged="PickerSCS_SelectedIndexChanged"
                                        BackgroundColor="{StaticResource Superficie}"
                                        TextColor="{StaticResource TextoPrincipal}"
                                        Title="Seleccionar SCS"
                                        TitleColor="{StaticResource TextoSecundario}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Esposa del SCS"
                                       TextColor="{StaticResource TextoPrincipal}" />
                                <Picker x:Name="PickerEsposaSCS"
                                        BackgroundColor="{StaticResource Superficie}"
                                        TextColor="{StaticResource TextoPrincipal}"
                                        Title="Seleccionar esposa"
                                        TitleColor="{StaticResource TextoSecundario}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- PASTOREO -->
                        <VerticalStackLayout x:Name="PanelPastoreo"
                                             IsVisible="False"
                                             Spacing="12">
                            <BoxView HeightRequest="1"
                                     Color="{StaticResource Borde}"
                                     Margin="0,2" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0"
                                                     Spacing="6">
                                    <Label Text="Nombre (Hno.)"
                                           TextColor="{StaticResource TextoPrincipal}" />
                                    <Entry x:Name="TxtHermanoPastoreo"
                                           BackgroundColor="{StaticResource Superficie}"
                                           TextColor="{StaticResource TextoPrincipal}"
                                           PlaceholderColor="{StaticResource TextoTerciario}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="6">
                                    <Label Text="Apellido"
                                           TextColor="{StaticResource TextoPrincipal}" />
                                    <Entry x:Name="TxtApellidoPastoreo"
                                           BackgroundColor="{StaticResource Superficie}"
                                           TextColor="{StaticResource TextoPrincipal}"
                                           PlaceholderColor="{StaticResource TextoTerciario}" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="6">
                                <Label Text="Esposa (si asiste)"
                                       TextColor="{StaticResource TextoPrincipal}" />
                                <Entry x:Name="TxtEsposaPastoreo"
                                       BackgroundColor="{StaticResource Superficie}"
                                       TextColor="{StaticResource TextoPrincipal}"
                                       PlaceholderColor="{StaticResource TextoTerciario}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="LblAviso"
                       IsVisible="False"
                       TextColor="#FFCC80"
                       FontSize="12"
                       LineBreakMode="WordWrap" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTONES -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="10"
              Padding="18,10,18,18"
              BackgroundColor="{StaticResource FondoPagina}">

            <Button Grid.Column="0"
                    Text="Cancelar"
                    Clicked="BtnCancelar_Clicked"
                    BackgroundColor="{StaticResource SuperficieAlta}"
                    TextColor="{StaticResource TextoPrincipal}"
                    CornerRadius="9"
                    HeightRequest="46" />

            <Button Grid.Column="1"
                    Text="Guardar"
                    Clicked="BtnGuardar_Clicked"
                    BackgroundColor="#0B6FC2"
                    TextColor="{StaticResource TextoPrincipal}"
                    FontAttributes="Bold"
                    CornerRadius="9"
                    HeightRequest="46" />
        </Grid>

        <!-- CARGA -->
        <Grid x:Name="OverlayCargando"
              Grid.RowSpan="2"
              BackgroundColor="#C0101216"
              IsVisible="False">
            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="12">
                <ActivityIndicator IsRunning="True"
                                   Color="{StaticResource Acento}"
                                   WidthRequest="42"
                                   HeightRequest="42" />
                <Label x:Name="LblCarga"
                       Text="Cargando..."
                       TextColor="{StaticResource TextoPrincipal}"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
