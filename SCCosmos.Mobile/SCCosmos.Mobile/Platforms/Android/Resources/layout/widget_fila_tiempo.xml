<?xml version="1.0" encoding="utf-8"?>
<!-- Tiempo de AEMET: 6 horas (o tramos) con su aviso debajo y flechas para moverse por las horas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fila_tiempo_raiz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_tarjeta"
        android:paddingLeft="2dp"
        android:paddingTop="8dp"
        android:paddingRight="2dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/tiempo_antes"
            android:layout_width="22dp"
            android:layout_height="44dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:src="@drawable/widget_atras"
            android:contentDescription="Horas anteriores"
            android:visibility="invisible" />
        <LinearLayout
            android:id="@+id/tiempo_celda_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tiempo_hora_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#A7AEB8"
                android:textSize="11sp"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/tiempo_icono_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="2dp"
                android:contentDescription="Cielo" />

            <TextView
                android:id="@+id/tiempo_temp_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#F2F4F7"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tiempo_lluvia_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#4BA3E3"
                android:textSize="10sp"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/tiempo_aviso_1"
                android:layout_width="17dp"
                android:layout_height="21dp"
                android:layout_marginTop="3dp"
                android:src="@drawable/widget_aviso_amarillo"
                android:contentDescription="Aviso"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
