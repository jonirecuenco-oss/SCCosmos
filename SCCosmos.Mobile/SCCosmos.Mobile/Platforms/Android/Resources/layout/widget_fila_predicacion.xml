<?xml version="1.0" encoding="utf-8"?>
<!-- Predicación del mes, en una tarjeta, con el botón de editar las horas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_tarjeta"
        android:paddingLeft="12dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/fila_predicacion_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text=""
            android:textColor="#F2F4F7"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/fila_predicacion_mas"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="@drawable/widget_boton_acento"
            android:src="@drawable/widget_editar"
            android:contentDescription="Editar horas"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>