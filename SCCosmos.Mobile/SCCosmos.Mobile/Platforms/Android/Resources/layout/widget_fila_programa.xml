<?xml version="1.0" encoding="utf-8"?>
<!-- Actividad del programa, en una tarjeta (sin margen: las filas de una lista no lo admiten) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fila_programa_raiz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_tarjeta"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/fila_programa_texto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#F2F4F7"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/fila_programa_mapa"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:src="@drawable/widget_mapa"
                android:contentDescription="Ver en el mapa"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/fila_programa_secundaria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:text=""
            android:textColor="#A7AEB8"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>