<?xml version="1.0" encoding="utf-8"?>
<!-- Tarea, en una tarjeta, con su botón de hecho -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fila_tarea_raiz"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_tarjeta"
        android:paddingLeft="12dp"
        android:paddingRight="2dp">

        <TextView
            android:id="@+id/fila_tarea_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text=""
            android:textColor="#F2F4F7"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/fila_tarea_ok"
            android:layout_width="44dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/widget_ok"
            android:contentDescription="Marcar como hecha"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>